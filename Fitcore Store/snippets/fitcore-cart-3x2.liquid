{%- comment -%}
  Fitcore · Aviso discreto de una linea "3x2" (Nature's Bounty) para carrito y carrito lateral.
  Solo visible con la promo activa y con al menos 1 Nature's Bounty en el carrito.
  Se actualiza solo al agregar, quitar o cambiar cantidades.
{%- endcomment -%}
{%- capture fc_live -%}{%- render 'fitcore-promo', product: cart.items.first.product, part: 'live' -%}{%- endcapture -%}
{%- capture fc_end -%}{%- render 'fitcore-promo', product: cart.items.first.product, part: 'end' -%}{%- endcapture -%}
{%- if fc_live contains 'yes' -%}
<div data-fc-3x2 hidden style="margin:8px 16px;box-sizing:border-box">
  <div style="display:flex;align-items:center;gap:8px;padding:8px 12px;border-radius:10px;background:#F4F0FB;border:1px solid #E3D9F5;color:#3B1F6B;font:500 13px/1.35 sans-serif">
    <span style="flex:none;background:#3B1F6B;color:#fff;font:800 10.5px/1 sans-serif;letter-spacing:.04em;padding:4px 7px;border-radius:6px">3x2</span>
    <span data-fc-3x2-msg style="flex:1 1 auto;min-width:0"></span>
    <a href="/collections/natures-bounty" data-fc-3x2-btn style="flex:none;color:#3B1F6B;font-weight:700;text-decoration:underline;white-space:nowrap">Ver</a>
  </div>
</div>
<script>
(function(){
  var box = document.currentScript.previousElementSibling; if(!box || !box.hasAttribute('data-fc-3x2')) return;
  var msg = box.querySelector('[data-fc-3x2-msg]'), btn = box.querySelector('[data-fc-3x2-btn]'), t;
  function paint(cart){
    var n = 0; (cart.items||[]).forEach(function(i){ if(i.vendor === "Nature's Bounty") n += i.quantity; });
    if(!n){ box.hidden = true; return; }
    box.hidden = false;
    var r = n % 3;
    if(r === 0){ msg.textContent = 'Listo: cada 3 Nature\'s Bounty, 1 te sale gratis.'; btn.textContent = 'Ver más'; }
    else if(r === 1){ msg.textContent = 'Agrega 2 Nature\'s Bounty más y 1 te sale gratis.'; btn.textContent = 'Ver'; }
    else { msg.textContent = 'Te falta 1 Nature\'s Bounty para llevarte 1 gratis.'; btn.textContent = 'Agregar'; }
  }
  function refresh(){ fetch('/cart.js', {credentials:'same-origin'}).then(function(r){return r.json();}).then(paint).catch(function(){}); }
  function later(){ clearTimeout(t); t = setTimeout(refresh, 500); }
  refresh();
  if (typeof subscribe === 'function' && typeof PUB_SUB_EVENTS !== 'undefined') { subscribe(PUB_SUB_EVENTS.cartUpdate, later); }
  document.addEventListener('change', later, true);
  document.addEventListener('click', function(e){ if (e.target.closest && e.target.closest('cart-remove-button, quantity-input, .quantity__button, [name="add"], .quick-add__submit')) later(); }, true);
  var obs = new MutationObserver(later);
  document.querySelectorAll('cart-drawer-items, cart-items').forEach(function(el){ obs.observe(el, {childList:true, subtree:true}); });
})();
</script>
{%- endif -%}

