{% comment %}
  FitCore dual price: base price + divisa price (-25%).
  Divisas = Zelle / USDT / efectivo. Value = variant.price * 0.75 (data-driven, no invented data).

  Accepts:
  - product: {Object} Product Liquid object (required)
  - context: {String} 'card' (listing grid) or 'product' (product page). Default 'product'.
  - uid: {String} Unique id for the product page instance (pass section.id). Optional.
  - skip_styles: {Boolean} Don't print the stylesheet tag (for card loops). Optional.
{% endcomment %}
{%- unless skip_styles -%}
  {{ 'fitcore-divisa.css' | asset_url | stylesheet_tag }}
{%- endunless -%}
{%- liquid
  assign fc_ctx = context | default: 'product'
  if fc_ctx == 'card'
    assign fc_base = product.price
  else
    assign fc_base = product.selected_or_first_available_variant.price | default: product.price
  endif
  assign fc_divisa = fc_base | times: 75 | divided_by: 100
  if settings.currency_code_enabled
    assign fc_divisa_money = fc_divisa | money_with_currency
  else
    assign fc_divisa_money = fc_divisa | money
  endif
-%}
{%- if fc_ctx == 'card' -%}
  <div class="fc-divisa fc-divisa--card">
    <span class="fc-divisa__label">Pago en divisas:</span>
    <span class="fc-divisa__amount">{{ fc_divisa_money }}</span>
  </div>
{%- else -%}
  <div class="fc-divisa" id="fc-divisa-{{ uid }}">
    <span class="fc-divisa__label">Pago en divisas:</span>
    <span class="fc-divisa__amount" data-fc-divisa-amount>{{ fc_divisa_money }}</span>
  </div>
  <span class="fc-divisa__hint">Zelle · USDT · efectivo en dólares</span>
  <script>
    (function () {
      var wrap = document.getElementById('fc-divisa-{{ uid }}');
      if (!wrap) return;
      var map = { {%- for v in product.variants -%}"{{ v.id }}":"{% if settings.currency_code_enabled %}{{ v.price | times: 75 | divided_by: 100 | money_with_currency }}{% else %}{{ v.price | times: 75 | divided_by: 100 | money }}{% endif %}"{%- unless forloop.last -%},{%- endunless -%}{%- endfor -%} };
      var out = wrap.querySelector('[data-fc-divisa-amount]');
      var pi = wrap.closest('product-info');
      function cur() { var i = (pi || document).querySelector('[name="id"]'); return i ? i.value : null; }
      function upd() {
        var id = cur();
        if (!id || !map[id] || !out) return;
        if (out.textContent === map[id]) return; // avoid re-triggering the observer (prevents infinite loop)
        out.textContent = map[id];
      }
      if (pi) {
        pi.addEventListener('change', function () { setTimeout(upd, 60); });
        new MutationObserver(function () { setTimeout(upd, 0); }).observe(pi, { subtree: true, childList: true, attributes: true, attributeFilter: ['value'] });
      }
      upd();
    })();
  </script>
{%- endif -%}
