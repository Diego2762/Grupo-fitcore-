{% comment %}
  Fitcore Store · Tarjeta de producto compacta y reutilizable.
  Misma estructura y estilo que las tarjetas del home (.fc-pc).
  Requiere el CSS global: assets/fitcore-cards.css

  Parámetros:
  - product: {Object} Producto de Shopify (requerido).
  - lazy:    {Boolean} Si true, carga la imagen con loading="lazy". Opcional.
  - badge:   {String} Texto del badge sobre la imagen. Opcional.
  - variant: {Object} Variante fija (ej. un sabor): usa su foto, su enlace y la agrega al carrito. Opcional.
{% endcomment %}
{%- if product != blank and product.id -%}
  {%- assign fc_var = variant | default: product.selected_or_first_available_variant -%}
  {%- assign fc_url = product.url -%}
  {%- assign fc_img = product.featured_image -%}
  {%- assign fc_name = product.title -%}
  {%- if variant -%}
    {%- assign fc_url = variant.url -%}
    {%- if variant.image -%}{%- assign fc_img = variant.image -%}{%- endif -%}
    {%- assign fc_name = product.title | append: ' ' | append: variant.title -%}
  {%- endif -%}
  {%- capture fc_pb -%}{%- render 'fitcore-promo', product: product, part: 'bcv' -%}{%- endcapture -%}
  {%- assign fc_pbn = fc_pb | strip | plus: 0 -%}
  {%- assign fc_off = 0 -%}
  {%- if fc_pbn > 0 and product.price > fc_pbn -%}
    {%- assign fc_off = product.price | minus: fc_pbn | times: 100.0 | divided_by: product.price | round -%}
  {%- endif -%}
  {%- if lazy -%}{%- assign fc_loading = 'lazy' -%}{%- else -%}{%- assign fc_loading = 'eager' -%}{%- endif -%}
  <div class="fc-pc" data-handle="{{ product.handle }}">
    <a class="fc-pc-media" href="{{ fc_url }}">
      {%- if badge != blank -%}
        <span class="fc-pc-rank"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><circle cx="12" cy="12" r="4.5"/><circle cx="12" cy="12" r="1"/></svg>{{ badge }}</span>
      {%- endif -%}
      {%- if fc_off > 0 -%}
        <span class="fc-pc-off" style="position:absolute;top:10px;right:10px;z-index:2;background:#19C37D;color:#071631;font:900 15px/1 var(--font-body-family, sans-serif);padding:8px 10px;border-radius:12px;box-shadow:0 6px 16px rgba(11,24,64,.18)">-{{ fc_off }}%</span>
      {%- endif -%}
      {%- if fc_img -%}
        <img src="{{ fc_img | image_url: width: 600 }}" alt="{{ fc_name | escape }}" loading="{{ fc_loading }}" width="600" height="600">
      {%- endif -%}
    </a>
    <div class="fc-pc-body">
      {%- if product.vendor != blank -%}<span class="fc-pc-vendor">{{ product.vendor }}</span>{%- endif -%}
      <a class="fc-pc-title" href="{{ fc_url }}">{{ product.title }}</a>
      {%- comment -%} Indicador sutil de variantes: colores (Forfit) o sabores/tamaños, para que se vean sin entrar al listing {%- endcomment -%}
      {%- assign fc_var_label = '' -%}
      {%- if variant -%}{%- assign fc_var_label = variant.title -%}{%- endif -%}
      {%- for opt in product.options_with_values -%}
        {%- if variant -%}{%- break -%}{%- endif -%}
        {%- assign fc_ocount = opt.values | size -%}
        {%- if fc_ocount > 1 -%}
          {%- assign fc_oname = opt.name | downcase -%}
          {%- if fc_oname contains 'sabor' or fc_oname contains 'flavor' -%}
            {%- assign fc_seg = fc_ocount | append: ' sabores' -%}
          {%- elsif fc_oname contains 'color' -%}
            {%- assign fc_seg = fc_ocount | append: ' colores' -%}
          {%- elsif fc_oname contains 'tama' or fc_oname contains 'size' -%}
            {%- assign fc_seg = fc_ocount | append: ' tamaños' -%}
          {%- else -%}
            {%- assign fc_seg = fc_ocount | append: ' opciones' -%}
          {%- endif -%}
          {%- if fc_var_label == blank -%}
            {%- assign fc_var_label = fc_seg -%}
          {%- else -%}
            {%- assign fc_var_label = fc_var_label | append: ' · ' | append: fc_seg -%}
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
      {%- if fc_var_label != blank -%}
        <span class="fc-pc-variants">{{ fc_var_label }}</span>
      {%- endif -%}
      <div class="fc-pc-foot">
        {%- assign fc_bcv_now = product.price -%}
        {%- if fc_pbn > 0 -%}{%- assign fc_bcv_now = fc_pbn -%}{%- endif -%}
        {%- assign fc_divisa = fc_bcv_now | times: 100 | divided_by: 115 -%}
        {%- assign fc_old_div = product.price | times: 100 | divided_by: 115 -%}
        <div class="fc-pc-prices">
          {%- render 'fitcore-promo', product: product, part: 'chips' -%}
          <span class="fc-pc-price fc-pc-price--divisa">{{ fc_divisa | money }}{% if fc_pbn > 0 %}<s style="font-weight:500;font-size:.78em;opacity:.55;color:#0B1840">{{ fc_old_div | money }}</s>{% endif %}<span class="fc-pc-cur">Divisa</span></span>
          <span class="fc-pc-price">{{ fc_bcv_now | money }}{% if fc_pbn > 0 %}<s style="font-weight:500;font-size:.78em;opacity:.55">{{ product.price | money }}</s>{% endif %}<span class="fc-pc-cur">BCV</span></span>
        </div>
        {%- if fc_var and fc_var.available -%}
          <form method="post" action="{{ routes.cart_add_url }}" class="fc-pc-form" data-fc-add>
            <input type="hidden" name="form_type" value="product">
            <input type="hidden" name="utf8" value="✓">
            <input type="hidden" name="id" value="{{ fc_var.id }}">
            <button type="submit" class="fc-pc-cart" aria-label="Agregar {{ fc_name | escape }} al carrito">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="9" cy="21" r="1"/><circle cx="20" cy="21" r="1"/><path d="M1 1h4l2.68 13.39a2 2 0 0 0 2 1.61h9.72a2 2 0 0 0 2-1.61L23 6H6"/></svg>
            </button>
          </form>
        {%- else -%}
          <a class="fc-pc-cart fc-pc-cart--out" href="{{ fc_url }}" aria-label="Ver {{ fc_name | escape }}">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 5l7 7-7 7"/></svg>
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

