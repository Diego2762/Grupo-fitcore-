{%- comment -%}
  Fitcore Store · SEO / GEO / NAP base
  Datos estructurados schema.org: WebSite + Organization + LocalBusiness (NAP).
  NAP = Name, Address, Phone consistentes en todo el sitio.
  Render desde layout/theme.liquid <head>: {% render 'fitcore-seo' %}

  NOTA: datos verificados de Grupo Fitcore (NAP, horario L-S 9-17, geo, IG).
  Google Business Profile creado (CID 911554535815498653); geo (9.2975443,
  -70.6152509) y hasMap alineados al pin oficial del GBP. Pendiente externo: confirmar redes
  adicionales (FB, TikTok, YouTube) si aplican. No se inventa nada.
{%- endcomment -%}

{%- liquid
  assign biz_name = 'Fitcore Store'
  assign biz_phone = '+584220384328'
  assign biz_email = 'info@grupofitcore.com'
  assign biz_locality = 'Valera'
  assign biz_region = 'Trujillo'
  assign biz_country = 'VE'
  assign biz_postal = '3101'
  assign biz_street = 'C.C. Plaza, Puente Nivel Comercio, Avenida 6, Calles 25'
  assign biz_geo_lat = '9.2975443'
  assign biz_geo_lng = '-70.6152509'
  assign biz_gmaps = 'https://www.google.com/maps?cid=911554535815498653'
  assign biz_map = biz_gmaps
  assign biz_logo = 'fitcore-store-logo.png' | asset_url | prepend: 'https:'
  assign biz_instagram = 'https://instagram.com/fitcore.ve'
  assign base_url = request.origin
-%}

{%- if request.page_type == 'index' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "WebSite",
  "name": {{ biz_name | json }},
  "url": {{ base_url | json }},
  "inLanguage": "es-VE",
  "potentialAction": {
    "@type": "SearchAction",
    "target": {
      "@type": "EntryPoint",
      "urlTemplate": "{{ base_url }}/search?q={search_term_string}"
    },
    "query-input": "required name=search_term_string"
  }
}
</script>
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": ["Store", "HealthAndBeautyBusiness"],
  "name": {{ biz_name | json }},
  "description": "Suplementos deportivos y vitaminas en Venezuela: proteínas, creatina, pre-entrenos y más. Importados de EE.UU., con tienda física en Valera, Trujillo, y envío a todo el país.",
  "url": {{ base_url | json }},
  "image": {{ biz_logo | json }},
  "logo": {{ biz_logo | json }},
  "telephone": {{ biz_phone | json }},
  "email": {{ biz_email | json }},
  "priceRange": "$$",
  "currenciesAccepted": "USD, VES",
  "paymentAccepted": "Zelle, USDT, Pago Móvil, Transferencia, Efectivo",
  "address": {
    "@type": "PostalAddress",
    "streetAddress": {{ biz_street | json }},
    "addressLocality": {{ biz_locality | json }},
    "addressRegion": {{ biz_region | json }},
    "postalCode": {{ biz_postal | json }},
    "addressCountry": {{ biz_country | json }}
  },
  "geo": {
    "@type": "GeoCoordinates",
    "latitude": {{ biz_geo_lat | json }},
    "longitude": {{ biz_geo_lng | json }}
  },
  "hasMap": {{ biz_map | json }},
  "sameAs": [{{ biz_instagram | json }}, {{ biz_gmaps | json }}],
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday"],
      "opens": "09:00",
      "closes": "17:00"
    }
  ],
  "areaServed": [
    { "@type": "City", "name": "Valera" },
    { "@type": "State", "name": "Trujillo" },
    { "@type": "Country", "name": "Venezuela" }
  ],
  "hasOfferCatalog": {
    "@type": "OfferCatalog",
    "name": "Suplementos deportivos y vitaminas",
    "itemListElement": [
      {%- assign fc_cats = "Proteínas,Creatina,Pre-entrenos,Aminoácidos,Vitaminas,Accesorios" | split: ',' -%}
      {%- for fc_c in fc_cats -%}
      {
        "@type": "Offer",
        "itemOffered": { "@type": "Product", "name": {{ fc_c | json }} },
        "availableDeliveryMethod": ["https://schema.org/OnSitePickup", "https://schema.org/ParcelService"]
      }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  },
  "contactPoint": {
    "@type": "ContactPoint",
    "telephone": {{ biz_phone | json }},
    "contactType": "sales",
    "areaServed": "VE",
    "availableLanguage": ["es"]
  },
  "parentOrganization": {
    "@type": "Organization",
    "name": "Grupo Fitcore",
    "url": "https://grupofitcore.com"
  }
}
</script>
{%- endif -%}

{%- if request.page_type == 'product' -%}
  {%- assign bc_col = product.collections | first -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": {{ base_url | json }}
    }{%- if bc_col -%},
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ bc_col.title | json }},
      "item": {{ base_url | append: bc_col.url | json }}
    },
    {
      "@type": "ListItem",
      "position": 3,
      "name": {{ product.title | json }},
      "item": {{ base_url | append: product.url | json }}
    }
    {%- else -%},
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ product.title | json }},
      "item": {{ base_url | append: product.url | json }}
    }
    {%- endif -%}
  ]
}
</script>
{%- endif -%}

{%- if request.page_type == 'collection' -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  "itemListElement": [
    {
      "@type": "ListItem",
      "position": 1,
      "name": "Inicio",
      "item": {{ base_url | json }}
    },
    {
      "@type": "ListItem",
      "position": 2,
      "name": {{ collection.title | json }},
      "item": {{ base_url | append: collection.url | json }}
    }
  ]
}
</script>
{%- endif -%}
