{% comment %}
  Renders cart notification

  Accepts:
  - color_scheme: {String} sets the color scheme of the notification (optional)
  - desktop_menu_type: {String} passes the desktop menu type which allows us to use the right css class (optional)

  Usage:
  {% render 'cart-notification' %}
{% endcomment %}

{%- capture fc_live -%}{%- render 'fitcore-promo', product: nil, part: 'live' -%}{%- endcapture -%}
{%- capture fc_end -%}{%- render 'fitcore-promo', product: nil, part: 'end' -%}{%- endcapture -%}

<cart-notification>
  <div class="cart-notification-wrapper{% if desktop_menu_type != 'drawer' %} page-width{% endif %}">
    <div
      id="cart-notification"
      class="cart-notification focus-inset{% if color_scheme %} color-{{ color_scheme }} gradient{% endif %}"
      aria-modal="true"
      aria-label="{{ 'general.cart.item_added' | t }}"
      role="dialog"
      tabindex="-1"
    >
      <div class="cart-notification__header">
        <h2 class="cart-notification__heading caption-large text-body">
          {{- 'icon-checkmark.svg' | inline_asset_content -}}
          {{ 'general.cart.item_added' | t }}
        </h2>
        <button
          type="button"
          class="cart-notification__close modal__close-button link link--text focus-inset"
          aria-label="{{ 'accessibility.close' | t }}"
        >
          <span class="svg-wrapper">
            {{- 'icon-close.svg' | inline_asset_content -}}
          </span>
        </button>
      </div>
      <div
        id="cart-notification-freeship"
        class="cart-notification-freeship"
        data-threshold="4500"
        hidden
      ></div>
      {%- if fc_live contains 'yes' -%}
        <div id="cart-notification-3x2" class="cart-notification-3x2" data-end="{{ fc_end | strip }}" hidden>
          <div class="cart-notification-3x2__top">
            <span class="cart-notification-3x2__tag">Oferta de lanzamiento</span>
            <strong>Lleva 3, paga solo 2</strong>
            <span class="cart-notification-3x2__time" data-3x2-time></span>
          </div>
          <div class="cart-notification-3x2__row">
            <span data-3x2-msg></span>
            <a href="/collections/natures-bounty" data-3x2-btn>Ver elegibles</a>
          </div>
        </div>
      {%- endif -%}
      <div id="cart-notification-product" class="cart-notification-product"></div>
      <div class="cart-notification__links">
        <a
          href="{{ routes.cart_url }}"
          id="cart-notification-button"
          class="button button--secondary button--full-width"
        >
          {{- 'general.cart.view_empty_cart' | t -}}
        </a>
        {%- comment -%}
          Fitcore: "Pagar pedido" lleva a la pagina del carrito, no directo al
          checkout. Ahi el cliente elige forma de pago y entrega (atributos del
          carrito que usan MEJORPRECIO y HidePay). Ir directo los saltaba.
        {%- endcomment -%}
        <a href="{{ routes.cart_url }}" id="cart-notification-form" class="button button--primary button--full-width">
          {{ 'sections.cart.checkout' | t }}
        </a>
        <button type="button" class="link button-label">{{ 'general.continue_shopping' | t }}</button>
      </div>
    </div>
  </div>
</cart-notification>
{% style %}
  .cart-notification {
    display: none;
  }
  .cart-notification-freeship {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: 0 0 1.2rem;
    padding: 1rem 1.2rem;
    border-radius: 12px;
    background: #fff4e0;
    color: #8a5300;
    border: 1px solid #ffe0ab;
    font-size: 1.3rem;
    line-height: 1.3;
  }
  .cart-notification-freeship b {
    font-weight: 700;
    color: #7a4900;
  }
  .cart-notification-freeship[hidden] {
    display: none;
  }
  .cart-notification-freeship.is-free {
    background: #e7f9f0;
    color: #0a7d3f;
    border-color: #8fe3b8;
  }
  .cart-notification-freeship.is-free b {
    color: #0a7d3f;
  }
  .cart-notification-freeship__check {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 20px;
    height: 20px;
    border-radius: 999px;
    background: #19c37d;
    color: #062b1a;
    font-weight: 800;
    font-size: 1.2rem;
    flex: 0 0 auto;
  }
  .cart-notification-3x2 {
    margin: 0 0 1.2rem;
    padding: 1rem 1.2rem;
    border-radius: 12px;
    background: linear-gradient(120deg, #0b1840, #3b1f6b);
    color: #fff;
    font-size: 1.3rem;
    line-height: 1.35;
  }
  .cart-notification-3x2[hidden] {
    display: none;
  }
  .cart-notification-3x2__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
  }
  .cart-notification-3x2__top strong {
    font-size: 1.5rem;
    font-weight: 800;
  }
  .cart-notification-3x2__tag {
    background: #19c37d;
    color: #071631;
    font-size: 1rem;
    font-weight: 800;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    padding: 5px 8px;
    border-radius: 99px;
    white-space: nowrap;
  }
  .cart-notification-3x2__time {
    margin-left: auto;
    background: rgba(255, 255, 255, 0.14);
    font-size: 1.15rem;
    font-weight: 700;
    padding: 5px 8px;
    border-radius: 8px;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }
  .cart-notification-3x2__row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 12px;
    margin-top: 6px;
  }
  .cart-notification-3x2__row a {
    background: #fff;
    color: #0b1840;
    font-weight: 800;
    font-size: 1.2rem;
    padding: 8px 12px;
    border-radius: 9px;
    text-decoration: none;
    white-space: nowrap;
  }
{% endstyle %}

