<!doctype html>
<html class="no-js" lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="#0B1840">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- endif -%}

    <title>{{ shop.name }}</title>
    {% if page_description %}<meta name="description" content="{{ page_description | escape }}">{% endif %}

    {%- comment -%} Fitcore — preview de link branded mientras la tienda esta con clave {%- endcomment -%}
    {%- assign fc_share_desc = shop.description | default: shop.name -%}
    {%- unless page_description -%}<meta name="description" content="{{ fc_share_desc | escape }}">{%- endunless -%}
    <meta property="og:site_name" content="{{ shop.name }}">
    <meta property="og:type" content="website">
    <meta property="og:url" content="{{ canonical_url | default: request.origin }}">
    <meta property="og:title" content="{{ shop.name }}">
    <meta property="og:description" content="{{ fc_share_desc | escape }}">
    <meta property="og:image" content="https:{{ 'fitcore-og.png' | asset_url }}">
    <meta property="og:image:secure_url" content="https:{{ 'fitcore-og.png' | asset_url }}">
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="{{ shop.name }}">
    <meta name="twitter:description" content="{{ fc_share_desc | escape }}">

    {%- unless settings.type_body_font.system? -%}
      <link rel="preload" as="font" href="{{ settings.type_body_font | font_url }}" type="font/woff2" crossorigin>
    {%- endunless -%}
    {%- unless settings.type_header_font.system? -%}
      <link rel="preload" as="font" href="{{ settings.type_header_font | font_url }}" type="font/woff2" crossorigin>
    {%- endunless -%}

    <style>
      {{ settings.type_body_font | font_face: font_display: 'swap' }}
      {{ settings.type_header_font | font_face: font_display: 'swap' }}
      *, *::before, *::after { box-sizing: border-box; }
      html, body { margin: 0; padding: 0; background: #0B1840; }
    </style>

    {{ content_for_header }}
  </head>

  <body class="fc-password-page">
    {{ content_for_layout }}
  </body>
</html>
