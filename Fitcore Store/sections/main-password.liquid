{%- comment -%}
  Fitcore Store · Página de contraseña (preapertura + semana de inauguración)
  Orden: marca (qué es Fitcore) → hero con cuenta regresiva → banner de envío gratis →
  ofertas de apertura (cinta de productos, sin enlaces porque la tienda sigue con clave) →
  por qué Fitcore + marcas → sorteo (premios + formulario) → contacto → acceso del equipo.
  - Formulario: inserta el lead en Supabase (tabla fitcore_leads, RLS solo INSERT con clave publishable)
    y registra el email en Shopify (form_type=customer) para email marketing.
  - Ofertas: lee los productos y precios de snippets/fitcore-promo.liquid (misma fuente que el home).
  - Fechas: start_iso / end_iso (ofertas) y ship_start_iso / ship_end_iso (envío gratis), en los ajustes.
{%- endcomment -%}

{%- liquid
  assign sb_url = section.settings.supabase_url
  assign sb_key = section.settings.supabase_key
  assign start_iso = section.settings.start_iso | default: '2026-11-14T00:00:00-04:00'
  assign end_iso = section.settings.end_iso | default: '2026-11-21T23:59:59-04:00'
  assign ship_start_iso = section.settings.ship_start_iso | default: '2026-11-14T00:00:00-04:00'
  assign ship_end_iso = section.settings.ship_end_iso | default: '2026-12-13T23:59:59-04:00'
  assign ship_t0 = ship_start_iso | date: '%s' | plus: 0
  assign ship_t1 = ship_end_iso | date: '%s' | plus: 0
  assign ship_secs = ship_t1 | minus: ship_t0
  assign ship_days = ship_secs | divided_by: 86400.0 | ceil
-%}

<style>
  #fc-pw-{{ section.id }} {
    --fc-navy: #0B1840; --fc-navy-d: #071631; --fc-purple: #3B1F6B;
    --fc-purple-l: #5a2fa0; --fc-green: #19C37D; --fc-accent: #b79cff;
    position: relative; min-height: 100vh;
    padding: 40px 0 56px; box-sizing: border-box; color: #fff;
    font-family: 'Open Sans','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
    background:
      radial-gradient(1200px 600px at 12% -10%, rgba(90,47,160,.55), transparent 60%),
      radial-gradient(1000px 700px at 112% 18%, rgba(25,195,125,.15), transparent 55%),
      linear-gradient(160deg, var(--fc-navy) 0%, var(--fc-navy-d) 55%, #05101f 100%);
    overflow: hidden;
  }
  #fc-pw-{{ section.id }} * { box-sizing: border-box; }
  #fc-pw-{{ section.id }} .fc-wrap { position: relative; z-index: 2; width: 100%; max-width: 760px; margin: 0 auto; padding: 0 20px; text-align: center; }
  #fc-pw-{{ section.id }} .fc-wide { position: relative; z-index: 2; width: 100%; max-width: 1180px; margin: 0 auto; padding: 0 20px; }
  #fc-pw-{{ section.id }} .fc-logo { width: min(360px, 78%); height: auto; margin: 0 auto 24px; display: block; }
  #fc-pw-{{ section.id }} .fc-brandline {
    font-family:'Inter',sans-serif; font-weight:600; font-size:clamp(16px,2.7vw,21px);
    line-height:1.5; color:rgba(255,255,255,.9); margin:0 auto 24px; max-width:620px;
  }
  #fc-pw-{{ section.id }} .fc-brandline b { color: var(--fc-accent); font-weight:800; }
  #fc-pw-{{ section.id }} .fc-sub b { color: var(--fc-accent); font-weight:700; }
  #fc-pw-{{ section.id }} .fc-eyebrow {
    display: inline-block; font-family:'Inter',sans-serif; font-weight:700; font-size:12px;
    letter-spacing:.2em; text-transform:uppercase; color: var(--fc-accent);
    border:1px solid rgba(183,156,255,.5); border-radius:999px; padding:7px 16px; margin-bottom:20px;
  }
  #fc-pw-{{ section.id }} h1.fc-title {
    font-family:'Inter',sans-serif; font-weight:800; line-height:1.04; margin:0 0 16px;
    font-size:clamp(32px,7vw,58px);
  }
  #fc-pw-{{ section.id }} h1.fc-title .fc-hl { color: var(--fc-green); }
  #fc-pw-{{ section.id }} .fc-sub { font-size:clamp(15px,2.4vw,18px); line-height:1.6; color:rgba(255,255,255,.85); margin:0 auto 8px; max-width:580px; }

  /* Cuenta regresiva */
  #fc-pw-{{ section.id }} .fc-clock-wrap { margin:30px auto 0; max-width:640px; }
  #fc-pw-{{ section.id }} .fc-clock-wrap[hidden] { display:none; }
  #fc-pw-{{ section.id }} .fc-clock-l { display:block; font:800 clamp(12px,1.8vw,15px)/1 'Inter',sans-serif; letter-spacing:.22em; text-transform:uppercase; color:var(--fc-green); margin-bottom:14px; }
  #fc-pw-{{ section.id }} .fc-clock { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:clamp(8px,2vw,16px); }
  #fc-pw-{{ section.id }} .fc-clock .u { background:linear-gradient(180deg,rgba(255,255,255,.10),rgba(255,255,255,.03)); border:1px solid rgba(255,255,255,.14); border-radius:clamp(14px,2.4vw,22px); padding:clamp(14px,2.8vw,26px) 6px; box-shadow:0 20px 50px rgba(0,0,0,.28), inset 0 1px 0 rgba(255,255,255,.12); }
  #fc-pw-{{ section.id }} .fc-clock b { display:block; font:800 clamp(38px,10vw,84px)/.95 'Inter',sans-serif; letter-spacing:-.03em; font-variant-numeric:tabular-nums; background:linear-gradient(180deg,#fff 30%,var(--fc-accent)); -webkit-background-clip:text; background-clip:text; color:transparent; -webkit-text-fill-color:transparent; }
  #fc-pw-{{ section.id }} .fc-clock small { display:block; margin-top:8px; font:700 clamp(10px,1.4vw,13px)/1 'Inter',sans-serif; letter-spacing:.2em; text-transform:uppercase; color:rgba(255,255,255,.72); }

  /* Banner de envío gratis (avanza solo) */
  #fc-pw-{{ section.id }} .fc-ship { position:relative; z-index:2; margin:40px 0 0; background:linear-gradient(90deg,#12994f,var(--fc-green) 40%,#2ee59a); color:#04281a; overflow:hidden; border-top:1px solid rgba(255,255,255,.35); border-bottom:1px solid rgba(0,0,0,.18); box-shadow:0 14px 40px rgba(25,195,125,.28); }
  #fc-pw-{{ section.id }} .fc-ship-track { display:flex; width:max-content; animation:fcMarq 28s linear infinite; will-change:transform; }
  #fc-pw-{{ section.id }} .fc-ship-grp { display:flex; flex:none; }
  #fc-pw-{{ section.id }} .fc-ship-it { display:inline-flex; align-items:center; gap:14px; padding:clamp(14px,2.2vw,22px) clamp(20px,3vw,38px); font:900 clamp(19px,3.4vw,36px)/1 'Inter',sans-serif; letter-spacing:-.01em; text-transform:uppercase; white-space:nowrap; }
  #fc-pw-{{ section.id }} .fc-ship-it svg { width:1.15em; height:1.15em; flex:none; }
  #fc-pw-{{ section.id }} .fc-ship-it i { font-style:normal; opacity:.55; }
  #fc-pw-{{ section.id }} .fc-ship-it small { font:800 .46em/1 'Inter',sans-serif; letter-spacing:.1em; background:#04281a; color:#7ff0bd; padding:.6em .9em; border-radius:99px; }
  @keyframes fcMarq { from { transform:translateX(0); } to { transform:translateX(-50%); } }

  /* Ofertas de apertura */
  #fc-pw-{{ section.id }} .fc-sec { padding:56px 0 0; }
  #fc-pw-{{ section.id }} .fc-sec-h { text-align:center; max-width:680px; margin:0 auto 22px; }
  #fc-pw-{{ section.id }} .fc-sec-h .fc-eyebrow { margin-bottom:14px; }
  #fc-pw-{{ section.id }} .fc-sec-h h2 { font-family:'Inter',sans-serif; font-weight:800; font-size:clamp(28px,5vw,46px); line-height:1.05; letter-spacing:-.02em; margin:0 0 10px; }
  #fc-pw-{{ section.id }} .fc-sec-h h2 em { font-style:normal; color:var(--fc-green); }
  #fc-pw-{{ section.id }} .fc-sec-h p { margin:0; color:rgba(255,255,255,.8); font-size:clamp(14px,2.2vw,17px); line-height:1.6; }
  #fc-pw-{{ section.id }} .fc-deals { display:grid; grid-template-columns:repeat(3,minmax(0,1fr)); gap:12px; max-width:900px; margin:0 auto 6px; }
  #fc-pw-{{ section.id }} .fc-deal { background:linear-gradient(135deg,rgba(90,47,160,.45),rgba(59,31,107,.25)); border:1px solid rgba(183,156,255,.35); border-radius:18px; padding:18px 16px; text-align:center; }
  #fc-pw-{{ section.id }} .fc-deal b { display:block; font:900 clamp(26px,4vw,38px)/1 'Inter',sans-serif; color:var(--fc-green); letter-spacing:-.02em; }
  #fc-pw-{{ section.id }} .fc-deal span { display:block; margin-top:8px; font-size:14px; line-height:1.4; color:rgba(255,255,255,.88); }
  #fc-pw-{{ section.id }} .fc-rib { padding:22px 0 10px; overflow:hidden; -webkit-mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent); mask-image:linear-gradient(90deg,transparent,#000 6%,#000 94%,transparent); }
  #fc-pw-{{ section.id }} .fc-rib-track { display:flex; gap:16px; padding-right:16px; width:max-content; animation:fcMarq 50s linear infinite; will-change:transform; }
  #fc-pw-{{ section.id }} .fc-rib-it { position:relative; flex:none; width:200px; background:#fff; border-radius:18px; overflow:hidden; color:#0B1840; box-shadow:0 12px 30px rgba(0,0,0,.28); }
  #fc-pw-{{ section.id }} .fc-rib-img { position:relative; display:block; aspect-ratio:1/1; background:#F6F7FA; }
  #fc-pw-{{ section.id }} .fc-rib-img img { position:absolute; inset:12px; margin:auto; max-width:calc(100% - 24px); max-height:calc(100% - 24px); width:auto; height:auto; object-fit:contain; mix-blend-mode:multiply; }
  #fc-pw-{{ section.id }} .fc-rib-off { position:absolute; top:10px; right:10px; background:var(--fc-green); color:#071631; font:900 14px/1 'Inter',sans-serif; padding:7px 9px; border-radius:10px; }
  #fc-pw-{{ section.id }} .fc-rib-b { display:block; padding:12px 14px 15px; text-align:left; }
  #fc-pw-{{ section.id }} .fc-rib-v { display:block; font:800 10px/1 'Inter',sans-serif; letter-spacing:.1em; text-transform:uppercase; color:#3B1F6B; margin-bottom:6px; }
  #fc-pw-{{ section.id }} .fc-rib-t { display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; font:600 13.5px/1.3 'Inter',sans-serif; min-height:35px; margin-bottom:8px; }
  #fc-pw-{{ section.id }} .fc-rib-p { display:flex; align-items:baseline; gap:6px; flex-wrap:wrap; }
  #fc-pw-{{ section.id }} .fc-rib-p b { font:800 18px/1 'Inter',sans-serif; color:#12994f; }
  #fc-pw-{{ section.id }} .fc-rib-p s { font-size:12.5px; color:#8a93a8; }
  #fc-pw-{{ section.id }} .fc-rib-p small { font:700 9.5px/1 sans-serif; letter-spacing:.06em; text-transform:uppercase; color:#12994f; }
  #fc-pw-{{ section.id }} .fc-note { text-align:center; font-size:13px; color:rgba(255,255,255,.6); margin:6px auto 0; max-width:620px; line-height:1.5; }

  /* Por qué Fitcore */
  #fc-pw-{{ section.id }} .fc-why { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:14px; text-align:left; }
  #fc-pw-{{ section.id }} .fc-why-it { background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.12); border-radius:18px; padding:20px 18px; }
  #fc-pw-{{ section.id }} .fc-why-ico { width:42px; height:42px; border-radius:12px; display:flex; align-items:center; justify-content:center; background:rgba(25,195,125,.14); color:var(--fc-green); margin-bottom:14px; }
  #fc-pw-{{ section.id }} .fc-why-ico svg { width:22px; height:22px; }
  #fc-pw-{{ section.id }} .fc-why-it h3 { font:800 17px/1.25 'Inter',sans-serif; margin:0 0 6px; }
  #fc-pw-{{ section.id }} .fc-why-it p { margin:0; font-size:14px; line-height:1.5; color:rgba(255,255,255,.78); }
  #fc-pw-{{ section.id }} .fc-brands { display:flex; flex-wrap:wrap; justify-content:center; align-items:center; gap:18px 34px; margin:30px auto 0; max-width:960px; }
  #fc-pw-{{ section.id }} .fc-brands img { height:30px; width:auto; max-width:120px; object-fit:contain; filter:brightness(0) invert(1); opacity:.7; }
  #fc-pw-{{ section.id }} .fc-brands img.fc-emblem { height:42px; }

  /* Sorteo */
  #fc-pw-{{ section.id }} .fc-prizes {
    display:grid; grid-template-columns:repeat(2,1fr); gap:16px; margin:6px 0 12px; text-align:left;
  }
  #fc-pw-{{ section.id }} .fc-prize {
    background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.12);
    border-radius:18px; padding:16px; display:flex; flex-direction:column;
  }
  #fc-pw-{{ section.id }} .fc-prize__img {
    width:100%; aspect-ratio:4/3; border-radius:12px; object-fit:cover; display:block; margin-bottom:14px; background:#0d1e46;
  }
  #fc-pw-{{ section.id }} .fc-prize__ph {
    width:100%; aspect-ratio:4/3; border-radius:12px; margin-bottom:14px;
    display:flex; align-items:center; justify-content:center; text-align:center;
    background:repeating-linear-gradient(45deg,#0d1e46,#0d1e46 12px,#0f2350 12px,#0f2350 24px);
    border:1px dashed rgba(255,255,255,.25); color:rgba(255,255,255,.55); font-size:13px; padding:12px;
  }
  #fc-pw-{{ section.id }} .fc-prize__tag { font-family:'Inter',sans-serif; font-size:11px; letter-spacing:.14em; text-transform:uppercase; color:var(--fc-accent); font-weight:700; margin-bottom:6px; }
  #fc-pw-{{ section.id }} .fc-prize__title { font-family:'Inter',sans-serif; font-weight:700; font-size:18px; margin:0 0 6px; }
  #fc-pw-{{ section.id }} .fc-prize__text { font-size:14px; line-height:1.5; color:rgba(255,255,255,.8); margin:0; }

  #fc-pw-{{ section.id }} .fc-card {
    background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.14);
    border-radius:20px; padding:26px 22px; margin:26px auto 0; max-width:600px;
  }
  #fc-pw-{{ section.id }} .fc-card h2 { font-family:'Inter',sans-serif; font-weight:800; font-size:22px; margin:0 0 6px; }
  #fc-pw-{{ section.id }} .fc-card p.fc-card__sub { font-size:14px; color:rgba(255,255,255,.75); margin:0 0 18px; }
  #fc-pw-{{ section.id }} .fc-field { text-align:left; margin-bottom:12px; }
  #fc-pw-{{ section.id }} .fc-field-row { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  @media (max-width:480px){ #fc-pw-{{ section.id }} .fc-field-row { grid-template-columns:1fr; } }
  #fc-pw-{{ section.id }} .fc-field label { display:block; font-size:12px; font-weight:600; letter-spacing:.03em; color:rgba(255,255,255,.7); margin-bottom:6px; }
  #fc-pw-{{ section.id }} .fc-input {
    width:100%; box-sizing:border-box; background:rgba(255,255,255,.08);
    border:1px solid rgba(255,255,255,.22); border-radius:12px; padding:14px 16px;
    color:#fff; font-size:16px; outline:none; transition:border-color .18s, background .18s;
  }
  #fc-pw-{{ section.id }} .fc-input::placeholder { color:rgba(255,255,255,.5); }
  #fc-pw-{{ section.id }} .fc-input:focus { border-color:var(--fc-green); background:rgba(255,255,255,.12); }
  #fc-pw-{{ section.id }} .fc-hidden-nl { display:none !important; }
  #fc-pw-{{ section.id }} .fc-btn {
    width:100%; background:linear-gradient(135deg,var(--fc-purple-l),var(--fc-purple));
    color:#fff; border:none; border-radius:12px; padding:16px; font-size:16px; font-weight:700;
    cursor:pointer; transition:transform .15s, filter .15s; box-shadow:0 8px 22px rgba(59,31,107,.45);
  }
  #fc-pw-{{ section.id }} .fc-btn:hover { transform:translateY(-2px); filter:brightness(1.08); }
  #fc-pw-{{ section.id }} .fc-btn[disabled] { opacity:.6; cursor:not-allowed; transform:none; }
  #fc-pw-{{ section.id }} .fc-hp { position:absolute; left:-9999px; opacity:0; height:0; width:0; }
  #fc-pw-{{ section.id }} .fc-msg { font-size:14px; margin:14px 0 0; font-weight:600; min-height:1px; }
  #fc-pw-{{ section.id }} .fc-msg--err { color:#ff9a9a; }
  #fc-pw-{{ section.id }} .fc-success { display:none; text-align:center; }
  #fc-pw-{{ section.id }} .fc-success h2 { color:var(--fc-green); }
  #fc-pw-{{ section.id }} .fc-success .fc-ig-btn { margin-top:14px; }

  #fc-pw-{{ section.id }} .fc-mech { font-size:13px; line-height:1.6; color:rgba(255,255,255,.65); margin:18px auto 0; max-width:520px; }
  #fc-pw-{{ section.id }} details.fc-bases { max-width:520px; margin:22px auto 0; text-align:left; font-size:13px; color:rgba(255,255,255,.7); }
  #fc-pw-{{ section.id }} details.fc-bases summary { cursor:pointer; color:rgba(255,255,255,.85); font-weight:600; }
  #fc-pw-{{ section.id }} details.fc-bases p { line-height:1.6; }

  #fc-pw-{{ section.id }} .fc-links { margin-top:34px; display:flex; gap:12px; justify-content:center; flex-wrap:wrap; }
  #fc-pw-{{ section.id }} .fc-link {
    display:inline-flex; align-items:center; gap:8px; text-decoration:none; color:#fff;
    border:1px solid rgba(255,255,255,.25); border-radius:999px; padding:11px 20px;
    font-size:14px; font-weight:600; transition:background .18s, border-color .18s;
  }
  #fc-pw-{{ section.id }} .fc-link:hover { background:rgba(255,255,255,.1); }
  #fc-pw-{{ section.id }} .fc-link svg { width:18px; height:18px; fill:currentColor; }
  #fc-pw-{{ section.id }} details.fc-staff { margin:30px auto 0; max-width:420px; font-size:12px; color:rgba(255,255,255,.45); }
  #fc-pw-{{ section.id }} details.fc-staff summary { cursor:pointer; }
  #fc-pw-{{ section.id }} .fc-staff form { display:flex; gap:8px; margin-top:12px; }
  #fc-pw-{{ section.id }} .fc-staff input { flex:1; }
  #fc-pw-{{ section.id }} .fc-foot { margin-top:34px; font-size:12px; color:rgba(255,255,255,.4); }

  #fc-pw-{{ section.id }} .fc-ig-cta {
    width:100%; display:flex; align-items:center; justify-content:center; gap:10px;
    background:rgba(183,156,255,.10);
    color:#fff; border:1.5px solid rgba(183,156,255,.55); border-radius:14px; padding:15px 18px;
    font-family:'Inter',sans-serif; font-size:15px; font-weight:700; cursor:pointer;
    margin:4px 0 14px; box-shadow:none;
    transition:transform .15s, background .18s, border-color .18s;
  }
  #fc-pw-{{ section.id }} .fc-ig-cta:hover { transform:translateY(-2px); background:rgba(183,156,255,.18); border-color:var(--fc-accent); }
  #fc-pw-{{ section.id }} .fc-ig-cta svg { width:20px; height:20px; fill:currentColor; flex:0 0 auto; }
  #fc-pw-{{ section.id }} .fc-ig-cta.is-done {
    background:rgba(25,195,125,.16); border:1px solid var(--fc-green); color:#c8ffe6;
    box-shadow:none; cursor:default;
  }
  #fc-pw-{{ section.id }} .fc-ig-hint { font-size:12px; color:rgba(255,255,255,.55); margin:-6px 0 14px; text-align:center; line-height:1.5; }

  @media (max-width:900px){
    #fc-pw-{{ section.id }} .fc-why { grid-template-columns:repeat(2,minmax(0,1fr)); }
  }
  @media (max-width:760px){
    #fc-pw-{{ section.id }} { padding-top:30px; }
    #fc-pw-{{ section.id }} .fc-prizes { grid-template-columns:1fr; }
    #fc-pw-{{ section.id }} .fc-deals { grid-template-columns:1fr; gap:10px; }
    #fc-pw-{{ section.id }} .fc-deal { display:flex; align-items:center; gap:14px; text-align:left; padding:14px 16px; }
    #fc-pw-{{ section.id }} .fc-deal b { flex:0 0 auto; min-width:86px; font-size:28px; }
    #fc-pw-{{ section.id }} .fc-deal span { margin-top:0; }
    #fc-pw-{{ section.id }} .fc-rib-it { width:150px; }
    #fc-pw-{{ section.id }} .fc-rib-t { font-size:12.5px; min-height:32px; }
    #fc-pw-{{ section.id }} .fc-rib-p b { font-size:16px; }
    #fc-pw-{{ section.id }} .fc-sec { padding-top:44px; }
    #fc-pw-{{ section.id }} .fc-brands { gap:14px 24px; }
    #fc-pw-{{ section.id }} .fc-brands img { height:24px; }
    #fc-pw-{{ section.id }} .fc-brands img.fc-emblem { height:34px; }
  }
  @media (max-width:480px){
    #fc-pw-{{ section.id }} .fc-why { grid-template-columns:1fr; }
    #fc-pw-{{ section.id }} .fc-why-it { display:flex; gap:14px; align-items:flex-start; padding:16px; }
    #fc-pw-{{ section.id }} .fc-why-ico { flex:0 0 auto; margin-bottom:0; }
  }

  /* ---- Animaciones ---- */
  #fc-pw-{{ section.id }}::before {
    content:''; position:absolute; inset:-25%; z-index:0; pointer-events:none;
    background:
      radial-gradient(620px 620px at 28% 18%, rgba(90,47,160,.40), transparent 62%),
      radial-gradient(520px 520px at 78% 72%, rgba(25,195,125,.20), transparent 62%);
    animation: fcFloat 15s ease-in-out infinite alternate;
  }
  @keyframes fcFloat { from { transform:translate3d(0,0,0) scale(1); } to { transform:translate3d(0,-26px,0) scale(1.09); } }
  @keyframes fcUp { from { opacity:0; transform:translateY(20px); } to { opacity:1; transform:none; } }
  @keyframes fcPulse { 0%,100% { box-shadow:0 8px 22px rgba(59,31,107,.45); } 50% { box-shadow:0 12px 34px rgba(90,47,160,.85); } }
  @keyframes fcBadge { 0%,100% { box-shadow:0 0 0 0 rgba(183,156,255,.45); } 50% { box-shadow:0 0 0 6px rgba(183,156,255,0); } }

  #fc-pw-{{ section.id }} .fc-logo,
  #fc-pw-{{ section.id }} .fc-brandline,
  #fc-pw-{{ section.id }} .fc-hero .fc-eyebrow,
  #fc-pw-{{ section.id }} h1.fc-title,
  #fc-pw-{{ section.id }} .fc-hero .fc-sub,
  #fc-pw-{{ section.id }} .fc-clock-wrap { animation: fcUp .7s cubic-bezier(.16,.84,.44,1) both; }
  #fc-pw-{{ section.id }} .fc-logo { animation-delay:.02s; }
  #fc-pw-{{ section.id }} .fc-brandline { animation-delay:.12s; }
  #fc-pw-{{ section.id }} .fc-hero .fc-eyebrow { animation: fcUp .7s cubic-bezier(.16,.84,.44,1) .22s both, fcBadge 2.6s ease-in-out .9s infinite; }
  #fc-pw-{{ section.id }} h1.fc-title { animation-delay:.30s; }
  #fc-pw-{{ section.id }} .fc-hero .fc-sub { animation-delay:.38s; }
  #fc-pw-{{ section.id }} .fc-clock-wrap { animation-delay:.46s; }
  #fc-pw-{{ section.id }} .fc-prize { transition: transform .2s, border-color .2s, background .2s; }
  #fc-pw-{{ section.id }} .fc-prize:hover { transform:translateY(-4px); border-color:rgba(183,156,255,.5); background:rgba(255,255,255,.08); }
  #fc-pw-{{ section.id }} .fc-btn { animation: fcPulse 2.8s ease-in-out infinite; }
  #fc-pw-{{ section.id }} .fc-btn:hover { animation:none; }

  @media (prefers-reduced-motion: reduce) {
    #fc-pw-{{ section.id }} *, #fc-pw-{{ section.id }}::before { animation:none !important; }
  }
</style>

<div id="fc-pw-{{ section.id }}" data-start="{{ start_iso }}" data-end="{{ end_iso }}">

  {%- comment -%} ===== MARCA + HERO ===== {%- endcomment -%}
  <div class="fc-wrap fc-hero">
    {%- if section.settings.logo_url != blank -%}
      <img class="fc-logo" src="{{ section.settings.logo_url }}" alt="{{ shop.name | escape }}" width="260">
    {%- else -%}
      <div style="font-family:'Inter',sans-serif;font-weight:800;font-size:40px;margin-bottom:26px;">FITCORE<span style="color:#19C37D;">.</span>STORE</div>
    {%- endif -%}

    {%- if section.settings.brandline != blank -%}<p class="fc-brandline">{{ section.settings.brandline }}</p>{%- endif -%}
    {%- if section.settings.eyebrow != blank -%}<div class="fc-eyebrow">{{ section.settings.eyebrow }}</div>{%- endif -%}
    {%- if section.settings.heading != blank -%}<h1 class="fc-title">{{ section.settings.heading }}</h1>{%- endif -%}
    {%- if section.settings.subheading != blank -%}<p class="fc-sub">{{ section.settings.subheading }}</p>{%- endif -%}

    <div class="fc-clock-wrap" data-clock hidden>
      <span class="fc-clock-l" data-clock-label>Abrimos en</span>
      <div class="fc-clock" role="timer" aria-live="off">
        <div class="u"><b data-d>00</b><small>Días</small></div>
        <div class="u"><b data-h>00</b><small>Horas</small></div>
        <div class="u"><b data-m>00</b><small>Min</small></div>
        <div class="u"><b data-s>00</b><small>Seg</small></div>
      </div>
    </div>
  </div>

  {%- comment -%} ===== BANNER ENVÍO GRATIS ===== {%- endcomment -%}
  {%- capture ship_item -%}
    <span class="fc-ship-it">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 3h13v13H1z"/><path d="M14 8h4l4 4v4h-8z"/><circle cx="5.5" cy="18.5" r="2"/><circle cx="18.5" cy="18.5" r="2"/></svg>
      Envío gratis en Valera
      <small>{{ ship_days }} días</small>
      <span>Sin mínimo de compra</span>
      <i>●</i>
    </span>
  {%- endcapture -%}
  <div class="fc-ship" role="region" aria-label="Envío gratis en Valera por {{ ship_days }} días, sin mínimo de compra">
    <div class="fc-ship-track">
      <div class="fc-ship-grp">{{ ship_item }}{{ ship_item }}{{ ship_item }}</div>
      <div class="fc-ship-grp" aria-hidden="true">{{ ship_item }}{{ ship_item }}{{ ship_item }}</div>
    </div>
  </div>

  {%- comment -%} ===== OFERTAS DE APERTURA (productos de snippets/fitcore-promo; sin enlaces: la tienda sigue con clave) ===== {%- endcomment -%}
  <section class="fc-sec" aria-labelledby="fc-of-h-{{ section.id }}">
    <div class="fc-wide">
      <div class="fc-sec-h">
        <div class="fc-eyebrow">{{ section.settings.offers_eyebrow | default: 'Del 14 al 21 de noviembre' }}</div>
        <h2 id="fc-of-h-{{ section.id }}">Ofertas de <em>apertura</em></h2>
        <p>{{ section.settings.offers_sub | default: 'Marcas originales importadas de EE.UU. a precio de inauguración. El descuento se aplica solo en tu carrito, sin cupones.' }}</p>
      </div>
      <div class="fc-deals">
        <div class="fc-deal"><b>-22%</b><span>Hasta 22% menos en creatinas Nutrex, ON y Cellucor</span></div>
        <div class="fc-deal"><b>3x2</b><span>Lleva 3 y paga 2 en vitaminas Nature's Bounty</span></div>
        <div class="fc-deal"><b>{{ ship_days }} días</b><span>Envío gratis en Valera, sin mínimo de compra</span></div>
      </div>
    </div>

    {%- capture fc_hs -%}{%- render 'fitcore-promo', product: nil, part: 'handles' -%}{%- endcapture -%}
    {%- assign fc_hl = fc_hs | strip | split: ',' -%}
    {%- capture rib_items -%}
      {%- for h in fc_hl -%}
        {%- assign p = all_products[h] -%}
        {%- if p != blank and p.id -%}
          {%- capture pb -%}{%- render 'fitcore-promo', product: p, part: 'bcv' -%}{%- endcapture -%}
          {%- assign pbn = pb | strip | plus: 0 -%}
          {%- if pbn > 0 and p.price > pbn -%}
            {%- assign off = p.price | minus: pbn | times: 100.0 | divided_by: p.price | round -%}
            {%- assign now_div = pbn | times: 100 | divided_by: 115 -%}
            {%- assign old_div = p.price | times: 100 | divided_by: 115 -%}
            <div class="fc-rib-it">
              <span class="fc-rib-img">
                {%- if p.featured_image -%}<img src="{{ p.featured_image | image_url: width: 400 }}" alt="{{ p.title | escape }}" loading="lazy" width="400" height="400">{%- endif -%}
                <span class="fc-rib-off">-{{ off }}%</span>
              </span>
              <span class="fc-rib-b">
                <span class="fc-rib-v">{{ p.vendor }}</span>
                <span class="fc-rib-t">{{ p.title }}</span>
                <span class="fc-rib-p"><b>{{ now_div | money }}</b><s>{{ old_div | money }}</s><small>Divisa</small></span>
              </span>
            </div>
          {%- endif -%}
        {%- endif -%}
      {%- endfor -%}
    {%- endcapture -%}
    {%- if rib_items != blank -%}
      <div class="fc-rib" aria-label="Productos en oferta de apertura">
        <div class="fc-rib-track">{{ rib_items }}<span style="display:contents" aria-hidden="true">{{ rib_items }}</span></div>
      </div>
      <p class="fc-note">Precios en divisa. Las ofertas se activan el sábado 14 de noviembre en la tienda online y en nuestro kiosco del CC Plaza Valera.</p>
    {%- endif -%}
  </section>

  {%- comment -%} ===== POR QUÉ FITCORE ===== {%- endcomment -%}
  <section class="fc-sec" aria-labelledby="fc-why-h-{{ section.id }}">
    <div class="fc-wide">
      <div class="fc-sec-h">
        <h2 id="fc-why-h-{{ section.id }}">¿Qué es <em>Fitcore Store</em>?</h2>
        <p>La tienda de suplementos que Venezuela estaba esperando: las marcas que usan los atletas en EE.UU., originales y a un precio justo, sin que tengas que viajar ni importar tú mismo.</p>
      </div>
      <div class="fc-why">
        <div class="fc-why-it">
          <span class="fc-why-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 2l8 4v6c0 5-3.5 8.5-8 10-4.5-1.5-8-5-8-10V6z"/><path d="M9 12l2 2 4-4"/></svg></span>
          <div><h3>100% originales</h3><p>Importados directo de EE.UU. Solo marcas originales, nunca réplicas.</p></div>
        </div>
        <div class="fc-why-it">
          <span class="fc-why-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 9l9-6 9 6v11a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1z"/><path d="M9 21V12h6v9"/></svg></span>
          <div><h3>Tienda en Valera</h3><p>Kiosco en el CC Plaza Valera. Retira gratis o recíbelo el mismo día en Valera y Trujillo.</p></div>
        </div>
        <div class="fc-why-it">
          <span class="fc-why-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 3h13v13H1z"/><path d="M14 8h4l4 4v4h-8z"/><circle cx="5.5" cy="18.5" r="2"/><circle cx="18.5" cy="18.5" r="2"/></svg></span>
          <div><h3>Envíos a todo el país</h3><p>Por Zoom, MRW o Tealca, en 1 a 2 días a cualquier ciudad de Venezuela.</p></div>
        </div>
        <div class="fc-why-it">
          <span class="fc-why-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg></span>
          <div><h3>Paga como prefieras</h3><p>Divisa (Zelle, efectivo o tarjeta) al mejor precio, o bolívares a tasa BCV por Pago Móvil.</p></div>
        </div>
      </div>
      <div class="fc-brands" aria-label="Marcas disponibles">
        {%- assign fc_brands = "brand-optimum-nutrition.png|Optimum Nutrition,brand-dymatize.png|Dymatize,brand-muscletech.png|MuscleTech,brand-nutrex.png|Nutrex,brand-c4-energy.png|C4,brand-xtend.png|XTEND,brand-ghost.png|Ghost,brand-bsn.png|BSN,brand-natures-bounty.png|Nature's Bounty,brand-forfit.png|Forfit" | split: ',' -%}
        {%- for pair in fc_brands -%}
          {%- assign pp = pair | split: '|' -%}
          <img {% if pp[0] contains 'brand-bsn' %}class="fc-emblem" {% endif %}src="{{ pp[0] | asset_url }}" alt="{{ pp[1] | escape }}" loading="lazy">
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ===== SORTEO: PREMIOS + FORMULARIO ===== {%- endcomment -%}
  <section class="fc-sec" aria-labelledby="fc-win-h-{{ section.id }}">
    <div class="fc-wrap">
      <div class="fc-sec-h">
        <div class="fc-eyebrow">{{ section.settings.prize_eyebrow | default: 'Sorteo de inauguración' }}</div>
        <h2 id="fc-win-h-{{ section.id }}">Gana un <em>combo</em> de regalo</h2>
        <p>{{ section.settings.prize_sub | default: 'Déjanos tus datos, síguenos en Instagram y entras al sorteo. El ganador se anuncia el sábado 21 de noviembre.' }}</p>
      </div>

      <div class="fc-prizes">
        {%- for i in (1..2) -%}
          {%- if i == 1 -%}
            {%- assign p_img = section.settings.prize1_image_url -%}{%- assign p_tag = section.settings.prize1_tag -%}
            {%- assign p_title = section.settings.prize1_title -%}{%- assign p_text = section.settings.prize1_text -%}
          {%- else -%}
            {%- assign p_img = section.settings.prize2_image_url -%}{%- assign p_tag = section.settings.prize2_tag -%}
            {%- assign p_title = section.settings.prize2_title -%}{%- assign p_text = section.settings.prize2_text -%}
          {%- endif -%}
          <div class="fc-prize">
            {%- if p_img != blank -%}
              <img class="fc-prize__img" src="{{ p_img }}" alt="{{ p_title | escape }}" loading="lazy">
            {%- else -%}
              <div class="fc-prize__ph">Imagen del premio {{ i }}<br>(pr&oacute;ximamente)</div>
            {%- endif -%}
            {%- if p_tag != blank -%}<div class="fc-prize__tag">{{ p_tag }}</div>{%- endif -%}
            <div class="fc-prize__title">{{ p_title }}</div>
            <p class="fc-prize__text">{{ p_text }}</p>
          </div>
        {%- endfor -%}
      </div>

      <div class="fc-card" id="fc-form-card-{{ section.id }}">
        <div class="fc-form-view">
          <h2>{{ section.settings.form_title }}</h2>
          <p class="fc-card__sub">{{ section.settings.form_subtitle }}</p>

          <form id="fc-lead-form-{{ section.id }}" novalidate>
            <div class="fc-field-row">
              <div class="fc-field">
                <label for="fc-first-{{ section.id }}">Nombre</label>
                <input class="fc-input" type="text" id="fc-first-{{ section.id }}" name="first_name" required autocomplete="given-name" placeholder="Tu nombre">
              </div>
              <div class="fc-field">
                <label for="fc-last-{{ section.id }}">Apellido</label>
                <input class="fc-input" type="text" id="fc-last-{{ section.id }}" name="last_name" required autocomplete="family-name" placeholder="Tu apellido">
              </div>
            </div>
            <div class="fc-field">
              <label for="fc-email-{{ section.id }}">Correo electr&oacute;nico</label>
              <input class="fc-input" type="email" id="fc-email-{{ section.id }}" name="email" required autocomplete="email" placeholder="tucorreo@ejemplo.com">
            </div>
            <div class="fc-field">
              <label for="fc-wa-{{ section.id }}">WhatsApp</label>
              <input class="fc-input" type="tel" id="fc-wa-{{ section.id }}" name="whatsapp" required autocomplete="tel" placeholder="0424 000 0000">
            </div>
            <div class="fc-hp"><label>No llenar</label><input type="text" name="website" tabindex="-1" autocomplete="off"></div>

            <button type="button" class="fc-ig-cta" id="fc-ig-btn-{{ section.id }}" data-url="{{ section.settings.instagram_url }}">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.5.2.9.5 1.3.9.4.4.7.8.9 1.3.1.4.3 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.5-.5.9-.9 1.3-.4.4-.8.7-1.3.9-.4.1-1 .3-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4a3.6 3.6 0 0 1-1.3-.9 3.6 3.6 0 0 1-.9-1.3c-.1-.4-.3-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.5.5-.9.9-1.3.4-.4.8-.7 1.3-.9.4-.1 1-.3 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 3.1a6.7 6.7 0 1 0 0 13.4 6.7 6.7 0 0 0 0-13.4zm0 11a4.3 4.3 0 1 1 0-8.6 4.3 4.3 0 0 1 0 8.6zm6.5-11.3a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/></svg>
              <span id="fc-ig-txt-{{ section.id }}">Seguir a @{{ section.settings.instagram_handle }}</span>
            </button>
            <p class="fc-ig-hint">Toca el bot&oacute;n, s&iacute;guenos en Instagram y vuelve para participar.</p>

            <button type="submit" class="fc-btn" id="fc-submit-{{ section.id }}">{{ section.settings.button_label }}</button>
            <p class="fc-msg" id="fc-msg-{{ section.id }}"></p>
          </form>

          {%- comment -%} Form nativo de Shopify (oculto): registra el email en Clientes/marketing {%- endcomment -%}
          {%- form 'customer', id: 'fc-newsletter-form', class: 'fc-hidden-nl' -%}
            <input type="hidden" name="contact[tags]" value="newsletter,{{ section.settings.campaign }}">
            <input type="hidden" name="contact[email]" id="fc-nl-email-{{ section.id }}" value="">
          {%- endform -%}
        </div>

        <div class="fc-success" id="fc-success-{{ section.id }}">
          <h2>{{ section.settings.success_title }}</h2>
          <p class="fc-card__sub">{{ section.settings.success_text }}</p>
          <a class="fc-link fc-ig-btn" href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.5.2.9.5 1.3.9.4.4.7.8.9 1.3.1.4.3 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.5-.5.9-.9 1.3-.4.4-.8.7-1.3.9-.4.1-1 .3-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4a3.6 3.6 0 0 1-1.3-.9 3.6 3.6 0 0 1-.9-1.3c-.1-.4-.3-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.5.5-.9.9-1.3.4-.4.8-.7 1.3-.9.4-.1 1-.3 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 3.1a6.7 6.7 0 1 0 0 13.4 6.7 6.7 0 0 0 0-13.4zm0 11a4.3 4.3 0 1 1 0-8.6 4.3 4.3 0 0 1 0 8.6zm6.5-11.3a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/></svg>
            Seguir @{{ section.settings.instagram_handle }}
          </a>
        </div>
      </div>

      <p class="fc-mech">{{ section.settings.mechanics_text }}</p>

      {%- if section.settings.bases_text != blank -%}
        <details class="fc-bases">
          <summary>Bases y condiciones del sorteo</summary>
          <p>{{ section.settings.bases_text }}</p>
        </details>
      {%- endif -%}

      <div class="fc-links">
        {%- if section.settings.whatsapp_number != blank -%}
          <a class="fc-link" href="https://wa.me/{{ section.settings.whatsapp_number }}" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.5 14.4c-.3-.2-1.7-.8-2-.9-.3-.1-.5-.2-.7.1-.2.3-.7.9-.9 1.1-.2.2-.3.2-.6.1-1.5-.7-2.5-1.3-3.5-3-.3-.5.3-.4.8-1.4.1-.2 0-.4 0-.5 0-.2-.7-1.6-.9-2.2-.2-.6-.5-.5-.7-.5h-.6c-.2 0-.5.1-.8.4-.3.3-1 1-1 2.5s1.1 2.9 1.2 3.1c.2.2 2.1 3.3 5.2 4.6 1.9.8 2.7.9 3.6.8.6-.1 1.7-.7 1.9-1.4.2-.6.2-1.2.2-1.4-.1-.1-.3-.2-.6-.3zM12 2a10 10 0 0 0-8.6 15l-1.3 4.9 5-1.3A10 10 0 1 0 12 2z"/></svg>
            {{ section.settings.whatsapp_label | default: 'WhatsApp' }}
          </a>
        {%- endif -%}
        {%- if section.settings.instagram_url != blank -%}
          <a class="fc-link" href="{{ section.settings.instagram_url }}" target="_blank" rel="noopener">
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.5.2.9.5 1.3.9.4.4.7.8.9 1.3.1.4.3 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.5-.5.9-.9 1.3-.4.4-.8.7-1.3.9-.4.1-1 .3-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4a3.6 3.6 0 0 1-1.3-.9 3.6 3.6 0 0 1-.9-1.3c-.1-.4-.3-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.5.5-.9.9-1.3.4-.4.8-.7 1.3-.9.4-.1 1-.3 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 3.1a6.7 6.7 0 1 0 0 13.4 6.7 6.7 0 0 0 0-13.4zm0 11a4.3 4.3 0 1 1 0-8.6 4.3 4.3 0 0 1 0 8.6zm6.5-11.3a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/></svg>
            @{{ section.settings.instagram_handle }}
          </a>
        {%- endif -%}
      </div>

      <details class="fc-staff">
        <summary>Acceso del equipo</summary>
        {%- form 'storefront_password' -%}
          <input class="fc-input" type="password" name="password" placeholder="Contrase&ntilde;a" autocomplete="current-password">
          <button class="fc-btn" type="submit" name="commit" style="width:auto;padding:14px 20px;">Entrar</button>
        {%- endform -%}
      </details>

      <p class="fc-foot">&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</p>
    </div>
  </section>
</div>

<script>
(function(){
  var root = document.getElementById('fc-pw-{{ section.id }}');
  if (!root) return;

  /* Cuenta regresiva: antes del inicio cuenta hasta la apertura; durante la semana, hasta el fin de las ofertas */
  var start = new Date(root.getAttribute('data-start')).getTime();
  var end = new Date(root.getAttribute('data-end')).getTime();
  var box = root.querySelector('[data-clock]'), label = root.querySelector('[data-clock-label]');
  function pad(n){ return (n < 10 ? '0' : '') + n; }
  function tick(){
    if (!box || isNaN(start) || isNaN(end)) return;
    var now = Date.now(), t;
    if (now < start) { t = start - now; label.textContent = 'Abrimos en'; }
    else if (now <= end) { t = end - now; label.textContent = 'Las ofertas de apertura terminan en'; }
    else { box.hidden = true; return; }
    box.hidden = false;
    box.querySelector('[data-d]').textContent = pad(Math.floor(t / 864e5));
    box.querySelector('[data-h]').textContent = pad(Math.floor(t % 864e5 / 36e5));
    box.querySelector('[data-m]').textContent = pad(Math.floor(t % 36e5 / 6e4));
    box.querySelector('[data-s]').textContent = pad(Math.floor(t % 6e4 / 1e3));
    setTimeout(tick, 1000);
  }
  tick();

  /* Cinta de productos: duración según el ancho real (~35 px/s) */
  var rib = root.querySelector('.fc-rib-track');
  function fit(){ if (!rib) return; var h = rib.scrollWidth / 2; if (h > 0) rib.style.animationDuration = (h / 35) + 's'; }
  if (document.readyState === 'complete') fit(); else window.addEventListener('load', fit);
})();

(function(){
  var SB_URL = {{ sb_url | json }};
  var SB_KEY = {{ sb_key | json }};
  var CAMPAIGN = {{ section.settings.campaign | json }};
  var form = document.getElementById('fc-lead-form-{{ section.id }}');
  if(!form) return;
  var msg = document.getElementById('fc-msg-{{ section.id }}');
  var btn = document.getElementById('fc-submit-{{ section.id }}');
  var formView = form.closest('.fc-form-view');
  var successView = document.getElementById('fc-success-{{ section.id }}');
  var igBtn = document.getElementById('fc-ig-btn-{{ section.id }}');
  var igTxt = document.getElementById('fc-ig-txt-{{ section.id }}');
  var nlForm = document.getElementById('fc-newsletter-form');
  var nlEmail = document.getElementById('fc-nl-email-{{ section.id }}');
  var igFollowed = false;

  function setMsg(t, err){ msg.textContent = t || ''; msg.className = 'fc-msg' + (err ? ' fc-msg--err' : ''); }

  // Registra el email en Shopify (Clientes / email marketing). Best-effort: no bloquea el flujo.
  function submitShopifyEmail(email){
    if(!nlForm || !nlEmail){ return; }
    try {
      nlEmail.value = email;
      var data = new FormData(nlForm);
      fetch(nlForm.getAttribute('action') || '/contact', {
        method: 'POST',
        headers: { 'Accept': 'application/json' },
        body: data
      }).catch(function(){});
    } catch(_){}
  }

  if(igBtn){
    igBtn.addEventListener('click', function(){
      var url = igBtn.getAttribute('data-url');
      if(url){ window.open(url, '_blank', 'noopener'); }
      igFollowed = true;
      igBtn.classList.add('is-done');
      if(igTxt){ igTxt.textContent = 'Listo, ya te sigo · ¡gracias!'; }
      setMsg('', false);
    });
  }

  form.addEventListener('submit', function(e){
    e.preventDefault();
    if(form.website && form.website.value){ return; } // honeypot
    var first = (form.first_name.value||'').trim();
    var last = (form.last_name.value||'').trim();
    var email = (form.email.value||'').trim();
    var wa = (form.whatsapp.value||'').trim();
    if(!first){ setMsg('Ingresa tu nombre.', true); return; }
    if(!last){ setMsg('Ingresa tu apellido.', true); return; }
    if(!email || email.indexOf('@') < 1){ setMsg('Ingresa un correo válido.', true); return; }
    if(!wa){ setMsg('Ingresa tu WhatsApp.', true); return; }
    if(!igFollowed){ setMsg('Toca el botón de Instagram y síguenos para participar.', true); return; }
    if(!SB_URL || !SB_KEY){ setMsg('El registro no está disponible por ahora. Escríbenos por WhatsApp.', true); return; }
    btn.disabled = true; setMsg('Enviando...', false);

    // Envía el email a Shopify en paralelo (no bloquea el sorteo)
    submitShopifyEmail(email);

    fetch(SB_URL + '/rest/v1/fitcore_leads', {
      method:'POST',
      headers:{
        'apikey': SB_KEY,
        'Authorization': 'Bearer ' + SB_KEY,
        'Content-Type':'application/json',
        'Prefer':'return=minimal'
      },
      body: JSON.stringify({
        first_name: first,
        last_name: last,
        email: email,
        whatsapp: wa,
        instagram_follow: igFollowed,
        campaign: CAMPAIGN,
        source: 'password_page',
        user_agent: navigator.userAgent
      })
    }).then(function(r){
      if(r.ok){
        if(formView) formView.style.display='none';
        if(successView) successView.style.display='block';
        try{ window.scrollTo({top:successView.getBoundingClientRect().top+window.scrollY-120,behavior:'smooth'}); }catch(_){}
      } else {
        btn.disabled = false;
        setMsg('No se pudo registrar. Intenta de nuevo o escríbenos por WhatsApp.', true);
      }
    }).catch(function(){
      btn.disabled = false;
      setMsg('Sin conexión. Intenta de nuevo.', true);
    });
  });
})();
</script>

