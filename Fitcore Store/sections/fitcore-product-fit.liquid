{%- comment -%}
  Fitcore Store · Mini-dashboard "Conveniencia por objetivo" (B2C)
{%- endcomment -%}

{%- liquid
  assign cal = product.metafields.fitcore.calorias.value | default: 0
  assign prot = product.metafields.fitcore.proteina.value | default: 0
  assign carb = product.metafields.fitcore.carbohidratos.value | default: 0
  assign sug = product.metafields.fitcore.azucar.value | default: 0
  assign fat = product.metafields.fitcore.grasa.value | default: 0
  assign porcion = product.metafields.fitcore.porcion.value
  assign has_macros = false
  if product.metafields.fitcore.calorias != blank or product.metafields.fitcore.proteina != blank or product.metafields.fitcore.carbohidratos != blank
    assign has_macros = true
  endif
  assign lang = 'es'
  if request.locale.iso_code contains 'en'
    assign lang = 'en'
  endif
-%}

{%- if has_macros -%}
<style>
  #fc-fit-{{ section.id }} {
    --fc-navy: #0B1840; --fc-acc: #19C37D; --fc-line: #e7eaf2; --fc-muted:#56607a;
    max-width: 1300px; margin: 0 auto; padding: 8px 22px 28px;
  }
  #fc-fit-{{ section.id }} .gf-fit { background:#fff; border:1px solid var(--fc-line); border-radius:20px; padding:clamp(20px,3vw,30px); box-shadow:0 18px 50px rgba(11,24,64,.08); }
  #fc-fit-{{ section.id }} .gf-fit__top { display:flex; flex-wrap:wrap; align-items:baseline; justify-content:space-between; gap:8px; margin:0 0 6px; }
  #fc-fit-{{ section.id }} .gf-fit__title { font-family: var(--font-heading-family, sans-serif); font-size:clamp(18px,2.4vw,24px); font-weight:800; color:var(--fc-navy); margin:0; }
  #fc-fit-{{ section.id }} .gf-fit__title span { color:var(--fc-acc); }
  #fc-fit-{{ section.id }} .gf-fit__best { font-size:13px; color:var(--fc-muted); }
  #fc-fit-{{ section.id }} .gf-fit__best b { color:var(--fc-navy); }
  #fc-fit-{{ section.id }} .gf-fit__sub { font-size:13.5px; color:var(--fc-muted); margin:0 0 20px; }
  #fc-fit-{{ section.id }} .gf-fit__grid { display:grid; grid-template-columns:1fr 1fr; gap:16px 28px; }
  #fc-fit-{{ section.id }} .gf-fit__head { display:flex; align-items:baseline; justify-content:space-between; gap:8px; margin:0 0 8px; }
  #fc-fit-{{ section.id }} .gf-fit__name { font-size:14.5px; font-weight:800; color:var(--fc-navy); }
  #fc-fit-{{ section.id }} .gf-fit__name small { display:block; font-size:11px; font-weight:600; color:var(--fc-muted); margin-top:1px; }
  #fc-fit-{{ section.id }} .gf-fit__tag { font-size:12px; font-weight:800; }
  #fc-fit-{{ section.id }} .gf-fit__bar { display:flex; gap:5px; margin:0 0 7px; }
  #fc-fit-{{ section.id }} .gf-fit__seg { height:9px; flex:1; border-radius:5px; background:#eceef4; }
  #fc-fit-{{ section.id }} .gf-fit__why { font-size:12.5px; line-height:1.45; color:#4a5366; margin:0; }
  #fc-fit-{{ section.id }} .gf-fit__note { margin:18px 0 0; font-size:11.5px; color:#9aa3b6; line-height:1.5; border-top:1px solid var(--fc-line); padding-top:14px; }
  @media (max-width:680px){ #fc-fit-{{ section.id }} .gf-fit__grid{ grid-template-columns:1fr; } }
</style>

<div id="fc-fit-{{ section.id }}">
  <div class="gf-fit" data-lang="{{ lang }}" data-cal="{{ cal }}" data-protein="{{ prot }}" data-carbs="{{ carb }}" data-sugar="{{ sug }}" data-fat="{{ fat }}">
    <div class="gf-fit__top">
      <h2 class="gf-fit__title">{% if lang == 'en' %}Fit by <span>goal</span>{% else %}Conveniencia por <span>objetivo</span>{% endif %}</h2>
      <p class="gf-fit__best">{% if lang == 'en' %}Best for:{% else %}Mejor para:{% endif %} <b class="gf-fit__bestv"></b></p>
    </div>
    <p class="gf-fit__sub">{% if lang == 'en' %}Calculated from the nutrition facts per serving.{% else %}Calculado según la tabla nutricional por servicio{% if porcion != blank %} ({{ porcion }}){% endif %}.{% endif %}</p>
    <div class="gf-fit__grid"></div>
    <p class="gf-fit__note">{% if lang == 'en' %}Indicative score based on macros per serving. It does not replace personalized nutrition advice.{% else %}Puntaje orientativo basado en los macros por servicio. No sustituye la asesoría nutricional personalizada.{% endif %}</p>
  </div>
</div>

<script>
(function(){
  var GOALS=[
    {key:'keto',es:'Keto y Low Carb',en:'Keto & Low Carb',subEs:'Bajo en carbohidratos',subEn:'Low carb'},
    {key:'definicion',es:'Definición',en:'Cutting',subEs:'Déficit calórico',subEn:'Calorie deficit'},
    {key:'volumen',es:'Volumen',en:'Bulking',subEs:'Aumento de masa',subEn:'Mass gain'},
    {key:'mantenimiento',es:'Mantenimiento',en:'Maintenance',subEs:'Recomposición',subEn:'Recomp'}
  ];
  var LABELS={5:{es:'Ideal',en:'Ideal'},4:{es:'Muy bueno',en:'Very good'},3:{es:'Bueno',en:'Good'},2:{es:'Regular',en:'Fair'},1:{es:'Bajo',en:'Low'}};
  var COLORS={5:'#16a34a',4:'#65a30d',3:'#d97706',2:'#ea580c',1:'#dc2626'};
  function scoreProduct(m){
    var cal=+m.cal||0,p=+m.protein||0,c=+m.carbs||0,s=+m.sugar||0,f=+m.fat||0;
    var pd=cal>0?p/cal*100:0;
    if(cal<=5&&p<=1&&c<=2){ return {neutral:true,keto:5,definicion:5,volumen:3,mantenimiento:5}; }
    var keto=c<=3?5:c<=7?4:c<=12?3:c<=20?2:1;
    var def=pd>=18?5:pd>=11?4:pd>=7?3:pd>=4?2:1; if(s>=10&&def>2)def--;
    var vol=cal>=600?5:cal>=350?4:cal>=200?3:cal>=120?2:1;
    var man=(pd>=11&&s<=6)?5:(pd>=8&&s<=9)?4:(pd>=5)?3:2;
    return {keto:keto,definicion:def,volumen:vol,mantenimiento:man};
  }
  function whyText(key,sc,m,lang,neutral){
    var es=lang!=='en';
    if(neutral)return es?'Sin aporte calórico: encaja en cualquier fase.':'No calories: fits any phase.';
    var c=+m.carbs||0,p=+m.protein||0,cal=+m.cal||0;
    if(key==='keto')return es?('Solo '+c+' g de carbohidratos por servicio.'):('Only '+c+' g of carbs per serving.');
    if(key==='definicion')return es?(p+' g de proteína en apenas '+cal+' kcal.'):(p+' g protein in just '+cal+' kcal.');
    if(key==='volumen')return sc>=4?(es?(cal+' kcal por servicio para tu superávit.'):(cal+' kcal per serving for your surplus.')):(es?'Pocas calorías; conviene sumarle carbohidratos.':'Low calories; pair it with carbs.');
    return es?'Proteína de calidad con bajo azúcar.':'Quality protein, low sugar.';
  }
  function renderFit(el){
    var m={cal:el.dataset.cal,protein:el.dataset.protein,carbs:el.dataset.carbs,sugar:el.dataset.sugar,fat:el.dataset.fat};
    var sc=scoreProduct(m);
    var lang=el.dataset.lang||'es';
    var grid=el.querySelector('.gf-fit__grid');
    grid.innerHTML='';
    var best=[];
    GOALS.forEach(function(g){
      var v=sc[g.key];
      if(v>=5)best.push(lang==='en'?g.en:g.es);
      var item=document.createElement('div');item.className='gf-fit__item';
      var segs='';for(var i=1;i<=5;i++){segs+='<span class="gf-fit__seg" style="'+(i<=v?'background:'+COLORS[v]:'')+'"></span>';}
      item.innerHTML=
        '<div class="gf-fit__head"><span class="gf-fit__name">'+(lang==='en'?g.en:g.es)+'<small>'+(lang==='en'?g.subEn:g.subEs)+'</small></span>'+
        '<span class="gf-fit__tag" style="color:'+COLORS[v]+'">'+(lang==='en'?LABELS[v].en:LABELS[v].es)+'</span></div>'+
        '<div class="gf-fit__bar">'+segs+'</div>'+
        '<p class="gf-fit__why">'+whyText(g.key,v,m,lang,sc.neutral)+'</p>';
      grid.appendChild(item);
    });
    var bv=el.querySelector('.gf-fit__bestv');
    if(bv)bv.textContent=best.length?best.join(' · '):(lang==='en'?'Maintenance':'Mantenimiento');
  }
  document.querySelectorAll('#fc-fit-{{ section.id }} .gf-fit').forEach(renderFit);
})();
</script>
{%- endif -%}

{% schema %}
{
  "name": "Fitcore Conveniencia",
  "tag": "section",
  "class": "fitcore-product-fit",
  "settings": [
    { "type": "paragraph", "content": "Muestra el mini-dashboard de conveniencia por objetivo. Requiere que el producto tenga cargados los metafields de macros (namespace fitcore): calorias, proteina, carbohidratos, azucar, grasa." }
  ],
  "presets": [
    { "name": "Fitcore Conveniencia" }
  ]
}
{% endschema %}