{%- comment -%}
  FitCore Store · Página de contenido genérica (B2C)
  Reutilizable para Envíos, Nosotros, Políticas, etc.
{%- endcomment -%}

<style>
  #fc-pg-{{ section.id }} {
    --fc-navy:#0B1840; --fc-purple:#3B1F6B; --fc-accent:#19C37D; --fc-line:#e7eaf2; --fc-muted:#56607a;
  }
  #fc-pg-{{ section.id }} .fc-pg-hero {
    background: radial-gradient(800px 420px at 12% -20%, var(--fc-purple) 0%, transparent 58%), linear-gradient(160deg, var(--fc-navy) 0%, #071631 100%);
    color:#fff; padding:56px 0 50px;
  }
  #fc-pg-{{ section.id }} .fc-wrap { max-width:940px; margin:0 auto; padding:0 22px; }
  #fc-pg-{{ section.id }} .fc-pg-hero h1 { font-family:var(--font-heading-family,sans-serif); font-weight:800; font-size:clamp(30px,4.4vw,48px); margin:0; }
  #fc-pg-{{ section.id }} .fc-pg-hero p { font:400 17px/1.55 var(--font-body-family,sans-serif); color:rgba(255,255,255,.78); margin:12px 0 0; max-width:64ch; }
  #fc-pg-{{ section.id }} .fc-pg-body { background:#fff; padding:48px 0 64px; }
  #fc-pg-{{ section.id }} .fc-rt { color:#3a4253; font:400 16.5px/1.7 var(--font-body-family,sans-serif); }
  #fc-pg-{{ section.id }} .fc-rt h2 { font-family:var(--font-heading-family,sans-serif); color:var(--fc-navy); font-size:clamp(22px,2.6vw,30px); font-weight:800; margin:34px 0 12px; }
  #fc-pg-{{ section.id }} .fc-rt h3 { color:var(--fc-navy); font-size:19px; font-weight:800; margin:24px 0 8px; }
  #fc-pg-{{ section.id }} .fc-rt :is(p,ul,ol) { margin:0 0 14px; }
  #fc-pg-{{ section.id }} .fc-rt a { color:var(--fc-purple); font-weight:700; }
  #fc-pg-{{ section.id }} .fc-cards { display:grid; grid-template-columns:repeat(3,1fr); gap:16px; margin:8px 0 8px; }
  #fc-pg-{{ section.id }} .fc-card { border:1px solid var(--fc-line); border-radius:16px; padding:22px; }
  #fc-pg-{{ section.id }} .fc-card b { display:block; color:var(--fc-navy); font:700 17px/1.3 var(--font-body-family,sans-serif); margin:0 0 6px; }
  #fc-pg-{{ section.id }} .fc-card p { color:var(--fc-muted); font:400 14px/1.55 var(--font-body-family,sans-serif); margin:0; }
  @media (max-width:780px){ #fc-pg-{{ section.id }} .fc-cards { grid-template-columns:1fr; } }
</style>

<div id="fc-pg-{{ section.id }}">
  <section class="fc-pg-hero">
    <div class="fc-wrap">
      <h1>{{ section.settings.title | default: 'Título de la página' }}</h1>
      {%- if section.settings.subtitle != blank -%}<p>{{ section.settings.subtitle }}</p>{%- endif -%}
    </div>
  </section>
  <section class="fc-pg-body">
    <div class="fc-wrap">
      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'richtext' -%}
            <div class="fc-rt" {{ block.shopify_attributes }}>{{ block.settings.content }}</div>
          {%- when 'cards' -%}
            <div class="fc-cards" {{ block.shopify_attributes }}>
              {%- if block.settings.c1_title != blank -%}<div class="fc-card"><b>{{ block.settings.c1_title }}</b><p>{{ block.settings.c1_text }}</p></div>{%- endif -%}
              {%- if block.settings.c2_title != blank -%}<div class="fc-card"><b>{{ block.settings.c2_title }}</b><p>{{ block.settings.c2_text }}</p></div>{%- endif -%}
              {%- if block.settings.c3_title != blank -%}<div class="fc-card"><b>{{ block.settings.c3_title }}</b><p>{{ block.settings.c3_text }}</p></div>{%- endif -%}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>
  </section>
</div>

{% schema %}
{
  "name": "FitCore Página",
  "tag": "section",
  "class": "fitcore-page",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "Título de la página" },
    { "type": "text", "id": "subtitle", "label": "Subtítulo" }
  ],
  "blocks": [
    {
      "type": "richtext",
      "name": "Texto",
      "settings": [
        { "type": "richtext", "id": "content", "label": "Contenido", "default": "<p>Escribe aquí el contenido de la página.</p>" }
      ]
    },
    {
      "type": "cards",
      "name": "3 tarjetas",
      "settings": [
        { "type": "text", "id": "c1_title", "label": "Tarjeta 1 · título", "default": "Título" },
        { "type": "textarea", "id": "c1_text", "label": "Tarjeta 1 · texto", "default": "Texto." },
        { "type": "text", "id": "c2_title", "label": "Tarjeta 2 · título", "default": "Título" },
        { "type": "textarea", "id": "c2_text", "label": "Tarjeta 2 · texto", "default": "Texto." },
        { "type": "text", "id": "c3_title", "label": "Tarjeta 3 · título", "default": "Título" },
        { "type": "textarea", "id": "c3_text", "label": "Tarjeta 3 · texto", "default": "Texto." }
      ]
    }
  ],
  "presets": [
    { "name": "FitCore Página", "blocks": [ { "type": "richtext" } ] }
  ]
}
{% endschema %}