<script>
  (function () {
    var root = document.getElementById('fc-home-{{ section.id }}');
    if (!root) return;
    var items = root.querySelectorAll('.fc-reveal');
    if (!items.length) return;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (reduce || !('IntersectionObserver' in window)) {
      items.forEach(function (el) { el.classList.add('is-in'); });
      return;
    }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) {
        if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -8% 0px' });
    items.forEach(function (el) { io.observe(el); });
  })();

  (function () {
    var root = document.getElementById('fc-home-{{ section.id }}');
    if (!root) return;
    var els = root.querySelectorAll('[data-fc-count]');
    if (!els.length) return;
    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    function run(el) {
      var target = parseInt(el.getAttribute('data-fc-count'), 10) || 0;
      var suffix = el.getAttribute('data-fc-suffix') || '';
      if (reduce) { el.textContent = target + suffix; return; }
      var dur = 1400, start = null;
      function tick(t) {
        if (!start) start = t;
        var p = Math.min((t - start) / dur, 1);
        el.textContent = Math.floor(p * target) + suffix;
        if (p < 1) { requestAnimationFrame(tick); } else { el.textContent = target + suffix; }
      }
      requestAnimationFrame(tick);
    }
    if (!('IntersectionObserver' in window)) { els.forEach(run); return; }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (e) { if (e.isIntersecting) { run(e.target); io.unobserve(e.target); } });
    }, { threshold: 0.5 });
    els.forEach(function (el) { io.observe(el); });
  })();

  (function () {
    var root = document.getElementById('fc-home-{{ section.id }}');
    if (!root) return;
    var forms = root.querySelectorAll('form[data-fc-add]');
    if (!forms.length) return;
    forms.forEach(function (form) {
      form.addEventListener('submit', function (ev) {
        if (!window.fetch) return; // fallback: native POST -> /cart
        ev.preventDefault();
        var btn = form.querySelector('.fc-pc-cart');
        // Feedback instantaneo: el spinner aparece al tocar, sin esperar la red.
        // Tambien evita el doble toque mientras la peticion esta en curso.
        if (btn) {
          if (btn.classList.contains('is-loading')) return;
          btn.classList.add('is-loading');
        }
        var notif = document.querySelector('cart-notification, cart-drawer');
        var body = new FormData(form);
        body.append('sections', 'cart-notification-product,cart-notification-button,cart-icon-bubble');
        body.append('sections_url', window.location.pathname);
        fetch('{{ routes.cart_add_url }}.js', {
          method: 'POST',
          headers: { 'Accept': 'application/json', 'X-Requested-With': 'XMLHttpRequest' },
          body: body
        }).then(function (r) { return r.json(); }).then(function (res) {
          if (res && res.status) { if (btn) btn.classList.remove('is-loading'); form.submit(); return; } // error (e.g. no disponible)
          if (btn) {
            btn.classList.remove('is-loading');
            btn.classList.add('is-added');
            var svg = btn.innerHTML;
            btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>';
            setTimeout(function () { btn.innerHTML = svg; btn.classList.remove('is-added'); }, 1600);
          }
          // Actualiza la notificación de carrito + el contador de la esquina (Dawn)
          if (notif && typeof notif.renderContents === 'function') {
            try { notif.renderContents(res); } catch (e) {}
          } else if (res.sections && res.sections['cart-icon-bubble']) {
            var b = document.getElementById('cart-icon-bubble');
            if (b) { var t = document.createElement('div'); t.innerHTML = res.sections['cart-icon-bubble']; var s = t.querySelector('.shopify-section'); b.innerHTML = s ? s.innerHTML : t.innerHTML; }
          }
          document.dispatchEvent(new CustomEvent('fc:cart:added'));
        }).catch(function () { if (btn) btn.classList.remove('is-loading'); form.submit(); });
      });
    });
  })();

  // Carrusel "Destacados por categoría": rota cada 3s, se pausa al pasar el mouse,
  // y las flechas permiten avanzar/retroceder manualmente.
  (function () {
    var root = document.getElementById('fc-home-{{ section.id }}');
    if (!root) return;
    var rot = root.querySelector('[data-catrot]');
    if (!rot) return;
    var slides = Array.prototype.slice.call(rot.querySelectorAll('.fc-catrot-slide'));
    if (!slides.length) return;
    var label = rot.querySelector('[data-catrot-label]');
    var prevBtn = rot.querySelector('[data-catrot-prev]');
    var nextBtn = rot.querySelector('[data-catrot-next]');
    var idx = 0, timer = null, paused = false;

    function show(i) {
      idx = (i + slides.length) % slides.length;
      slides.forEach(function (s, k) { s.classList.toggle('is-active', k === idx); });
      if (label) label.textContent = slides[idx].getAttribute('data-cat-name') || '';
    }
    var visible = false, started = false;
    function stop() { if (timer) { clearInterval(timer); timer = null; } }
    function start() { stop(); if (!paused && visible && slides.length > 1) { timer = setInterval(function () { show(idx + 1); }, 4000); } }

    if (nextBtn) nextBtn.addEventListener('click', function () { show(idx + 1); start(); });
    if (prevBtn) prevBtn.addEventListener('click', function () { show(idx - 1); start(); });
    rot.addEventListener('mouseenter', function () { paused = true; stop(); });
    rot.addEventListener('mouseleave', function () { paused = false; start(); });

    // Si solo hay una categoría, ocultamos las flechas
    if (slides.length < 2) {
      if (prevBtn) prevBtn.style.display = 'none';
      if (nextBtn) nextBtn.style.display = 'none';
    }

    show(0);

    // La rotación automática arranca solo cuando la sección entra en pantalla,
    // así el visitante siempre llega a Vitaminas (la primera) antes de que cambie.
    if ('IntersectionObserver' in window) {
      var io = new IntersectionObserver(function (entries) {
        entries.forEach(function (e) {
          if (e.isIntersecting) {
            visible = true;
            if (!started) { started = true; show(0); }
            start();
          } else {
            visible = false;
            stop();
          }
        });
      }, { threshold: 0.35 });
      io.observe(rot);
    } else {
      visible = true;
      start();
    }
  })();

  (function () {
    var root = document.getElementById('fc-home-{{ section.id }}');
    if (!root) return;
    var mask = root.querySelector('.fc-marq-mask');
    var track = mask && mask.querySelector('.fc-marq-track');
    if (!mask || !track) return;

    var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    var speed = 0.9;            // px por frame (auto-scroll)
    var paused = false;         // pausado por hover/toque
    var dragging = false;       // arrastre activo con mouse
    var moved = false;          // se movió lo suficiente para bloquear el click
    var startX = 0, startScroll = 0;
    var pos = 0;                // acumulador decimal (scrollLeft redondea a entero)

    // El track está duplicado 2x: media anchura = un ciclo completo
    function half() { return track.scrollWidth / 2; }

    function normalize() {
      var h = half();
      if (h <= 0) return;
      if (pos >= h) { pos -= h; }
      else if (pos < 0) { pos += h; }
    }

    function frame() {
      if (!paused && !dragging) {
        pos += speed;
        normalize();
        mask.scrollLeft = pos;
      }
      requestAnimationFrame(frame);
    }

    // Pausa al pasar el mouse / tocar
    mask.addEventListener('mouseenter', function () { paused = true; });
    mask.addEventListener('mouseleave', function () { paused = false; });
    mask.addEventListener('touchstart', function () { paused = true; }, { passive: true });
    mask.addEventListener('touchend', function () { paused = false; pos = mask.scrollLeft; }, { passive: true });

    // Arrastre con mouse (desktop)
    mask.addEventListener('pointerdown', function (e) {
      if (e.pointerType === 'touch') return; // el touch usa scroll nativo
      dragging = true; moved = false;
      startX = e.clientX; startScroll = mask.scrollLeft;
      mask.classList.add('is-grabbing');
      // NO usar setPointerCapture: redirige el click al contenedor y rompe el enlace del logo
    });
    window.addEventListener('pointermove', function (e) {
      if (!dragging) return;
      var dx = e.clientX - startX;
      if (Math.abs(dx) > 4) moved = true;
      pos = startScroll - dx;
      normalize();
      mask.scrollLeft = pos;
    });
    function endDrag(e) {
      if (!dragging) return;
      dragging = false;
      pos = mask.scrollLeft;
      mask.classList.remove('is-grabbing');
    }
    window.addEventListener('pointerup', endDrag);
    window.addEventListener('pointercancel', endDrag);
    // Evita que un arrastre dispare el enlace del logo
    mask.addEventListener('click', function (e) {
      if (moved) { e.preventDefault(); e.stopPropagation(); moved = false; }
    }, true);

    // Arranque: esperar a que las imágenes midan el ancho
    function start() { if (!reduce) requestAnimationFrame(frame); }
    if (document.readyState === 'complete') { start(); }
    else { window.addEventListener('load', start); }
  })();
</script>

