          </button>
          <div class="fc-catrot-slides">
            {%- for fc_rc in fc_rot_cats -%}
              {%- assign fc_rcol = collections[fc_rc] -%}
              {%- comment -%} Orden fijo por categoría (handles). Si no hay override, usa el orden de la colección. {%- endcomment -%}
              {%- assign fc_override = '' -%}
              {%- case fc_rc -%}
                {%- when 'vitaminas' -%}
                  {%- assign fc_override = 'natures-bounty-hair-skin-nails-60-caplets,natures-bounty-vitamina-d3-2000-iu-tamano-familiar-350-softgels,optimum-nutrition-opti-women,optimum-nutrition-opti-men' -%}
              {%- endcase -%}
