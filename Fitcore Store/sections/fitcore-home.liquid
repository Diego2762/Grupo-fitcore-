                <div class="fc-catrot-slide" data-cat-name="{{ fc_rcol.title | escape }}">
                  <div class="fc-catrot-grid">
                    {%- if fc_override != blank -%}
                      {%- assign fc_ov_handles = fc_override | split: ',' -%}
                      {%- for fc_ovh in fc_ov_handles -%}
                        {%- assign fc_ovh_clean = fc_ovh | strip -%}
                        {%- assign fc_ovp = all_products[fc_ovh_clean] -%}
                        {%- if fc_ovp != blank and fc_ovp.id -%}
                          {%- render 'fitcore-product-card', product: fc_ovp, lazy: true -%}
                        {%- endif -%}
                      {%- endfor -%}
                    {%- else -%}
                      {%- for fc_rp in fc_rcol.products limit: 4 -%}
                        {%- render 'fitcore-product-card', product: fc_rp, lazy: true -%}
                      {%- endfor -%}
                    {%- endif -%}
                  </div>
                </div>
              {%- endif -%}
            {%- endfor -%}
