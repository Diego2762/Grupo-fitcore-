{%- comment -%}
  FitCore Store · Sección de inicio (B2C)
  Sección autónoma para la home: hero, beneficios, categorías,
  "¿Cómo comprar?", envíos, pagos y ubicación de la tienda.
  Pegar en: Online Store > Themes > Edit code > Sections > Add new > "fitcore-home"
  Luego añadirla a la plantilla de inicio (index) desde el editor de temas.
{%- endcomment -%}

{%- liquid
  assign wa = section.settings.whatsapp | default: '584246218863'
  assign wa_msg = section.settings.whatsapp_msg | default: 'Hola FitCore Store, quiero hacer un pedido'
  assign wa_msg_enc = wa_msg | url_encode
-%}

<style>
  #fc-home-{{ section.id }} {
    --fc-navy: {{ section.settings.color_navy | default: '#0B1840' }};
    --fc-purple: {{ section.settings.color_purple | default: '#3B1F6B' }};
    --fc-dark: #111D3E;
    --fc-darker: #071631;
    --fc-light: #F6F7FA;
    --fc-accent: {{ section.settings.color_accent | default: '#19C37D' }};
    --fc-line: rgba(255,255,255,.12);
  }
  #fc-home-{{ section.id }} * { box-sizing: border-box; }
  #fc-home-{{ section.id }} .fc-wrap { max-width: 1300px; margin: 0 auto; padding: 0 22px; }
  #fc-home-{{ section.id }} .fc-eyebrow {
    display:inline-block; font: 700 13px/1 var(--font-body-family, sans-serif);
    letter-spacing:.18em; text-transform:uppercase; color: var(--fc-accent);
    margin-bottom: 14px;
  }
  #fc-home-{{ section.id }} h2.fc-h, #fc-home-{{ section.id }} h1.fc-h {
    font-family: var(--font-heading-family, sans-serif);
    line-height: 1.04; margin: 0 0 14px; letter-spacing: .01em;
  }

  /* HERO (oscuro con imagen de productos) */
  #fc-home-{{ section.id }} .fc-hero {
    background:
      linear-gradient(90deg, var(--fc-navy) 0%, rgba(11,24,64,.94) 30%, rgba(11,24,64,.55) 58%, rgba(7,22,49,.18) 100%),
      url('{{ "fitcore-hero-productos.jpg" | asset_url }}') no-repeat right center / cover,
      var(--fc-darker);
    color:#fff; padding: 84px 0 76px; position: relative; overflow: hidden;
    min-height: 540px; display:flex; align-items:center;
  }
  #fc-home-{{ section.id }} .fc-hero .fc-wrap { max-width: 1720px; margin: 0 auto; width: 100%; padding-left: 32px; padding-right: 32px; }
  #fc-home-{{ section.id }} .fc-hero .fc-wrap > * { max-width: 540px; }
  #fc-home-{{ section.id }} .fc-hero h1 { font-size: clamp(34px, 5.4vw, 62px); font-weight: 800; max-width: 13ch; }
  #fc-home-{{ section.id }} .fc-hero p { font: 400 clamp(16px,1.4vw,20px)/1.55 var(--font-body-family, sans-serif); color: rgba(255,255,255,.82); max-width: 46ch; margin: 0 0 30px; }
  #fc-home-{{ section.id }} .fc-cta-row { display:flex; flex-wrap:wrap; gap:14px; }
  #fc-home-{{ section.id }} .fc-btn {
    display:inline-flex; align-items:center; gap:9px; cursor:pointer;
    font: 700 16px/1 var(--font-body-family, sans-serif); text-decoration:none;
    padding: 16px 26px; border-radius: 10px; transition: transform .12s ease, filter .12s ease;
  }
  #fc-home-{{ section.id }} .fc-btn:hover { transform: translateY(-2px); }
  #fc-home-{{ section.id }} .fc-btn--primary { background:#fff; color: var(--fc-navy); }
  #fc-home-{{ section.id }} .fc-btn--wa { background:#25D366; color:#04231a; }
  #fc-home-{{ section.id }} .fc-btn--ghost { background: transparent; color:#fff; border:1.5px solid rgba(255,255,255,.28); }

  /* BENEFITS (oscuro) */
  #fc-home-{{ section.id }} .fc-bene { background: var(--fc-dark); color:#fff; padding: 26px 0; }
  #fc-home-{{ section.id }} .fc-bene-grid { display:grid; grid-template-columns: repeat(4,1fr); gap: 14px; }
  #fc-home-{{ section.id }} .fc-bene-item { display:flex; gap:12px; align-items:flex-start; }
  #fc-home-{{ section.id }} .fc-bene-item svg { flex:0 0 auto; width:26px; height:26px; color:#fff; opacity:.92; }
  #fc-home-{{ section.id }} .fc-bene-item b { display:block; font: 700 15px/1.2 var(--font-body-family, sans-serif); margin-bottom:3px; }
  #fc-home-{{ section.id }} .fc-bene-item span { font: 400 13px/1.4 var(--font-body-family, sans-serif); color: rgba(255,255,255,.7); }

  /* MARQUEE MARCAS */
  #fc-home-{{ section.id }} .fc-marq { background:#fff; padding: 30px 0 34px; border-bottom: 1px solid #e7eaf2; overflow: hidden; }
  #fc-home-{{ section.id }} .fc-marq-title { text-align:center; color:#8a93b5; font: 800 12px/1 var(--font-body-family, sans-serif); letter-spacing:.16em; text-transform:uppercase; margin:0 0 22px; }
  #fc-home-{{ section.id }} .fc-marq-mask { position:relative; width:100%; overflow:hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 8%, #000 92%, transparent 100%);
            mask-image: linear-gradient(90deg, transparent 0, #000 8%, #000 92%, transparent 100%); }
  #fc-home-{{ section.id }} .fc-marq-track { display:flex; width:max-content; align-items:center; animation: fc-scroll 28s linear infinite; }
  #fc-home-{{ section.id }} .fc-marq-track:hover { animation-play-state: paused; }
  #fc-home-{{ section.id }} .fc-marq-track img { height:40px; width:auto; max-width:150px; object-fit:contain; margin:0 38px; filter:grayscale(100%); opacity:.55; transition: filter .2s ease, opacity .2s ease; }
  #fc-home-{{ section.id }} .fc-marq-track img:hover { filter:none; opacity:1; }
  @keyframes fc-scroll { 0%{ transform:translateX(0); } 100%{ transform:translateX(-50%); } }

  /* CATEGORIES */
  #fc-home-{{ section.id }} .fc-cats { background: var(--fc-light); padding: 70px 0; }
  #fc-home-{{ section.id }} .fc-cats h2 { color: var(--fc-navy); font-size: clamp(28px,3.4vw,42px); font-weight:800; }
  #fc-home-{{ section.id }} .fc-cats .fc-sub { color:#56607a; font: 400 17px/1.5 var(--font-body-family, sans-serif); margin:0 0 34px; }
  #fc-home-{{ section.id }} .fc-cat-grid { display:grid; grid-template-columns: repeat(3,1fr); gap: 18px; }
  #fc-home-{{ section.id }} .fc-cat {
    display:flex; flex-direction:column; justify-content:flex-end; min-height: 168px;
    padding: 22px; border-radius: 16px; text-decoration:none; color:#fff; position:relative; overflow:hidden;
    background: linear-gradient(150deg, var(--fc-navy), var(--fc-purple));
    transition: transform .14s ease, box-shadow .14s ease;
  }
  #fc-home-{{ section.id }} .fc-cat-bg {
    position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:0;
    transition: transform .3s ease;
  }
  #fc-home-{{ section.id }} .fc-cat::after {
    content:""; position:absolute; inset:0; z-index:1;
    background: linear-gradient(180deg, rgba(7,22,49,.10) 0%, rgba(7,22,49,.80) 100%);
  }
  #fc-home-{{ section.id }} .fc-cat.is-plain::after { background: transparent; }
  #fc-home-{{ section.id }} .fc-cat > span,
  #fc-home-{{ section.id }} .fc-cat > h3 { position:relative; z-index:2; }
  #fc-home-{{ section.id }} .fc-cat:hover { transform: translateY(-4px); box-shadow: 0 16px 34px rgba(11,24,64,.22); }
  #fc-home-{{ section.id }} .fc-cat:hover .fc-cat-bg { transform: scale(1.05); }
  #fc-home-{{ section.id }} .fc-cat h3 { font-family: var(--font-heading-family, sans-serif); font-size: 24px; font-weight:800; margin:0 0 4px; text-shadow: 0 1px 12px rgba(7,22,49,.45); }
  #fc-home-{{ section.id }} .fc-cat span { font: 600 13px/1 var(--font-body-family, sans-serif); color: rgba(255,255,255,.72); letter-spacing:.08em; text-transform:uppercase; }

  /* COMO COMPRAR */
  #fc-home-{{ section.id }} .fc-steps { background:#fff; padding: 80px 0; }
  #fc-home-{{ section.id }} .fc-steps h2 { color: var(--fc-navy); text-align:center; font-size: clamp(28px,3.4vw,42px); font-weight:800; }
  #fc-home-{{ section.id }} .fc-steps .fc-sub { text-align:center; color:#56607a; font: 400 17px/1.5 var(--font-body-family, sans-serif); margin:0 auto 52px; max-width: 60ch; }
  #fc-home-{{ section.id }} .fc-steps-grid { display:grid; grid-template-columns: repeat(4,1fr); gap: 22px; position:relative; }
  /* línea conectora entre pasos (desktop) */
  #fc-home-{{ section.id }} .fc-steps-grid::before {
    content:""; position:absolute; top: 46px; left: 12.5%; right: 12.5%; height: 2px; z-index:0;
    background: repeating-linear-gradient(90deg, #d7ddf0 0 8px, transparent 8px 16px);
  }
  #fc-home-{{ section.id }} .fc-step {
    text-align:center; padding: 30px 20px 26px; border:1px solid #e7eaf2; border-radius:18px; position:relative; z-index:1;
    background:#fff; transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }
  #fc-home-{{ section.id }} .fc-step:hover { transform: translateY(-6px); box-shadow: 0 18px 40px rgba(11,24,64,.12); border-color: transparent; }
  #fc-home-{{ section.id }} .fc-step-num {
    width:70px; height:70px; border-radius:50%; margin:0 auto 18px; display:grid; place-items:center; position:relative;
    background: linear-gradient(150deg, var(--fc-navy), var(--fc-purple)); color:#fff;
    box-shadow: 0 10px 22px rgba(59,31,107,.28);
  }
  #fc-home-{{ section.id }} .fc-step-num svg { width:30px; height:30px; }
  #fc-home-{{ section.id }} .fc-step-num::after {
    content: attr(data-n); position:absolute; top:-6px; right:-6px;
    width:26px; height:26px; border-radius:50%; display:grid; place-items:center;
    background: var(--fc-accent); color: var(--fc-darker); border:3px solid #fff;
    font: 800 13px/1 var(--font-heading-family, sans-serif);
  }
  #fc-home-{{ section.id }} .fc-step:hover .fc-step-num { transform: scale(1.06); transition: transform .2s ease; }
  #fc-home-{{ section.id }} .fc-step h3 { display:block; color: var(--fc-navy); font: 700 18px/1.25 var(--font-body-family, sans-serif); margin:0 0 8px; }
  #fc-home-{{ section.id }} .fc-step p { color:#56607a; font: 400 14px/1.55 var(--font-body-family, sans-serif); margin:0; }

  /* ===== ANIMACIONES / SCROLL REVEAL ===== */
  #fc-home-{{ section.id }} .fc-reveal { opacity: 0; transform: translateY(26px); transition: opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1); transition-delay: var(--fc-d, 0ms); will-change: opacity, transform; }
  #fc-home-{{ section.id }} .fc-reveal.is-in { opacity: 1; transform: none; }
  /* Tarjetas interactivas: reveal solo con fade para que el hover siga siendo ágil */
  #fc-home-{{ section.id }} .fc-cat.fc-reveal { transform: none; transition: opacity .6s ease var(--fc-d,0ms), transform .14s ease, box-shadow .14s ease; }
  #fc-home-{{ section.id }} .fc-step.fc-reveal { transform: none; transition: opacity .6s ease var(--fc-d,0ms), transform .2s ease, box-shadow .2s ease, border-color .2s ease; }
  #fc-home-{{ section.id }} .fc-cat.fc-reveal.is-in, #fc-home-{{ section.id }} .fc-step.fc-reveal.is-in { transform: none; }
  #fc-home-{{ section.id }} .fc-hero h1.fc-h,
  #fc-home-{{ section.id }} .fc-hero p,
  #fc-home-{{ section.id }} .fc-hero .fc-cta-row { opacity: 0; animation: fc-hero-in .8s cubic-bezier(.2,.7,.2,1) forwards; }
  #fc-home-{{ section.id }} .fc-hero h1.fc-h { animation-delay: .05s; }
  #fc-home-{{ section.id }} .fc-hero p { animation-delay: .22s; }
  #fc-home-{{ section.id }} .fc-hero .fc-cta-row { animation-delay: .38s; }
  @keyframes fc-hero-in { from { opacity:0; transform: translateY(22px); } to { opacity:1; transform:none; } }
  @media (prefers-reduced-motion: reduce) {
    #fc-home-{{ section.id }} .fc-reveal { opacity:1 !important; transform:none !important; transition:none !important; }
    #fc-home-{{ section.id }} .fc-hero h1.fc-h,
    #fc-home-{{ section.id }} .fc-hero p,
    #fc-home-{{ section.id }} .fc-hero .fc-cta-row { opacity:1 !important; animation:none !important; }
    #fc-home-{{ section.id }} .fc-marq-track { animation:none !important; }
  }

  /* ENVIOS + PAGOS */
  #fc-home-{{ section.id }} .fc-info { background: var(--fc-navy); color:#fff; padding: 70px 0; }
  #fc-home-{{ section.id }} .fc-info-cols { display:grid; grid-template-columns: 1fr 1fr; gap: 46px; }
  #fc-home-{{ section.id }} .fc-info h2 { font-size: clamp(24px,2.6vw,32px); font-weight:800; }
  #fc-home-{{ section.id }} .fc-list { list-style:none; margin:18px 0 0; padding:0; }
  #fc-home-{{ section.id }} .fc-list li { display:flex; gap:13px; padding:13px 0; border-bottom:1px solid var(--fc-line); }
  #fc-home-{{ section.id }} .fc-list li svg { flex:0 0 auto; width:22px; height:22px; color:#fff; opacity:.9; margin-top:2px; }
  #fc-home-{{ section.id }} .fc-list b { display:block; font: 700 15px/1.3 var(--font-body-family, sans-serif); }
  #fc-home-{{ section.id }} .fc-list span { font: 400 13px/1.45 var(--font-body-family, sans-serif); color: rgba(255,255,255,.66); }
  #fc-home-{{ section.id }} .fc-pays { display:flex; flex-wrap:wrap; gap:10px; margin-top:18px; }
  #fc-home-{{ section.id }} .fc-pay { background: rgba(255,255,255,.08); border:1px solid var(--fc-line); border-radius:9px; padding:11px 15px; font:700 14px/1 var(--font-body-family, sans-serif); }

  /* ENVIO EXPRESS (banda destacada) */
  #fc-home-{{ section.id }} .fc-express { background: linear-gradient(120deg, var(--fc-navy) 0%, var(--fc-purple) 100%); color:#fff; padding: 68px 0; position:relative; overflow:hidden; }
  #fc-home-{{ section.id }} .fc-express::before { content:""; position:absolute; inset:0; background: radial-gradient(circle at 82% 26%, rgba(25,195,125,.30), transparent 44%); pointer-events:none; }
  #fc-home-{{ section.id }} .fc-express-inner { display:grid; grid-template-columns: 1.35fr .9fr; gap: 44px; align-items:center; position:relative; z-index:1; }
  #fc-home-{{ section.id }} .fc-express-tag { display:inline-flex; align-items:center; gap:8px; background: var(--fc-accent); color: var(--fc-darker); font:800 12px/1 var(--font-body-family, sans-serif); letter-spacing:.14em; text-transform:uppercase; padding:9px 15px; border-radius:99px; margin-bottom:18px; }
  #fc-home-{{ section.id }} .fc-express h2 { font-size: clamp(28px,3.7vw,46px); font-weight:800; margin:0 0 12px; line-height:1.06; }
  #fc-home-{{ section.id }} .fc-express h2 .hl { color: var(--fc-accent); }
  #fc-home-{{ section.id }} .fc-express-lead { color: rgba(255,255,255,.84); font:400 17px/1.55 var(--font-body-family, sans-serif); margin:0 0 8px; max-width: 50ch; }
  #fc-home-{{ section.id }} .fc-express-lead b { color:#fff; font-weight:800; }
  #fc-home-{{ section.id }} .fc-express-cities-label { display:block; font:700 12px/1 var(--font-body-family, sans-serif); letter-spacing:.1em; text-transform:uppercase; color: rgba(255,255,255,.55); margin: 22px 0 12px; }
  #fc-home-{{ section.id }} .fc-express-cities { display:flex; flex-wrap:wrap; gap:12px; }
  #fc-home-{{ section.id }} .fc-city { background: rgba(255,255,255,.07); border:1px solid rgba(255,255,255,.16); border-radius:13px; padding:13px 18px; min-width:118px; }
  #fc-home-{{ section.id }} .fc-city-name { display:block; font:700 17px/1 var(--font-body-family, sans-serif); }
  #fc-home-{{ section.id }} .fc-city-badge { display:block; font:800 11px/1 var(--font-body-family, sans-serif); letter-spacing:.1em; text-transform:uppercase; margin-top:6px; color: rgba(255,255,255,.55); }
  #fc-home-{{ section.id }} .fc-city.is-live { background: rgba(25,195,125,.16); border-color: var(--fc-accent); }
  #fc-home-{{ section.id }} .fc-city.is-live .fc-city-badge { color: var(--fc-accent); }
  #fc-home-{{ section.id }} .fc-express-note { color: rgba(255,255,255,.62); font:400 13.5px/1.5 var(--font-body-family, sans-serif); margin:16px 0 0; max-width: 52ch; }
  #fc-home-{{ section.id }} .fc-express-visual { display:flex; }
  #fc-home-{{ section.id }} .fc-express-highlights { width:100%; display:grid; gap:14px; }
  #fc-home-{{ section.id }} .fc-hl { display:flex; align-items:center; gap:16px; background: rgba(255,255,255,.07); border:1px solid rgba(255,255,255,.16); border-radius:16px; padding:18px 20px; }
  #fc-home-{{ section.id }} .fc-hl.is-accent { background: rgba(25,195,125,.14); border-color: rgba(25,195,125,.45); animation: fc-pulse 2.8s ease-in-out infinite; }
  #fc-home-{{ section.id }} .fc-hl-ic { flex:0 0 auto; width:54px; height:54px; border-radius:13px; display:grid; place-items:center; background: rgba(255,255,255,.10); }
  #fc-home-{{ section.id }} .fc-hl.is-accent .fc-hl-ic { background: rgba(25,195,125,.22); }
  #fc-home-{{ section.id }} .fc-hl-ic svg { width:27px; height:27px; color:#fff; }
  #fc-home-{{ section.id }} .fc-hl.is-accent .fc-hl-ic svg { color: var(--fc-accent); }
  #fc-home-{{ section.id }} .fc-hl b { display:block; font:800 18px/1.1 var(--font-body-family, sans-serif); }
  #fc-home-{{ section.id }} .fc-hl span { display:block; font:400 13.5px/1.35 var(--font-body-family, sans-serif); color: rgba(255,255,255,.72); margin-top:3px; }
  @keyframes fc-pulse { 0%,100%{ box-shadow: 0 0 0 0 rgba(25,195,125,.28); } 50%{ box-shadow: 0 0 0 16px rgba(25,195,125,0); } }

  /* PREGUNTAS Y RESPUESTAS */
  #fc-home-{{ section.id }} .fc-faq { background:#fff; padding: 82px 0; }
  #fc-home-{{ section.id }} .fc-faq h2 { color: var(--fc-navy); text-align:center; font-size: clamp(28px,3.4vw,42px); font-weight:800; }
  #fc-home-{{ section.id }} .fc-faq .fc-sub { text-align:center; color:#56607a; font:400 17px/1.5 var(--font-body-family, sans-serif); margin:0 auto 40px; max-width: 60ch; }
  #fc-home-{{ section.id }} .fc-faq-list { max-width: 840px; margin:0 auto; display:grid; gap:12px; }
  #fc-home-{{ section.id }} .fc-faq-item { border:1px solid #e7eaf2; border-radius:14px; background:#fff; overflow:hidden; transition: box-shadow .2s ease, border-color .2s ease; }
  #fc-home-{{ section.id }} .fc-faq-item[open] { border-color: var(--fc-purple); box-shadow: 0 10px 28px rgba(11,24,64,.08); }
  #fc-home-{{ section.id }} .fc-faq-item summary { list-style:none; cursor:pointer; padding: 20px 22px; display:flex; align-items:center; justify-content:space-between; gap:16px; color: var(--fc-navy); font:700 17px/1.35 var(--font-body-family, sans-serif); }
  #fc-home-{{ section.id }} .fc-faq-item summary::-webkit-details-marker { display:none; }
  #fc-home-{{ section.id }} .fc-faq-item summary::after { content:"+"; flex:0 0 auto; width:28px; height:28px; border-radius:50%; background: var(--fc-light); color: var(--fc-purple); display:grid; place-items:center; font:700 20px/1 var(--font-body-family, sans-serif); transition: transform .2s ease, background .2s ease, color .2s ease; }
  #fc-home-{{ section.id }} .fc-faq-item[open] summary::after { content:"\2212"; background: var(--fc-purple); color:#fff; }
  #fc-home-{{ section.id }} .fc-faq-item p { margin:0; padding: 0 22px 22px; color:#56607a; font:400 15px/1.6 var(--font-body-family, sans-serif); }

  /* NAP / CONTACTO KIOSCO */
  #fc-home-{{ section.id }} .fc-nap { background: var(--fc-light); padding: 80px 0; }
  #fc-home-{{ section.id }} .fc-nap-grid { display:grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items:stretch; }
  #fc-home-{{ section.id }} .fc-nap-tag { display:inline-block; font:800 12px/1 var(--font-body-family, sans-serif); letter-spacing:.16em; text-transform:uppercase; color: var(--fc-purple); margin-bottom:12px; }
  #fc-home-{{ section.id }} .fc-nap-info h2 { color: var(--fc-navy); font-size: clamp(26px,3vw,38px); font-weight:800; margin:0 0 10px; line-height:1.08; }
  #fc-home-{{ section.id }} .fc-nap-info > p { color:#56607a; font:400 16px/1.6 var(--font-body-family, sans-serif); margin:0 0 24px; max-width: 46ch; }
  #fc-home-{{ section.id }} .fc-nap-list { list-style:none; margin:0 0 28px; padding:0; display:grid; gap:16px; }
  #fc-home-{{ section.id }} .fc-nap-list li { display:flex; gap:14px; align-items:flex-start; }
  #fc-home-{{ section.id }} .fc-nap-list li > svg { flex:0 0 auto; width:22px; height:22px; color: var(--fc-purple); margin-top:2px; }
  #fc-home-{{ section.id }} .fc-nap-list b { display:block; color: var(--fc-navy); font:700 14px/1.3 var(--font-body-family, sans-serif); margin-bottom:3px; }
  #fc-home-{{ section.id }} .fc-nap-list span, #fc-home-{{ section.id }} .fc-nap-list a { display:block; color:#56607a; font:400 14.5px/1.5 var(--font-body-family, sans-serif); text-decoration:none; }
  #fc-home-{{ section.id }} .fc-nap-list a:hover { color: var(--fc-purple); }
  #fc-home-{{ section.id }} .fc-nap-actions { display:flex; flex-wrap:wrap; gap:12px; }
  #fc-home-{{ section.id }} .fc-nap-actions .fc-btn { padding: 14px 22px; font-size:15px; }
  #fc-home-{{ section.id }} .fc-btn--map { background: var(--fc-purple); color:#fff; }
  #fc-home-{{ section.id }} .fc-nap-map { border-radius: 20px; overflow:hidden; min-height: 360px; border:1px solid var(--fc-line); box-shadow: 0 14px 34px rgba(11,24,64,.10); }
  #fc-home-{{ section.id }} .fc-nap-map iframe { width:100%; height:100%; min-height:360px; border:0; display:block; }

  /* ===== RESPONSIVE / MOBILE ===== */
  @media (max-width: 990px) {
