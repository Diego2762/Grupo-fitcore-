{%- comment -%}
  Fitcore Store · Sección de inicio (B2C)
  Sección autónoma para la home: hero, beneficios, categorías,
  "¿Cómo comprar?", envíos, pagos y ubicación de la tienda.
  Pegar en: Online Store > Themes > Edit code > Sections > Add new > "fitcore-home"
  Luego añadirla a la plantilla de inicio (index) desde el editor de temas.
{%- endcomment -%}

{%- liquid
  assign wa = section.settings.whatsapp | default: '584246218863'
  assign wa_msg = section.settings.whatsapp_msg | default: 'Hola Fitcore Store, quiero hacer un pedido'
  assign wa_msg_enc = wa_msg | url_encode
-%}

<style>
  #fc-home-{{ section.id }} {
    --fc-navy: {{ section.settings.color_navy | default: '#0B1840' }};
    --fc-purple: {{ section.settings.color_purple | default: '#3B1F6B' }};
    --fc-dark: #111D3E;
    --fc-darker: #071631;
    --fc-light: #F6F7FA;
    --fc-accent: {{ section.settings.color_accent | default: '#19C37D' }};
    --fc-line: rgba(255,255,255,.12);
  }
  #fc-home-{{ section.id }} * { box-sizing: border-box; }
  #fc-home-{{ section.id }} .fc-wrap { max-width: 1300px; margin: 0 auto; padding: 0 22px; }
  #fc-home-{{ section.id }} .fc-eyebrow {
    display:inline-block; font: 700 13px/1 var(--font-body-family, sans-serif);
    letter-spacing:.18em; text-transform:uppercase; color: var(--fc-accent);
    margin-bottom: 14px;
  }
  #fc-home-{{ section.id }} h2.fc-h, #fc-home-{{ section.id }} h1.fc-h {
    font-family: var(--font-heading-family, sans-serif);
    line-height: 1.04; margin: 0 0 14px; letter-spacing: .01em;
  }

  /* HERO (oscuro con imagen de productos) */
  #fc-home-{{ section.id }} .fc-hero {
    background:
      linear-gradient(90deg, var(--fc-navy) 0%, rgba(11,24,64,.94) 30%, rgba(11,24,64,.55) 58%, rgba(7,22,49,.18) 100%),
      url('{{ "fitcore-hero-productos.jpg" | asset_url }}') no-repeat right center / cover,
      var(--fc-darker);
    color:#fff; padding: 84px 0 76px; position: relative; overflow: hidden;
    min-height: 540px; display:flex; align-items:center;
  }
  #fc-home-{{ section.id }} .fc-hero-photo { display: none; }
  #fc-home-{{ section.id }} .fc-hero .fc-wrap { max-width: 1720px; margin: 0 auto; width: 100%; padding-left: 32px; padding-right: 32px; }
  #fc-home-{{ section.id }} .fc-hero .fc-wrap > * { max-width: 540px; }
  #fc-home-{{ section.id }} .fc-hero h1 { font-size: clamp(34px, 5.4vw, 62px); font-weight: 800; max-width: 13ch; }
  #fc-home-{{ section.id }} .fc-hero p { font: 400 clamp(16px,1.4vw,20px)/1.55 var(--font-body-family, sans-serif); color: rgba(255,255,255,.82); max-width: 46ch; margin: 0 0 30px; }
  #fc-home-{{ section.id }} .fc-hero p .fc-hl-a { color:#fff; font-weight:600; }
  #fc-home-{{ section.id }} .fc-hero p .fc-hl-g { color:var(--fc-accent,#19C37D); font-weight:600; }
  #fc-home-{{ section.id }} .fc-hero .fc-hero-eyebrow { display:inline-flex; align-items:center; gap:8px; background:rgba(25,195,125,.14); border:1px solid rgba(25,195,125,.4); color:#7ff0bd; font:700 12.5px/1 var(--font-body-family, sans-serif); letter-spacing:.05em; text-transform:uppercase; padding:9px 15px; border-radius:999px; margin:0 0 20px; }
  #fc-home-{{ section.id }} .fc-hero .fc-hero-eyebrow svg { width:14px; height:14px; flex:none; }
  #fc-home-{{ section.id }} .fc-hero h1 .hl { color: var(--fc-accent); }
  #fc-home-{{ section.id }} .fc-hero .fc-hero-trust { display:flex; flex-wrap:wrap; gap:8px 20px; margin:26px 0 0; padding:0; list-style:none; }
  #fc-home-{{ section.id }} .fc-hero .fc-hero-trust li { display:flex; align-items:center; gap:8px; font:600 13.5px/1.3 var(--font-body-family, sans-serif); color:rgba(255,255,255,.8); }
  #fc-home-{{ section.id }} .fc-hero .fc-hero-trust svg { width:16px; height:16px; color: var(--fc-accent); flex:none; }
  #fc-home-{{ section.id }} .fc-cta-row { display:flex; flex-wrap:wrap; gap:14px; }
  #fc-home-{{ section.id }} .fc-btn {
    display:inline-flex; align-items:center; gap:9px; cursor:pointer;
    font: 700 16px/1 var(--font-body-family, sans-serif); text-decoration:none;
    padding: 16px 26px; border-radius: 10px; transition: transform .12s ease, filter .12s ease;
  }
  #fc-home-{{ section.id }} .fc-btn:hover { transform: translateY(-2px); }
  #fc-home-{{ section.id }} .fc-btn--primary { background:#fff; color: var(--fc-navy); }
  #fc-home-{{ section.id }} .fc-btn--wa { background:#25D366; color:#04231a; }
  #fc-home-{{ section.id }} .fc-btn--ghost { background: transparent; color:#fff; border:1.5px solid rgba(255,255,255,.28); }

  /* BENEFITS (oscuro) */
  #fc-home-{{ section.id }} .fc-bene { background: var(--fc-dark); color:#fff; padding: 26px 0; }
  #fc-home-{{ section.id }} .fc-bene-grid { display:grid; grid-template-columns: repeat(4,1fr); gap: 14px; }
  #fc-home-{{ section.id }} .fc-bene-item { display:flex; gap:12px; align-items:flex-start; }
  #fc-home-{{ section.id }} .fc-bene-item svg { flex:0 0 auto; width:26px; height:26px; color:#fff; opacity:.92; }
  #fc-home-{{ section.id }} .fc-bene-item b { display:block; font: 700 15px/1.2 var(--font-body-family, sans-serif); margin-bottom:3px; }
  #fc-home-{{ section.id }} .fc-bene-item span { font: 400 13px/1.4 var(--font-body-family, sans-serif); color: rgba(255,255,255,.7); }

  /* MARQUEE MARCAS */
  #fc-home-{{ section.id }} .fc-marq { background:#fff; padding: 30px 0 34px; border-bottom: 1px solid #e7eaf2; overflow: hidden; }
  #fc-home-{{ section.id }} .fc-marq-title { text-align:center; color:#8a93b5; font: 800 12px/1 var(--font-body-family, sans-serif); letter-spacing:.16em; text-transform:uppercase; margin:0 0 22px; }
  #fc-home-{{ section.id }} .fc-marq-mask { position:relative; width:100%;
    overflow-x:auto; overflow-y:hidden; cursor:grab; -webkit-overflow-scrolling:touch;
    scrollbar-width:none; -ms-overflow-style:none;
    -webkit-mask-image: linear-gradient(90deg, transparent 0, #000 8%, #000 92%, transparent 100%);
            mask-image: linear-gradient(90deg, transparent 0, #000 8%, #000 92%, transparent 100%); }
  #fc-home-{{ section.id }} .fc-marq-mask::-webkit-scrollbar { display:none; height:0; width:0; }
  #fc-home-{{ section.id }} .fc-marq-mask.is-grabbing { cursor:grabbing; }
  #fc-home-{{ section.id }} .fc-marq-track { display:flex; width:max-content; align-items:center; }
  #fc-home-{{ section.id }} .fc-marq-track img { height:40px; width:auto; max-width:150px; object-fit:contain; margin:0 38px; filter:grayscale(100%); opacity:.55; transition: filter .2s ease, opacity .2s ease; pointer-events:none; -webkit-user-drag:none; user-select:none; }
  #fc-home-{{ section.id }} .fc-marq-track img.fc-emblem { height:56px; }
  #fc-home-{{ section.id }} .fc-marq-link { display:inline-flex; align-items:center; text-decoration:none; cursor:inherit; }
  #fc-home-{{ section.id }} .fc-marq-link:hover img { filter:none; opacity:1; }

  /* MAS VENDIDOS */
  #fc-home-{{ section.id }} .fc-best { background:#fff; padding: 70px 0; border-bottom:1px solid #e7eaf2; }
  #fc-home-{{ section.id }} .fc-best-head { max-width: 760px; margin: 0 0 34px; }
  #fc-home-{{ section.id }} .fc-best-head h2 { color: var(--fc-navy); font-size: clamp(28px,3.4vw,42px); font-weight:800; margin:0; }
  #fc-home-{{ section.id }} .fc-best-head p { color:#56607a; font: 400 17px/1.5 var(--font-body-family, sans-serif); margin:12px 0 0; }
  #fc-home-{{ section.id }} .fc-best-grid { display:grid; grid-template-columns: repeat(4,1fr); gap: 18px; }
  #fc-home-{{ section.id }} .fc-pc { display:flex; flex-direction:column; background:#fff; border:1px solid #e7eaf2; border-radius:18px; overflow:hidden; text-decoration:none; transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease; }
  #fc-home-{{ section.id }} .fc-pc:hover { transform: translateY(-4px); box-shadow: 0 22px 46px rgba(11,24,64,.10); border-color:#d5dcf0; }
  #fc-home-{{ section.id }} .fc-pc-media { position:relative; aspect-ratio:1/1; background:#F6F7FA; display:grid; place-items:center; padding:10px; text-decoration:none; }
  #fc-home-{{ section.id }} .fc-pc-media img { width:auto; height:auto; max-width:100%; max-height:96%; object-fit:contain; mix-blend-mode:multiply; }
  #fc-home-{{ section.id }} .fc-pc-rank { position:absolute; top:12px; left:12px; display:inline-flex; align-items:center; gap:5px; background: var(--fc-accent); color: var(--fc-darker); font:800 10.5px/1 var(--font-body-family, sans-serif); letter-spacing:.08em; text-transform:uppercase; padding:6px 10px; border-radius:99px; }
  #fc-home-{{ section.id }} .fc-pc-rank svg { width:11px; height:11px; }
  #fc-home-{{ section.id }} .fc-pc-body { padding:16px 18px 20px; display:flex; flex-direction:column; flex:1; border-top:1px solid #e7eaf2; }
  #fc-home-{{ section.id }} .fc-pc-vendor { color: var(--fc-purple); font:700 11px/1 var(--font-body-family, sans-serif); letter-spacing:.09em; text-transform:uppercase; margin:0 0 7px; }
  #fc-home-{{ section.id }} .fc-pc-title { color: var(--fc-navy); font:600 14.5px/1.35 var(--font-body-family, sans-serif); margin:0 0 14px; text-decoration:none; display:-webkit-box; -webkit-line-clamp:2; -webkit-box-orient:vertical; overflow:hidden; min-height:40px; transition: color .18s ease; }
  #fc-home-{{ section.id }} .fc-pc-title:hover { color: var(--fc-purple); }
  #fc-home-{{ section.id }} .fc-pc-foot { margin-top:auto; display:flex; align-items:center; justify-content:space-between; gap:10px; }
  #fc-home-{{ section.id }} .fc-pc-prices { display:flex; flex-direction:column; gap:4px; }
  #fc-home-{{ section.id }} .fc-pc-price { color: var(--fc-navy); font:800 17px/1 var(--font-body-family, sans-serif); display:flex; align-items:baseline; gap:6px; }
  #fc-home-{{ section.id }} .fc-pc-price--divisa { color:#12994f; }
  #fc-home-{{ section.id }} .fc-pc-cur { font:700 10px/1 var(--font-body-family, sans-serif); letter-spacing:.06em; text-transform:uppercase; opacity:.6; }
  #fc-home-{{ section.id }} .fc-pc-price--divisa .fc-pc-cur { color:#12994f; opacity:.85; }
  #fc-home-{{ section.id }} .fc-pc-form { margin:0; }
  #fc-home-{{ section.id }} .fc-pc-cart { position:relative; display:inline-flex; align-items:center; justify-content:center; width:44px; height:44px; background: var(--fc-navy); color:#fff; border:0; border-radius:12px; cursor:pointer; text-decoration:none; transition: background .18s ease, color .18s ease, transform .18s ease; }
  #fc-home-{{ section.id }} .fc-pc-cart svg { width:20px; height:20px; }
  #fc-home-{{ section.id }} .fc-pc-cart:hover { background: var(--fc-accent); color: var(--fc-darker); transform: translateY(-2px); }
  #fc-home-{{ section.id }} .fc-pc-cart.is-added { background: var(--fc-accent); color: var(--fc-darker); }
  #fc-home-{{ section.id }} .fc-pc-cart--out { background: var(--fc-line); color: var(--fc-navy); }
  /* Estado de carga: spinner instantaneo al tocar mientras responde la red */
  #fc-home-{{ section.id }} .fc-pc-cart.is-loading { background: var(--fc-navy); color:#fff; pointer-events:none; transform:none; }
  #fc-home-{{ section.id }} .fc-pc-cart.is-loading svg { opacity:0; }
  #fc-home-{{ section.id }} .fc-pc-cart.is-loading::after { content:""; position:absolute; width:18px; height:18px; border:2px solid currentColor; border-top-color:transparent; border-radius:50%; animation:fc-cart-spin .6s linear infinite; }
  @keyframes fc-cart-spin { to { transform:rotate(360deg); } }
  #fc-home-{{ section.id }} .fc-goal { padding: 56px 0; }
  #fc-home-{{ section.id }} .fc-goal--alt { background: var(--fc-light); }
  #fc-home-{{ section.id }} .fc-best-foot { text-align:center; margin-top: 36px; }
  #fc-home-{{ section.id }} .fc-best-all { display:inline-flex; align-items:center; gap:8px; background: var(--fc-navy); color:#fff; text-decoration:none; font:700 15px/1 var(--font-body-family, sans-serif); padding:15px 26px; border-radius:11px; transition: transform .18s ease, background .18s ease; }
  #fc-home-{{ section.id }} .fc-best-all:hover { transform: translateY(-2px); background: var(--fc-purple); }
  #fc-home-{{ section.id }} .fc-best-all svg { width:17px; height:17px; }
  /* Ajuste puntual: la foto de GHOST Legend llena todo el cuadro; la reducimos para igualar al resto */
  #fc-home-{{ section.id }} .fc-pc[data-handle="ghost-legend-v4-pre-entreno-blue-raspberry-30-servicios"] .fc-pc-media img { max-width:80%; max-height:80%; }

  /* ===== CARRUSEL DESTACADOS POR CATEGORIA ===== */
  #fc-home-{{ section.id }} .fc-catrot { margin: 6px 0 46px; position: relative; }
  #fc-home-{{ section.id }} .fc-catrot-head { display:flex; align-items:baseline; gap:12px; margin:0 0 18px; }
  #fc-home-{{ section.id }} .fc-catrot-eyebrow { color: var(--fc-purple); font:700 12px/1 var(--font-body-family, sans-serif); letter-spacing:.14em; text-transform:uppercase; }
  #fc-home-{{ section.id }} .fc-catrot-label { color: var(--fc-navy); font:800 18px/1 var(--font-body-family, sans-serif); }
  #fc-home-{{ section.id }} .fc-catrot-body { display:flex; align-items:stretch; gap:14px; }
  #fc-home-{{ section.id }} .fc-catrot-arrow { flex:0 0 auto; align-self:center; width:44px; height:44px; border-radius:50%; border:1px solid #e7eaf2; background:#fff; color: var(--fc-navy); display:grid; place-items:center; cursor:pointer; transition: background .18s ease, color .18s ease, transform .18s ease, border-color .18s ease; }
  #fc-home-{{ section.id }} .fc-catrot-arrow:hover { background: var(--fc-navy); color:#fff; border-color: var(--fc-navy); transform: translateY(-2px); }
  #fc-home-{{ section.id }} .fc-catrot-arrow svg { width:20px; height:20px; }
  #fc-home-{{ section.id }} .fc-catrot-slides { flex:1 1 auto; min-width:0; }
  #fc-home-{{ section.id }} .fc-catrot-slide { display:none; }
  #fc-home-{{ section.id }} .fc-catrot-slide.is-active { display:block; animation: fc-catfade .4s ease; }
  #fc-home-{{ section.id }} .fc-catrot-grid { display:grid; grid-template-columns: repeat(4,1fr); gap:18px; }
  @keyframes fc-catfade { from { opacity:0; transform: translateY(8px); } to { opacity:1; transform:none; } }
  @media (prefers-reduced-motion: reduce) { #fc-home-{{ section.id }} .fc-catrot-slide.is-active { animation:none; } }

  /* ===== FRANJA ENTREGA / STATS ===== */
  #fc-home-{{ section.id }} .fc-stats { background:#fff; padding: 58px 0; border-bottom:1px solid #e7eaf2; text-align:center; }
  #fc-home-{{ section.id }} .fc-stats h2 { color: var(--fc-navy); font-size: clamp(23px,2.9vw,35px); font-weight:800; letter-spacing:-.015em; line-height:1.15; max-width: 840px; margin: 0 auto 40px; }
  #fc-home-{{ section.id }} .fc-stats-row { display:flex; justify-content:center; align-items:center; gap: clamp(30px,6vw,88px); flex-wrap:wrap; }
  #fc-home-{{ section.id }} .fc-stat { display:flex; align-items:center; gap:16px; text-align:left; }
  #fc-home-{{ section.id }} .fc-stat-ico { width:58px; height:58px; flex:0 0 58px; border-radius:16px; display:flex; align-items:center; justify-content:center; background: rgba(59,31,107,.08); color: var(--fc-purple); }
  #fc-home-{{ section.id }} .fc-stat-ico svg { width:30px; height:30px; }
  /* Animaciones de la sección de envíos */
  #fc-home-{{ section.id }} .fc-stat-ico--bolt { background: rgba(25,195,125,.12); color: var(--fc-green, #19C37D); }
  #fc-home-{{ section.id }} .fc-stat-ico--bolt svg { animation: fc-bolt 2.6s ease-in-out infinite; transform-origin:center; }
  #fc-home-{{ section.id }} .fc-stat-ico--truck svg { animation: fc-truck 2.8s ease-in-out infinite; }
  @keyframes fc-bolt {
    0%, 62%, 100% { transform: scale(1); opacity:1; filter:none; }
    68% { transform: scale(1.18); opacity:.55; }
    72% { transform: scale(.94); opacity:1; }
    78% { transform: scale(1.12); opacity:.7; }
    84% { transform: scale(1); opacity:1; }
  }
  @keyframes fc-truck {
    0%, 100% { transform: translateX(-3px); }
    45% { transform: translateX(3px); }
    50% { transform: translateX(3px) translateY(-.5px); }
    90% { transform: translateX(-3px); }
  }
  @media (prefers-reduced-motion: reduce) {
    #fc-home-{{ section.id }} .fc-stat-ico--bolt svg,
    #fc-home-{{ section.id }} .fc-stat-ico--truck svg { animation: none; }
  }
  #fc-home-{{ section.id }} .fc-stat-n { display:block; color: var(--fc-navy); font-size: clamp(25px,2.9vw,33px); font-weight:800; line-height:1; letter-spacing:-.01em; }
  #fc-home-{{ section.id }} .fc-stat-l { display:block; color:#56607a; font: 500 14px/1.35 var(--font-body-family, sans-serif); margin-top:6px; }

  /* CATEGORIES */
  #fc-home-{{ section.id }} .fc-cats { background: var(--fc-light); padding: 70px 0; }
  #fc-home-{{ section.id }} .fc-cats h2 { color: var(--fc-navy); font-size: clamp(28px,3.4vw,42px); font-weight:800; }
  #fc-home-{{ section.id }} .fc-cats .fc-sub { color:#56607a; font: 400 17px/1.5 var(--font-body-family, sans-serif); margin:0 0 34px; }
  #fc-home-{{ section.id }} .fc-cat-grid { display:grid; grid-template-columns: repeat(3,1fr); gap: 18px; }
  #fc-home-{{ section.id }} .fc-cat {
    display:flex; flex-direction:column; justify-content:flex-end; min-height: 168px;
    padding: 22px; border-radius: 16px; text-decoration:none; color:#fff; position:relative; overflow:hidden;
    background: linear-gradient(150deg, var(--fc-navy), var(--fc-purple));
    transition: transform .14s ease, box-shadow .14s ease;
  }
  #fc-home-{{ section.id }} .fc-cat-bg {
    position:absolute; inset:0; width:100%; height:100%; object-fit:cover; z-index:0;
    transition: transform .3s ease;
  }
  #fc-home-{{ section.id }} .fc-cat::after {
    content:""; position:absolute; inset:0; z-index:1;
    background: linear-gradient(180deg, rgba(7,22,49,.10) 0%, rgba(7,22,49,.80) 100%);
  }
  #fc-home-{{ section.id }} .fc-cat.is-plain::after { background: transparent; }
  #fc-home-{{ section.id }} .fc-cat > span,
  #fc-home-{{ section.id }} .fc-cat > h3 { position:relative; z-index:2; }
  #fc-home-{{ section.id }} .fc-cat:hover { transform: translateY(-4px); box-shadow: 0 16px 34px rgba(11,24,64,.22); }
  #fc-home-{{ section.id }} .fc-cat:hover .fc-cat-bg { transform: scale(1.05); }
  #fc-home-{{ section.id }} .fc-cat h3 { font-family: var(--font-heading-family, sans-serif); font-size: 24px; font-weight:800; margin:0 0 4px; text-shadow: 0 1px 12px rgba(7,22,49,.45); }
  #fc-home-{{ section.id }} .fc-cat span { font: 600 13px/1 var(--font-body-family, sans-serif); color: rgba(255,255,255,.72); letter-spacing:.08em; text-transform:uppercase; }

  /* COMO COMPRAR */
  #fc-home-{{ section.id }} .fc-steps { background:#fff; padding: 80px 0; }
  #fc-home-{{ section.id }} .fc-steps h2 { color: var(--fc-navy); text-align:center; font-size: clamp(28px,3.4vw,42px); font-weight:800; }
  #fc-home-{{ section.id }} .fc-steps .fc-sub { text-align:center; color:#56607a; font: 400 17px/1.5 var(--font-body-family, sans-serif); margin:0 auto 52px; max-width: 60ch; }
  #fc-home-{{ section.id }} .fc-steps-grid { display:grid; grid-template-columns: repeat(4,1fr); gap: 22px; position:relative; }
  /* línea conectora entre pasos (desktop) */
  #fc-home-{{ section.id }} .fc-steps-grid::before {
    content:""; position:absolute; top: 46px; left: 12.5%; right: 12.5%; height: 2px; z-index:0;
    background: repeating-linear-gradient(90deg, #d7ddf0 0 8px, transparent 8px 16px);
  }
  #fc-home-{{ section.id }} .fc-step {
    text-align:center; padding: 30px 20px 26px; border:1px solid #e7eaf2; border-radius:18px; position:relative; z-index:1;
    background:#fff; transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
  }
  #fc-home-{{ section.id }} .fc-step:hover { transform: translateY(-6px); box-shadow: 0 18px 40px rgba(11,24,64,.12); border-color: transparent; }
  #fc-home-{{ section.id }} .fc-step-num {
    width:70px; height:70px; border-radius:50%; margin:0 auto 18px; display:grid; place-items:center; position:relative;
    background: linear-gradient(150deg, var(--fc-navy), var(--fc-purple)); color:#fff;
    box-shadow: 0 10px 22px rgba(59,31,107,.28);
  }
  #fc-home-{{ section.id }} .fc-step-num svg { width:30px; height:30px; }
  #fc-home-{{ section.id }} .fc-step-num::after {
    content: attr(data-n); position:absolute; top:-6px; right:-6px;
    width:26px; height:26px; border-radius:50%; display:grid; place-items:center;
    background: var(--fc-accent); color: var(--fc-darker); border:3px solid #fff;
    font: 800 13px/1 var(--font-heading-family, sans-serif);
  }
  #fc-home-{{ section.id }} .fc-step:hover .fc-step-num { transform: scale(1.06); transition: transform .2s ease; }
  #fc-home-{{ section.id }} .fc-step h3 { display:block; color: var(--fc-navy); font: 700 18px/1.25 var(--font-body-family, sans-serif); margin:0 0 8px; }
  #fc-home-{{ section.id }} .fc-step p { color:#56607a; font: 400 14px/1.55 var(--font-body-family, sans-serif); margin:0; }

  /* ===== ANIMACIONES / SCROLL REVEAL ===== */
  #fc-home-{{ section.id }} .fc-reveal { opacity: 0; transform: translateY(26px); transition: opacity .7s cubic-bezier(.2,.7,.2,1), transform .7s cubic-bezier(.2,.7,.2,1); transition-delay: var(--fc-d, 0ms); will-change: opacity, transform; }
  #fc-home-{{ section.id }} .fc-reveal.is-in { opacity: 1; transform: none; }
  /* Tarjetas interactivas: reveal solo con fade para que el hover siga siendo ágil */
  #fc-home-{{ section.id }} .fc-cat.fc-reveal { transform: none; transition: opacity .6s ease var(--fc-d,0ms), transform .14s ease, box-shadow .14s ease; }
  #fc-home-{{ section.id }} .fc-step.fc-reveal { transform: none; transition: opacity .6s ease var(--fc-d,0ms), transform .2s ease, box-shadow .2s ease, border-color .2s ease; }
  #fc-home-{{ section.id }} .fc-cat.fc-reveal.is-in, #fc-home-{{ section.id }} .fc-step.fc-reveal.is-in { transform: none; }
  #fc-home-{{ section.id }} .fc-hero .fc-hero-eyebrow,
  #fc-home-{{ section.id }} .fc-hero h1.fc-h,
  #fc-home-{{ section.id }} .fc-hero p,
  #fc-home-{{ section.id }} .fc-hero .fc-cta-row,
  #fc-home-{{ section.id }} .fc-hero .fc-hero-trust { opacity: 0; animation: fc-hero-in .8s cubic-bezier(.2,.7,.2,1) forwards; }
  #fc-home-{{ section.id }} .fc-hero .fc-hero-eyebrow { animation-delay: 0s; }
  #fc-home-{{ section.id }} .fc-hero h1.fc-h { animation-delay: .12s; }
  #fc-home-{{ section.id }} .fc-hero p { animation-delay: .26s; }
  #fc-home-{{ section.id }} .fc-hero .fc-cta-row { animation-delay: .4s; }
  #fc-home-{{ section.id }} .fc-hero .fc-hero-trust { animation-delay: .54s; }
  @keyframes fc-hero-in { from { opacity:0; transform: translateY(22px); } to { opacity:1; transform:none; } }
  @media (prefers-reduced-motion: reduce) {
    #fc-home-{{ section.id }} .fc-reveal { opacity:1 !important; transform:none !important; transition:none !important; }
    #fc-home-{{ section.id }} .fc-hero .fc-hero-eyebrow,
    #fc-home-{{ section.id }} .fc-hero h1.fc-h,
    #fc-home-{{ section.id }} .fc-hero p,
    #fc-home-{{ section.id }} .fc-hero .fc-cta-row,
    #fc-home-{{ section.id }} .fc-hero .fc-hero-trust { opacity:1 !important; animation:none !important; }
    #fc-home-{{ section.id }} .fc-marq-track { animation:none !important; }
  }

  /* ENVIOS + PAGOS */
  #fc-home-{{ section.id }} .fc-info { background: var(--fc-navy); color:#fff; padding: 70px 0; }
  #fc-home-{{ section.id }} .fc-info-cols { display:grid; grid-template-columns: 1fr 1fr; gap: 46px; }
  #fc-home-{{ section.id }} .fc-info h2 { font-size: clamp(24px,2.6vw,32px); font-weight:800; }
  #fc-home-{{ section.id }} .fc-list { list-style:none; margin:18px 0 0; padding:0; }
  #fc-home-{{ section.id }} .fc-list li { display:flex; gap:13px; padding:13px 0; border-bottom:1px solid var(--fc-line); }
  #fc-home-{{ section.id }} .fc-list li svg { flex:0 0 auto; width:22px; height:22px; color:#fff; opacity:.9; margin-top:2px; }
  #fc-home-{{ section.id }} .fc-list b { display:block; font: 700 15px/1.3 var(--font-body-family, sans-serif); }
  #fc-home-{{ section.id }} .fc-list span { font: 400 13px/1.45 var(--font-body-family, sans-serif); color: rgba(255,255,255,.66); }
  #fc-home-{{ section.id }} .fc-pays { display:flex; flex-wrap:wrap; gap:10px; margin-top:18px; }
  #fc-home-{{ section.id }} .fc-pay { background: rgba(255,255,255,.08); border:1px solid var(--fc-line); border-radius:9px; padding:11px 15px; font:700 14px/1 var(--font-body-family, sans-serif); }

  /* PREGUNTAS Y RESPUESTAS */
  #fc-home-{{ section.id }} .fc-faq { background:#fff; padding: 82px 0; }
  #fc-home-{{ section.id }} .fc-faq h2 { color: var(--fc-navy); text-align:center; font-size: clamp(28px,3.4vw,42px); font-weight:800; }
  #fc-home-{{ section.id }} .fc-faq .fc-sub { text-align:center; color:#56607a; font:400 17px/1.5 var(--font-body-family, sans-serif); margin:0 auto 40px; max-width: 60ch; }
  #fc-home-{{ section.id }} .fc-faq-list { max-width: 840px; margin:0 auto; display:grid; gap:12px; }
  #fc-home-{{ section.id }} .fc-faq-item { border:1px solid #e7eaf2; border-radius:14px; background:#fff; overflow:hidden; transition: box-shadow .2s ease, border-color .2s ease; }
  #fc-home-{{ section.id }} .fc-faq-item[open] { border-color: var(--fc-purple); box-shadow: 0 10px 28px rgba(11,24,64,.08); }
  #fc-home-{{ section.id }} .fc-faq-item summary { list-style:none; cursor:pointer; padding: 20px 22px; display:flex; align-items:center; justify-content:space-between; gap:16px; color: var(--fc-navy); font:700 17px/1.35 var(--font-body-family, sans-serif); }
  #fc-home-{{ section.id }} .fc-faq-item summary::-webkit-details-marker { display:none; }
  #fc-home-{{ section.id }} .fc-faq-item summary::after { content:"+"; flex:0 0 auto; width:28px; height:28px; border-radius:50%; background: var(--fc-light); color: var(--fc-purple); display:grid; place-items:center; font:700 20px/1 var(--font-body-family, sans-serif); transition: transform .2s ease, background .2s ease, color .2s ease; }
  #fc-home-{{ section.id }} .fc-faq-item[open] summary::after { content:"\2212"; background: var(--fc-purple); color:#fff; }
  #fc-home-{{ section.id }} .fc-faq-item p { margin:0; padding: 0 22px 22px; color:#56607a; font:400 15px/1.6 var(--font-body-family, sans-serif); }

  /* NAP / CONTACTO KIOSCO */
  #fc-home-{{ section.id }} .fc-nap { background: var(--fc-light); padding: 80px 0; }
  #fc-home-{{ section.id }} .fc-nap-grid { display:grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items:stretch; }
  #fc-home-{{ section.id }} .fc-nap-tag { display:inline-block; font:800 12px/1 var(--font-body-family, sans-serif); letter-spacing:.16em; text-transform:uppercase; color: var(--fc-purple); margin-bottom:12px; }
  #fc-home-{{ section.id }} .fc-nap-info h2 { color: var(--fc-navy); font-size: clamp(26px,3vw,38px); font-weight:800; margin:0 0 10px; line-height:1.08; }
  #fc-home-{{ section.id }} .fc-nap-info > p { color:#56607a; font:400 16px/1.6 var(--font-body-family, sans-serif); margin:0 0 24px; max-width: 46ch; }
  #fc-home-{{ section.id }} .fc-nap-list { list-style:none; margin:0 0 28px; padding:0; display:grid; gap:16px; }
  #fc-home-{{ section.id }} .fc-nap-list li { display:flex; gap:14px; align-items:flex-start; }
  #fc-home-{{ section.id }} .fc-nap-list li > svg { flex:0 0 auto; width:22px; height:22px; color: var(--fc-purple); margin-top:2px; }
  #fc-home-{{ section.id }} .fc-nap-list b { display:block; color: var(--fc-navy); font:700 14px/1.3 var(--font-body-family, sans-serif); margin-bottom:3px; }
  #fc-home-{{ section.id }} .fc-nap-list span, #fc-home-{{ section.id }} .fc-nap-list a { display:block; color:#56607a; font:400 14.5px/1.5 var(--font-body-family, sans-serif); text-decoration:none; }
  #fc-home-{{ section.id }} .fc-nap-list a:hover { color: var(--fc-purple); }
  #fc-home-{{ section.id }} .fc-nap-actions { display:flex; flex-wrap:wrap; gap:12px; }
  #fc-home-{{ section.id }} .fc-nap-actions .fc-btn { padding: 14px 22px; font-size:15px; }
  #fc-home-{{ section.id }} .fc-btn--map { background: var(--fc-purple); color:#fff; }
  #fc-home-{{ section.id }} .fc-nap-map { border-radius: 20px; overflow:hidden; min-height: 360px; border:1px solid var(--fc-line); box-shadow: 0 14px 34px rgba(11,24,64,.10); }
  #fc-home-{{ section.id }} .fc-nap-map iframe { width:100%; height:100%; min-height:360px; border:0; display:block; }

  /* ===== RESPONSIVE / MOBILE ===== */
  @media (max-width: 990px) {
    #fc-home-{{ section.id }} .fc-bene-grid { grid-template-columns: repeat(2,1fr); gap:20px; }
    #fc-home-{{ section.id }} .fc-cat-grid { grid-template-columns: repeat(2,1fr); }
    #fc-home-{{ section.id }} .fc-best-grid { grid-template-columns: repeat(2,1fr); }
    #fc-home-{{ section.id }} .fc-steps-grid { grid-template-columns: repeat(2,1fr); }
    #fc-home-{{ section.id }} .fc-steps-grid::before { display:none; }
    #fc-home-{{ section.id }} .fc-info-cols { grid-template-columns: 1fr; gap:40px; }
    #fc-home-{{ section.id }} .fc-nap-grid { grid-template-columns: 1fr; gap:30px; }
    #fc-home-{{ section.id }} .fc-nap-map { min-height: 300px; order: 2; }
    #fc-home-{{ section.id }} .fc-nap-map iframe { min-height: 300px; }
  }

  /* Tablet / teléfono grande: aire vertical más compacto */
  @media (max-width: 749px) {
    #fc-home-{{ section.id }} .fc-wrap { padding: 0 18px; }
    #fc-home-{{ section.id }} .fc-marq-track img { margin:0 26px; }
    #fc-home-{{ section.id }} .fc-cat--hide-mobile { display:none; }
    #fc-home-{{ section.id }} .fc-stats { padding: 42px 0; }
    #fc-home-{{ section.id }} .fc-stats h2 { margin-bottom: 30px; }
    #fc-home-{{ section.id }} .fc-stat--hide-mobile { display:none; }
    #fc-home-{{ section.id }} .fc-stats-row { flex-direction:row; flex-wrap:nowrap; align-items:center; justify-content:center; gap:20px; }
    #fc-home-{{ section.id }} .fc-stat { gap:11px; }
    #fc-home-{{ section.id }} .fc-stat-ico { width:46px; height:46px; flex-basis:46px; border-radius:13px; }
    #fc-home-{{ section.id }} .fc-stat-ico svg { width:25px; height:25px; }
    #fc-home-{{ section.id }} .fc-stat-n { font-size:20px; }
    #fc-home-{{ section.id }} .fc-stat-l { font-size:11.5px; margin-top:4px; }
    #fc-home-{{ section.id }} .fc-cat-bg { object-position: 72% center; }
    #fc-home-{{ section.id }} .fc-hero {
      min-height: 0; padding: 0 0 44px; align-items: flex-start;
      background:
        linear-gradient(180deg, var(--fc-navy) 0%, #0c1738 55%, var(--fc-darker) 100%),
        var(--fc-darker);
    }
    #fc-home-{{ section.id }} .fc-hero .fc-wrap { display: flex; flex-direction: column; }
    #fc-home-{{ section.id }} .fc-hero .fc-wrap .fc-hero-photo {
      order: -1; display: block; width: calc(100% + 36px); max-width: calc(100% + 36px); height: auto;
      margin: 0 -18px 22px; border-radius: 0;
      -webkit-mask-image: linear-gradient(180deg, #000 80%, transparent 100%);
      mask-image: linear-gradient(180deg, #000 80%, transparent 100%);
    }
    #fc-home-{{ section.id }} .fc-hero .fc-wrap { padding-left: 18px; padding-right: 18px; }
    #fc-home-{{ section.id }} .fc-hero .fc-wrap > * { max-width: 100%; }
    #fc-home-{{ section.id }} .fc-hero p { max-width: 100%; }
    #fc-home-{{ section.id }} .fc-cats,
    #fc-home-{{ section.id }} .fc-steps,
    #fc-home-{{ section.id }} .fc-info,
    #fc-home-{{ section.id }} .fc-faq,
    #fc-home-{{ section.id }} .fc-nap { padding: 52px 0; }
    #fc-home-{{ section.id }} .fc-steps .fc-sub,
    #fc-home-{{ section.id }} .fc-faq .fc-sub { margin-bottom: 32px; }
  }

  /* Teléfono: una sola columna, botones y tarjetas a lo ancho */
  @media (max-width: 560px) {
    #fc-home-{{ section.id }} .fc-cat-grid { grid-template-columns: repeat(2,1fr); gap: 12px; }
    #fc-home-{{ section.id }} .fc-cat h3 { font-size: 18px; }
    #fc-home-{{ section.id }} .fc-cat span { font-size: 11px; }
    #fc-home-{{ section.id }} .fc-best-grid { gap: 12px; }
    /* Carrusel por categoría en móvil: 2 productos, flechas más compactas */
    #fc-home-{{ section.id }} .fc-catrot-grid { grid-template-columns: repeat(2,1fr); gap: 12px; }
    #fc-home-{{ section.id }} .fc-catrot-slide .fc-pc:nth-child(n+3) { display:none; }
    #fc-home-{{ section.id }} .fc-catrot-label { font-size:16px; }
    /* Movil: las flechas salen de la fila y suben a la esquina superior derecha,
       asi las 2 tarjetas usan todo el ancho y quedan igual que el resto del home */
    #fc-home-{{ section.id }} .fc-catrot-head { min-height: 34px; padding-right: 74px; }
    #fc-home-{{ section.id }} .fc-catrot-body { gap: 0; }
    #fc-home-{{ section.id }} .fc-catrot-arrow { position: absolute; top: -4px; width: 34px; height: 34px; }
    #fc-home-{{ section.id }} .fc-catrot-arrow svg { width: 16px; height: 16px; }
    #fc-home-{{ section.id }} .fc-catrot-arrow[data-catrot-prev] { right: 40px; }
    #fc-home-{{ section.id }} .fc-catrot-arrow[data-catrot-next] { right: 0; }
    #fc-home-{{ section.id }} .fc-pc-body { padding: 14px; }
    #fc-home-{{ section.id }} .fc-pc-title { font-size: 13.5px; min-height: 38px; }
    #fc-home-{{ section.id }} .fc-pc-price { font-size: 15px; }
    #fc-home-{{ section.id }} .fc-pc-cta { padding: 10px 12px; font-size: 12px; }
    #fc-home-{{ section.id }} .fc-steps-grid { grid-template-columns: 1fr; }
    #fc-home-{{ section.id }} .fc-bene-grid { grid-template-columns: 1fr; }
    #fc-home-{{ section.id }} .fc-cat { min-height: 128px; }
    #fc-home-{{ section.id }} .fc-cat h3 { font-size: 17px; }
    #fc-home-{{ section.id }} .fc-cta-row .fc-btn { flex: 1 1 100%; justify-content: center; }
    #fc-home-{{ section.id }} .fc-nap-actions .fc-btn { flex: 1 1 100%; justify-content: center; }
    #fc-home-{{ section.id }} .fc-pay { flex: 1 1 calc(50% - 5px); text-align: center; }
    #fc-home-{{ section.id }} .fc-faq-item summary { font-size: 16px; padding: 17px 18px; }
    #fc-home-{{ section.id }} .fc-faq-item p { padding: 0 18px 18px; }
  }
</style>

<div id="fc-home-{{ section.id }}">

  {%- comment -%} ===== HERO ===== {%- endcomment -%}
  <section class="fc-hero">
    <div class="fc-wrap">
      {%- if section.settings.eyebrow != blank -%}
      <span class="fc-hero-eyebrow">
        <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.9 6.26L22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l7.1-1.01L12 2z"/></svg>
        {{ section.settings.eyebrow }}
      </span>
      {%- endif -%}
      <h1 class="fc-h">{{ section.settings.hero_title | default: 'La tienda de suplementos que el interior del país estaba esperando' }}</h1>
      <p>{{ section.settings.hero_text | default: '<span class="fc-hl-g">Marcas Top Mundiales 100% originales</span>, a precios irresistibles sin que tengas que viajar o importar tú mismo. Compra online en minutos y recíbela <span class="fc-hl-a">el mismo día en Trujillo</span> o en todo el país <span class="fc-hl-a">en 1 a 2 días</span>.' }}</p>
      <img class="fc-hero-photo" src="{{ 'fitcore-hero-mobile.jpg' | asset_url }}" alt="Suplementos originales en Fitcore Store" loading="eager" fetchpriority="high" decoding="async" width="766" height="550">
      <div class="fc-cta-row">
        <a class="fc-btn fc-btn--primary" href="{{ section.settings.hero_cta_url | default: '/collections/all' }}">
          {{ section.settings.hero_cta_label | default: 'Comprar ahora' }}
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14"/><path d="M13 6l6 6-6 6"/></svg>
        </a>
      </div>
    </div>
  </section>

  {%- comment -%} ===== BENEFICIOS ===== {%- endcomment -%}
  <section class="fc-bene">
    <div class="fc-wrap fc-bene-grid">
      <div class="fc-bene-item fc-reveal" style="--fc-d:0ms">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"/><path d="M12 2l8 4v6c0 5-3.4 8.5-8 10-4.6-1.5-8-5-8-10V6l8-4z"/></svg>
        <div><b>100% originales</b><span>Importados directo desde EE.UU.</span></div>
      </div>
      <div class="fc-bene-item fc-reveal" style="--fc-d:90ms">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M1 3h15v13H1z"/><path d="M16 8h4l3 3v5h-7z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/></svg>
        <div><b>Entrega rápida</b><span>Mismo día en ciudades con tienda</span></div>
      </div>
      <div class="fc-bene-item fc-reveal" style="--fc-d:180ms">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M2 10h20"/></svg>
        <div><b>Pagas como prefieras</b><span>Zelle, USDT, Pago Móvil, efectivo</span></div>
      </div>
      <div class="fc-bene-item fc-reveal" style="--fc-d:270ms">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 10c0 7-9 12-9 12s-9-5-9-12a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/></svg>
        <div><b>Tienda física</b><span>CC Plaza, Valera</span></div>
      </div>
    </div>
  </section>

  {%- comment -%} ===== MARQUEE MARCAS ===== {%- endcomment -%}
  <section class="fc-marq">
    <p class="fc-marq-title">{{ section.settings.marq_title | default: 'Las marcas que encuentras en Fitcore Store' }}</p>
    <div class="fc-marq-mask">
      <div class="fc-marq-track">
        {%- assign brand_pairs = "brand-optimum-nutrition.png|Optimum Nutrition,brand-dymatize.png|Dymatize,brand-muscletech.png|MuscleTech,brand-c4-energy.png|C4,brand-xtend.png|XTEND|/collections/aminoacidos,brand-forfit.png|Forfit,brand-ghost.png|Ghost,brand-bsn.png|BSN,brand-nutrex.png|Nutrex,brand-natures-bounty.png|Nature's Bounty" | split: ',' -%}
        {%- for i in (1..2) -%}
          {%- for pair in brand_pairs -%}
            {%- assign pp = pair | split: '|' -%}
            {%- assign logo = pp[0] -%}
            {%- assign vend = pp[1] -%}
            {%- assign base = pp[2] | default: routes.all_products_collection_url -%}
            {%- assign logo_cls = '' -%}
            {%- if logo contains 'brand-bsn' -%}{%- assign logo_cls = 'fc-emblem' -%}{%- endif -%}
            <a class="fc-marq-link" href="{{ base }}?marca={{ vend | url_encode }}" aria-label="Ver productos {{ vend | escape }}">
              <img class="{{ logo_cls }}" src="{{ logo | asset_url }}" alt="{{ vend | escape }}" loading="lazy">
            </a>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  {%- comment -%} ===== MAS VENDIDOS ===== {%- endcomment -%}
  <section class="fc-best">
    <div class="fc-wrap">
      <div class="fc-best-head fc-reveal">
        <h2>{{ section.settings.best_title | default: 'Los más vendidos' }}</h2>
        <p>{{ section.settings.best_sub | default: 'Los favoritos que más se mueven: proteínas, creatina, pre-entrenos y más. Todos 100% originales y listos para despacho el mismo día.' }}</p>
      </div>
      <div class="fc-best-grid">
        {%- assign fc_best_default = 'optimum-nutrition-gold-standard-100-whey,dymatize-iso100-whey-protein-isolate,optimum-nutrition-micronized-creatine-powder,c4-original-pre-entreno' -%}
        {%- assign fc_best_str = section.settings.best_handles | default: fc_best_default -%}
        {%- assign fc_best_handles = fc_best_str | split: ',' -%}
        {%- for fc_h in fc_best_handles -%}
          {%- assign fc_handle = fc_h | strip -%}
          {%- assign fc_prod = all_products[fc_handle] -%}
          {%- if fc_prod != blank and fc_prod.id -%}
            {%- assign fc_delay = forloop.index0 | times: 60 -%}
            {%- assign fc_var = fc_prod.selected_or_first_available_variant -%}
            <div class="fc-pc fc-reveal" style="--fc-d:{{ fc_delay }}ms">
              <a class="fc-pc-media" href="{{ fc_prod.url }}">
                <span class="fc-pc-rank"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2l2.4 6.9H22l-6 4.6 2.3 7L12 16.9 5.7 20.5 8 13.5 2 8.9h7.6z"/></svg>Top ventas</span>
                {%- if fc_prod.featured_image -%}
                  <img src="{{ fc_prod.featured_image | image_url: width: 600 }}" alt="{{ fc_prod.title | escape }}" loading="lazy" width="600" height="600">
                {%- endif -%}
              </a>
              <div class="fc-pc-body">
                {%- if fc_prod.vendor != blank -%}<span class="fc-pc-vendor">{{ fc_prod.vendor }}</span>{%- endif -%}
                <a class="fc-pc-title" href="{{ fc_prod.url }}">{{ fc_prod.title }}</a>
                <div class="fc-pc-foot">
                  {%- assign fc_divisa = fc_prod.price | times: 100 | divided_by: 115 -%}
                  <div class="fc-pc-prices">
                    <span class="fc-pc-price fc-pc-price--divisa">{{ fc_divisa | money }}<span class="fc-pc-cur">Divisa</span></span>
                    <span class="fc-pc-price">{{ fc_prod.price | money }}<span class="fc-pc-cur">BCV</span></span>
                  </div>
                  {%- if fc_var and fc_var.available -%}
                    <form method="post" action="{{ routes.cart_add_url }}" class="fc-pc-form" data-fc-add>
