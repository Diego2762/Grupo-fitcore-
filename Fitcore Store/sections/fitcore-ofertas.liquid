  <section>
    <div class="w">
      <div class="cta">
        <p>¿Dudas antes de comprar? Te ayudamos a armar tu pedido.</p>
        <a class="wa" href="https://wa.me/{{ wa }}?text={{ wa_msg_enc }}" target="_blank" rel="noopener">Escribir por WhatsApp</a>
      </div>
    </div>
  </section>
</div>

<script>
(function(){
  var root = document.getElementById('fc-of-{{ section.id }}'); if(!root) return;

  /* Cuenta regresiva */
  var start = new Date(root.dataset.start).getTime(), end = new Date(root.dataset.end).getTime();
  var box = root.querySelector('[data-clock]'), label = root.querySelector('[data-clock-label]');
  function pad(n){ return (n<10?'0':'')+n; }
  function tick(){
    if (isNaN(start) || isNaN(end)) return;
    var now = Date.now(), t;
    if (now < start) { t = start-now; label.textContent = 'Empieza en'; }
    else if (now <= end) { t = end-now; label.textContent = 'Termina en'; }
    else { box.hidden = true; return; }
    box.hidden = false;
    box.querySelector('[data-d]').textContent = pad(Math.floor(t/864e5));
    box.querySelector('[data-h]').textContent = pad(Math.floor(t%864e5/36e5));
    box.querySelector('[data-m]').textContent = pad(Math.floor(t%36e5/6e4));
    box.querySelector('[data-s]').textContent = pad(Math.floor(t%6e4/1e3));
    setTimeout(tick, 1000);
  }
  tick();

  /* Agregar al carrito sin salir de la pagina (mismas tarjetas que el catalogo) */
  root.addEventListener('submit', function(ev){
    var form = ev.target.closest ? ev.target.closest('form[data-fc-add]') : null;
    if (!form || !window.fetch) return;
    ev.preventDefault();
    var btn = form.querySelector('.fc-pc-cart, [data-buy]');
    if (btn) { if (btn.classList.contains('is-loading')) return; btn.classList.add('is-loading'); }
    var notif = document.querySelector('cart-notification, cart-drawer');
    var body = new FormData(form);
    body.append('sections', 'cart-notification-product,cart-notification-button,cart-icon-bubble');
    body.append('sections_url', window.location.pathname);
    fetch('{{ routes.cart_add_url }}.js', { method:'POST', headers:{ 'Accept':'application/json', 'X-Requested-With':'XMLHttpRequest' }, body: body })
      .then(function(r){ return r.json(); })
      .then(function(res){
        if (res && res.status) { if (btn) btn.classList.remove('is-loading'); form.submit(); return; }
        if (btn) {
          btn.classList.remove('is-loading'); btn.classList.add('is-added');
          var html = btn.innerHTML;
          btn.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" style="width:20px;height:20px"><path d="M20 6L9 17l-5-5"/></svg>';
          setTimeout(function(){ btn.innerHTML = html; btn.classList.remove('is-added'); }, 1600);
        }
        if (notif && typeof notif.renderContents === 'function') { try { notif.renderContents(res); } catch (e) {} }
        else if (res.sections && res.sections['cart-icon-bubble']) {
          var b = document.getElementById('cart-icon-bubble');
          if (b) { var t = document.createElement('div'); t.innerHTML = res.sections['cart-icon-bubble']; var s = t.querySelector('.shopify-section'); b.innerHTML = s ? s.innerHTML : t.innerHTML; }
        }
        document.dispatchEvent(new CustomEvent('fc:cart:added'));
      })
      .catch(function(){ if (btn) btn.classList.remove('is-loading'); form.submit(); });
  });

  /* Sorteo: mismo flujo que la pagina de clave (Supabase fitcore_leads + email a Shopify) */
  var SB_URL = {{ sb_url | json }};
  var SB_KEY = {{ sb_key | json }};
  var CAMPAIGN = {{ section.settings.campaign | default: 'fitness_party_2026' | json }};
  var regBtn = document.getElementById('fc-reg-btn-{{ section.id }}');
  var card = document.getElementById('fc-form-card-{{ section.id }}');
  var form = document.getElementById('fc-lead-form-{{ section.id }}');
  if (!form || !regBtn || !card) return;
  var msg = document.getElementById('fc-msg-{{ section.id }}');
  var btn = document.getElementById('fc-submit-{{ section.id }}');
  var formView = form.closest('.fview');
  var successView = document.getElementById('fc-success-{{ section.id }}');
  var igBtn = document.getElementById('fc-ig-btn-{{ section.id }}');
  var igTxt = document.getElementById('fc-ig-txt-{{ section.id }}');
  var nlForm = document.getElementById('fc-newsletter-form-of');
  var nlEmail = document.getElementById('fc-nl-email-{{ section.id }}');
  var igFollowed = false;

  function setMsg(t, err){ msg.textContent = t || ''; msg.className = 'msg' + (err ? ' msg--err' : ''); }

  regBtn.addEventListener('click', function(){
    card.hidden = false;
    regBtn.setAttribute('aria-expanded', 'true');
    try { card.scrollIntoView({ behavior:'smooth', block:'center' }); } catch(_){}
  });

  function submitShopifyEmail(email){
    if (!nlForm || !nlEmail) return;
    try {
      nlEmail.value = email;
      fetch(nlForm.getAttribute('action') || '/contact', { method:'POST', headers:{ 'Accept':'application/json' }, body: new FormData(nlForm) }).catch(function(){});
    } catch(_){}
  }

  if (igBtn) {
    igBtn.addEventListener('click', function(){
      var url = igBtn.getAttribute('data-url');
      if (url) window.open(url, '_blank', 'noopener');
      igFollowed = true;
      igBtn.classList.add('is-done');
      if (igTxt) igTxt.textContent = 'Listo, ya te sigo · ¡gracias!';
      setMsg('', false);
    });
  }

  form.addEventListener('submit', function(e){
    e.preventDefault();
    if (form.website && form.website.value) return; // honeypot
    var first = (form.first_name.value||'').trim();
    var last = (form.last_name.value||'').trim();
    var email = (form.email.value||'').trim();
    var wa = (form.whatsapp.value||'').trim();
    if (!first) { setMsg('Ingresa tu nombre.', true); return; }
    if (!last) { setMsg('Ingresa tu apellido.', true); return; }
    if (!email || email.indexOf('@') < 1) { setMsg('Ingresa un correo válido.', true); return; }
    if (!wa) { setMsg('Ingresa tu WhatsApp.', true); return; }
    if (!igFollowed) { setMsg('Toca el botón de Instagram y síguenos para participar.', true); return; }
    if (!SB_URL || !SB_KEY) { setMsg('El registro no está disponible por ahora. Escríbenos por WhatsApp.', true); return; }
    btn.disabled = true; setMsg('Enviando...', false);
    submitShopifyEmail(email);
    fetch(SB_URL + '/rest/v1/fitcore_leads', {
      method:'POST',
      headers:{ 'apikey': SB_KEY, 'Authorization': 'Bearer ' + SB_KEY, 'Content-Type':'application/json', 'Prefer':'return=minimal' },
      body: JSON.stringify({ first_name: first, last_name: last, email: email, whatsapp: wa, instagram_follow: igFollowed, campaign: CAMPAIGN, source: 'ofertas_page', user_agent: navigator.userAgent })
    }).then(function(r){
      if (r.ok) {
        if (formView) formView.style.display = 'none';
        if (successView) successView.style.display = 'block';
      } else {
        btn.disabled = false;
        setMsg('No se pudo registrar. Intenta de nuevo o escríbenos por WhatsApp.', true);
      }
    }).catch(function(){
      btn.disabled = false;
      setMsg('Sin conexión. Intenta de nuevo.', true);
    });
  });
})();
</script>

