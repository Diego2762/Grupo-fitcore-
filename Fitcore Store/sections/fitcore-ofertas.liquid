            {%- assign p_title = section.settings.prize1_title -%}{%- assign p_text = section.settings.prize1_text -%}
          {%- else -%}
            {%- assign p_img = section.settings.prize2_image_url -%}{%- assign p_tag = section.settings.prize2_tag -%}
            {%- assign p_title = section.settings.prize2_title -%}{%- assign p_text = section.settings.prize2_text -%}
          {%- endif -%}
          <div class="prize">
            <span class="prize-rib">Participa gratis</span>
            {%- if p_img != blank -%}
              <img src="{{ p_img }}" alt="{{ p_title | escape }}" width="800" height="600">
            {%- else -%}
              <div class="ph">Imagen del premio {{ i }}<br>(próximamente)</div>
            {%- endif -%}
            {%- if p_tag != blank -%}<div class="prize-t">{{ p_tag }}</div>{%- endif -%}
