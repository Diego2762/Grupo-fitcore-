              </div>
              <div class="fld">
                <label for="fc-last-{{ section.id }}">Apellido</label>
                <input class="inp" type="text" id="fc-last-{{ section.id }}" name="last_name" required autocomplete="family-name" placeholder="Tu apellido">
              </div>
            </div>
            <div class="fld">
              <label for="fc-email-{{ section.id }}">Correo electrónico</label>
              <input class="inp" type="email" id="fc-email-{{ section.id }}" name="email" required autocomplete="email" placeholder="tucorreo@ejemplo.com">
            </div>
            <div class="fld">
              <label for="fc-wa-{{ section.id }}">WhatsApp</label>
              <input class="inp" type="tel" id="fc-wa-{{ section.id }}" name="whatsapp" required autocomplete="tel" placeholder="0424 000 0000">
            </div>
            <div class="hp"><label>No llenar</label><input type="text" name="website" tabindex="-1" autocomplete="off"></div>

            <button type="button" class="ig" id="fc-ig-btn-{{ section.id }}" data-url="{{ section.settings.instagram_url | default: 'https://www.instagram.com/fitcore.ve' }}">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 2.2c3.2 0 3.6 0 4.9.1 1.2.1 1.8.3 2.2.4.5.2.9.5 1.3.9.4.4.7.8.9 1.3.1.4.3 1 .4 2.2.1 1.3.1 1.7.1 4.9s0 3.6-.1 4.9c-.1 1.2-.3 1.8-.4 2.2-.2.5-.5.9-.9 1.3-.4.4-.8.7-1.3.9-.4.1-1 .3-2.2.4-1.3.1-1.7.1-4.9.1s-3.6 0-4.9-.1c-1.2-.1-1.8-.3-2.2-.4a3.6 3.6 0 0 1-1.3-.9 3.6 3.6 0 0 1-.9-1.3c-.1-.4-.3-1-.4-2.2C2.2 15.6 2.2 15.2 2.2 12s0-3.6.1-4.9c.1-1.2.3-1.8.4-2.2.2-.5.5-.9.9-1.3.4-.4.8-.7 1.3-.9.4-.1 1-.3 2.2-.4C8.4 2.2 8.8 2.2 12 2.2zm0 3.1a6.7 6.7 0 1 0 0 13.4 6.7 6.7 0 0 0 0-13.4zm0 11a4.3 4.3 0 1 1 0-8.6 4.3 4.3 0 0 1 0 8.6zm6.5-11.3a1.5 1.5 0 1 1-3 0 1.5 1.5 0 0 1 3 0z"/></svg>
              <span id="fc-ig-txt-{{ section.id }}">Seguir a @{{ section.settings.instagram_handle | default: 'fitcore.ve' }}</span>
            </button>
            <p class="ig-hint">Toca el botón, síguenos en Instagram y vuelve para participar.</p>

            <button type="submit" class="send" id="fc-submit-{{ section.id }}">{{ section.settings.button_label | default: 'Quiero participar' }}</button>
            <p class="msg" id="fc-msg-{{ section.id }}" role="status"></p>
          </form>

          {%- comment -%} Form nativo de Shopify (oculto): registra el email en Clientes / email marketing {%- endcomment -%}
          {%- form 'customer', id: 'fc-newsletter-form-of', class: 'nl-hidden' -%}
            <input type="hidden" name="contact[tags]" value="newsletter,{{ section.settings.campaign | default: 'fitness_party_2026' }}">
            <input type="hidden" name="contact[email]" id="fc-nl-email-{{ section.id }}" value="">
          {%- endform -%}
        </div>

        <div class="ok" id="fc-success-{{ section.id }}">
          <h3>{{ section.settings.success_title | default: '¡Listo, ya estás participando!' }}</h3>
          <p class="fsub">{{ section.settings.success_text | default: 'Te avisaremos por WhatsApp y correo. No olvides seguirnos en Instagram para no perderte la fecha de apertura.' }}</p>
          <a href="{{ section.settings.instagram_url | default: 'https://www.instagram.com/fitcore.ve' }}" target="_blank" rel="noopener">Seguir @{{ section.settings.instagram_handle | default: 'fitcore.ve' }}</a>
        </div>
      </div>

      {%- if section.settings.mechanics_text != blank -%}<p class="mech">{{ section.settings.mechanics_text }}</p>{%- endif -%}
      {%- if section.settings.bases_text != blank -%}
        <details class="bases">
          <summary>Bases y condiciones del sorteo</summary>
          <p>{{ section.settings.bases_text }}</p>
        </details>
      {%- endif -%}
     </div>
    </div>
  </section>

  <section class="sec">
    <div class="w">
      <div class="promo">
        <div>
          <span class="tag">Oferta de apertura</span>
          <h2>Nuestras ofertas en creatinas</h2>
          <p>Las creatinas más vendidas a precio de apertura, en divisa y en bolívares BCV. El descuento de cada una está en su ficha y se aplica solo al pagar.</p>
        </div>
      </div>
      <div class="grid grid--3">
        {%- for h in creatine_handles -%}
          {%- assign p = all_products[h] -%}
          {%- if p != blank -%}{%- render 'fitcore-product-card', product: p, lazy: true -%}{%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="w">
      <div class="promo">
        <div>
          <span class="tag">Oferta de apertura</span>
          <h2>Quema grasa y energía: 10% menos</h2>
          <p>Nutrex Liquid Carnitine y Lipo-6 con 10% de descuento, tanto en divisa como en bolívares BCV. El descuento se aplica solo al pagar.</p>
        </div>
        <div class="pct">-10%<small>Divisa y BCV</small></div>
      </div>
      <div class="grid grid--3">
        {%- for h in burn_handles -%}
          {%- assign p = all_products[h] -%}
          {%- if p != blank -%}
            {%- if p.variants.size > 1 -%}
              {%- for v in p.variants -%}{%- render 'fitcore-product-card', product: p, variant: v, lazy: true -%}{%- endfor -%}
            {%- else -%}
              {%- render 'fitcore-product-card', product: p, lazy: true -%}
            {%- endif -%}
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="w">
      <div class="promo">
        <div>
          <span class="tag">Oferta de apertura</span>
          <h2>Aminoácidos y BCAA: hasta 10% menos</h2>
          <p>Nutrex BCAA 6000 con 10% y BSN AMINOx y XTEND EAA con 5% de descuento, en divisa y en bolívares BCV. El descuento de cada uno está en su ficha.</p>
        </div>
        <div class="pct"><span style="display:block;font-size:.32em;letter-spacing:.06em;text-transform:uppercase;margin-bottom:4px">Hasta</span>-10%<small>Divisa y BCV</small></div>
      </div>
      <div class="grid grid--3">
        {%- for h in amino_handles -%}
          {%- assign p = all_products[h] -%}
          {%- if p != blank -%}{%- render 'fitcore-product-card', product: p, lazy: true -%}{%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="w">
      <div class="promo">
        <div>
          <span class="tag">Oferta de apertura</span>
          <h2>Lleva 3, paga 2</h2>
          <p>Mezcla las vitaminas Nature's Bounty que quieras. Por cada 3 en tu carrito, una te sale gratis. El descuento se aplica solo al pagar.</p>
        </div>
        <div class="pct pct--3x2">3x2<small>Compra 3, paga 2</small></div>
