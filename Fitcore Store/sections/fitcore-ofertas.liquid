          {%- endfor -%}
        </div>
      {%- else -%}
        <p><a href="/search?q=nature%27s+bounty" style="color:#19C37D">Ver productos Nature's Bounty</a></p>
      {%- endif -%}
      <div class="terms">{%- render 'fitcore-promo-terms' -%}</div>
    </div>
