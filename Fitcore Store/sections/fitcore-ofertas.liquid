{%- comment -%}
  Fitcore Store · Página "Ofertas de apertura" (B2C) · versión oscura, hermana visual de la página de clave (password).
  Todas las ofertas duran una semana (semana de inauguración). Fechas: ajustar start_iso / end_iso aquí y en snippets/fitcore-promo.liquid.
  Espejo de los descuentos automáticos de Shopify:
    Creatinas: Nutrex $13.99 divisa (-22%), ON Micronized $25.99 divisa (-16%), Cellucor -10% · Lleva 3, paga 2 en Nature's Bounty · Envío gratis Valera
    Nutrex Liquid Carnitine, Lipo-6 y BCAA 6000: 10% · BSN AMINOx, XTEND BCAA y XTEND EAA: 5% (XTEND BCAA no se muestra en esta pagina)
  Los precios reales los aplica Shopify en el carrito; esta página solo los comunica.
  Las tarjetas usan el snippet fitcore-product-card (foto, precios divisa/BCV, botón de carrito).
  Los porcentajes se definen en snippets/fitcore-promo.liquid (fuente única). Las listas de handles de abajo deben coincidir.
  Premios + formulario: mismo flujo que la página de clave (inserta en Supabase fitcore_leads + registra el email en Shopify).
{%- endcomment -%}

{{ 'fitcore-cards.css' | asset_url | stylesheet_tag }}

{%- liquid
  assign wa = section.settings.whatsapp | default: '584220384328'
  assign wa_msg_enc = section.settings.whatsapp_msg | default: 'Hola Fitcore Store, quiero aprovechar las ofertas de apertura' | url_encode
  assign nb_col = section.settings.nb_collection | default: collections['natures-bounty']
  assign nb_hide = section.settings.nb_hide | default: 'natures-bounty-melatonina-10-mg-45-tabletas-de-disolucion-rapida' | split: ','
  assign start_iso = section.settings.start_iso | default: '2026-10-11T00:00:00-04:00'
  assign end_iso = section.settings.end_iso | default: '2026-11-15T23:59:59-04:00'
  # El envio gratis tiene su propia ventana (igual que el descuento automatico de envio)
  assign ship_start_iso = section.settings.ship_start_iso | default: '2026-11-01T00:00:00-04:00'
  assign ship_end_iso = section.settings.ship_end_iso | default: '2026-11-15T23:59:59-04:00'
  assign ship_t0 = ship_start_iso | date: '%s' | plus: 0
  assign ship_t1 = ship_end_iso | date: '%s' | plus: 0
  assign ship_secs = ship_t1 | minus: ship_t0
  assign ship_days = ship_secs | divided_by: 86400.0 | ceil

  # Quemadores: una ficha por sabor de Liquid Carnitine + Lipo-6 (3 fichas, igual que el bloque de aminos)
  assign creatine_handles = 'nutrex-creatine-monohydrate-300-g,optimum-nutrition-micronized-creatine-powder,cellucor-cor-performance-creatine' | split: ','
  assign burn_handles = 'nutrex-liquid-carnitine-3000,nutrex-lipo-6-black-ultra-concentrate-60-capsulas' | split: ','
  # Aminos en esta pagina: XTEND Original BCAA sigue con su 5% en la tienda, pero aqui se reemplaza por Nutrex BCAA 6000 (10%)
  assign amino_handles = 'nutrex-bcaa-6000,bsn-aminox-435-g,xtend-eaa' | split: ','
  assign sb_url = section.settings.supabase_url
  assign sb_key = section.settings.supabase_key
-%}

<style>
  #fc-of-{{ section.id }} {
    --navy:#0B1840; --navy-d:#071631; --purple:#3B1F6B; --purple-l:#5a2fa0; --accent:#b79cff; --green:#19C37D; --green-d:#12994f; --muted:rgba(255,255,255,.72); --line:rgba(255,255,255,.14);
    position:relative; overflow:hidden; color:#fff; font-family:'Open Sans','Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;
    background:
      radial-gradient(1200px 600px at 12% -6%, rgba(90,47,160,.55), transparent 60%),
      radial-gradient(1000px 700px at 112% 22%, rgba(90,47,160,.22), transparent 55%),
      linear-gradient(160deg, var(--navy) 0%, var(--navy-d) 55%, #05101f 100%);
  }
  #fc-of-{{ section.id }}::before { content:''; position:absolute; inset:-20% -10% auto -10%; height:80%; z-index:0; pointer-events:none; background:radial-gradient(620px 620px at 28% 18%, rgba(90,47,160,.38), transparent 62%), radial-gradient(520px 520px at 78% 60%, rgba(90,47,160,.22), transparent 62%); animation:fcof-float 15s ease-in-out infinite alternate; }
  @keyframes fcof-float { from { transform:translate3d(0,0,0) scale(1); } to { transform:translate3d(0,-26px,0) scale(1.08); } }
  @keyframes fcof-up { from { opacity:0; transform:translateY(20px); } to { opacity:1; transform:none; } }
  @keyframes fcof-pulse { 0%,100% { box-shadow:0 8px 22px rgba(59,31,107,.45); } 50% { box-shadow:0 12px 34px rgba(90,47,160,.85); } }
  @keyframes fcof-badge { 0%,100% { box-shadow:0 0 0 0 rgba(183,156,255,.45); } 50% { box-shadow:0 0 0 6px rgba(183,156,255,0); } }
  @keyframes fcof-blink { 0%,100% { opacity:.9; } 50% { opacity:.25; } }
  @keyframes fcof-marq { from { transform:translateX(0); } to { transform:translateX(-50%); } }
  #fc-of-{{ section.id }} * { box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
  #fc-of-{{ section.id }} > * { position:relative; z-index:1; }
  #fc-of-{{ section.id }} .w { max-width:1180px; margin:0 auto; padding:0 20px; }

  /* Hero + reloj grande */
  #fc-of-{{ section.id }} .hero { padding:44px 0 34px; text-align:center; }
  #fc-of-{{ section.id }} .eyebrow { display:inline-block; font:700 12px/1 'Inter',sans-serif; letter-spacing:.2em; text-transform:uppercase; color:var(--accent); border:1px solid rgba(183,156,255,.5); border-radius:999px; padding:8px 16px; margin-bottom:18px; animation:fcof-up .7s cubic-bezier(.16,.84,.44,1) both, fcof-badge 2.6s ease-in-out .9s infinite; }
  #fc-of-{{ section.id }} h1 { font-family:'Inter',sans-serif; font-weight:800; font-size:clamp(42px,8.4vw,88px); line-height:1; letter-spacing:-.03em; margin:0 0 14px; animation:fcof-up .7s .1s cubic-bezier(.16,.84,.44,1) both; }
  #fc-of-{{ section.id }} h1 em { font-style:normal; color:var(--green); }
  #fc-of-{{ section.id }} .sub { margin:0 auto; max-width:60ch; color:rgba(255,255,255,.85); font-size:clamp(15px,2.2vw,18px); line-height:1.6; animation:fcof-up .7s .2s cubic-bezier(.16,.84,.44,1) both; }
  #fc-of-{{ section.id }} .clock-wrap { margin-top:34px; animation:fcof-up .8s .3s cubic-bezier(.16,.84,.44,1) both; }
  #fc-of-{{ section.id }} .clock-l { display:block; font:800 clamp(13px,2vw,18px)/1 'Inter',sans-serif; letter-spacing:.22em; text-transform:uppercase; color:var(--green); margin-bottom:16px; }
  #fc-of-{{ section.id }} .clock { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:clamp(8px,2vw,22px); }
  #fc-of-{{ section.id }} .clock .u { position:relative; text-align:center; background:linear-gradient(180deg,rgba(255,255,255,.10),rgba(255,255,255,.03)); border:1px solid var(--line); border-radius:clamp(14px,2.4vw,28px); padding:clamp(18px,3.4vw,44px) 6px clamp(14px,2.6vw,34px); box-shadow:0 20px 50px rgba(0,0,0,.28), inset 0 1px 0 rgba(255,255,255,.12); }
  #fc-of-{{ section.id }} .clock .u:not(:last-child)::after { content:':'; position:absolute; right:calc(clamp(8px,2vw,22px) / -2); top:40%; transform:translate(50%,-50%); font:800 clamp(24px,5vw,64px)/1 'Inter',sans-serif; color:var(--accent); animation:fcof-blink 1s steps(2,end) infinite; z-index:2; }
  #fc-of-{{ section.id }} .clock b { display:block; font:800 clamp(44px,13.5vw,170px)/.95 'Inter',sans-serif; letter-spacing:-.03em; font-variant-numeric:tabular-nums; background:linear-gradient(180deg,#fff 30%,var(--accent)); -webkit-background-clip:text; background-clip:text; color:transparent; -webkit-text-fill-color:transparent; }
  #fc-of-{{ section.id }} .clock small { display:block; margin-top:clamp(8px,1.4vw,16px); font:700 clamp(10px,1.6vw,16px)/1 'Inter',sans-serif; letter-spacing:.2em; text-transform:uppercase; color:var(--muted); }

  /* Banner de envio gratis (carrusel automatico) */
  #fc-of-{{ section.id }} .ship { margin:6px 0 0; background:linear-gradient(90deg,var(--green-d),var(--green) 40%,#2ee59a); color:#04281a; overflow:hidden; border-top:1px solid rgba(255,255,255,.35); border-bottom:1px solid rgba(0,0,0,.18); box-shadow:0 14px 40px rgba(25,195,125,.28); }
  #fc-of-{{ section.id }} .ship-track { display:flex; width:max-content; animation:fcof-marq 28s linear infinite; will-change:transform; }
  #fc-of-{{ section.id }} .ship:hover .ship-track { animation-play-state:paused; }
  #fc-of-{{ section.id }} .ship-grp { display:flex; flex:none; }
  #fc-of-{{ section.id }} .ship-it { display:inline-flex; align-items:center; gap:16px; padding:clamp(16px,2.6vw,28px) clamp(22px,3.4vw,44px); font:900 clamp(22px,4.2vw,46px)/1 'Inter',sans-serif; letter-spacing:-.01em; text-transform:uppercase; white-space:nowrap; }
  #fc-of-{{ section.id }} .ship-it svg { width:1.15em; height:1.15em; flex:none; }
  #fc-of-{{ section.id }} .ship-it i { font-style:normal; opacity:.55; }
  #fc-of-{{ section.id }} .ship-it small { font:800 .46em/1 'Inter',sans-serif; letter-spacing:.1em; background:#04281a; color:#7ff0bd; padding:.6em .9em; border-radius:99px; }

  /* Secciones */
  #fc-of-{{ section.id }} .sec { padding:48px 0 4px; }
  #fc-of-{{ section.id }} .sec-h { display:flex; flex-wrap:wrap; align-items:baseline; gap:6px 14px; margin:0 0 20px; }
  #fc-of-{{ section.id }} .sec-h h2 { font-family:'Inter',sans-serif; font-weight:800; font-size:clamp(24px,3.2vw,36px); letter-spacing:-.02em; margin:0; }
  #fc-of-{{ section.id }} .sec-h p { margin:0; color:var(--muted); font-size:15px; }
  #fc-of-{{ section.id }} .tag { display:inline-block; background:var(--green); color:#071631; font:800 10.5px/1 sans-serif; letter-spacing:.08em; text-transform:uppercase; padding:6px 9px; border-radius:99px; }
  #fc-of-{{ section.id }} .tag--p { background:rgba(183,156,255,.18); color:var(--accent); border:1px solid rgba(183,156,255,.5); }

  /* Tarjeta destacada Nutrex */
  #fc-of-{{ section.id }} .prices { display:flex; flex-wrap:wrap; gap:8px 26px; margin:6px 0 2px; }
  #fc-of-{{ section.id }} .pr { display:flex; flex-direction:column; gap:5px; }
  #fc-of-{{ section.id }} .pr em { font:700 10px/1 sans-serif; letter-spacing:.08em; text-transform:uppercase; font-style:normal; color:var(--muted); }
  #fc-of-{{ section.id }} .pr b { font:800 40px/1 'Inter',sans-serif; color:var(--green); font-variant-numeric:tabular-nums; }
  #fc-of-{{ section.id }} .pr.bcv b { font-size:26px; color:#fff; }
  #fc-of-{{ section.id }} .pr s { font-size:15px; color:rgba(255,255,255,.5); font-variant-numeric:tabular-nums; }
  #fc-of-{{ section.id }} .pr .l { display:flex; align-items:baseline; gap:9px; }
  #fc-of-{{ section.id }} .save { background:rgba(25,195,125,.16); border:1px solid rgba(25,195,125,.45); color:#c8ffe6; font:800 12.5px/1 sans-serif; padding:8px 11px; border-radius:8px; }
  #fc-of-{{ section.id }} .buy { display:inline-flex; align-items:center; justify-content:center; gap:9px; border:0; cursor:pointer; background:linear-gradient(135deg,var(--purple-l),var(--purple)); color:#fff; font:800 15px/1 sans-serif; padding:15px 26px; border-radius:12px; text-decoration:none; transition:transform .15s, filter .15s; min-height:48px; box-shadow:0 8px 22px rgba(59,31,107,.45); }
  #fc-of-{{ section.id }} .buy:hover { transform:translateY(-2px); filter:brightness(1.1); }
  #fc-of-{{ section.id }} .buy svg { width:20px; height:20px; }
  #fc-of-{{ section.id }} .buy.is-loading { pointer-events:none; opacity:.7; }
  #fc-of-{{ section.id }} .buy.is-added { background:var(--green); color:#071631; }

  /* Bloques de promo (Lleva 3 paga 2, porcentajes) */
  #fc-of-{{ section.id }} .promo { background:linear-gradient(120deg,rgba(90,47,160,.55),rgba(59,31,107,.35)); border:1px solid rgba(183,156,255,.35); color:#fff; border-radius:22px; padding:24px 28px; display:grid; grid-template-columns:minmax(0,1fr) auto; gap:16px 28px; align-items:center; margin-bottom:20px; }
  #fc-of-{{ section.id }} .promo h2 { font-family:'Inter',sans-serif; font-weight:800; font-size:clamp(24px,3.2vw,36px); margin:12px 0 6px; letter-spacing:-.02em; }
  #fc-of-{{ section.id }} .promo p { margin:0; color:rgba(255,255,255,.85); font-size:15px; line-height:1.55; max-width:60ch; }
  #fc-of-{{ section.id }} .pct { font:900 clamp(54px,8vw,92px)/.9 'Inter',sans-serif; letter-spacing:-.04em; color:var(--green); text-align:center; }
  #fc-of-{{ section.id }} .pct small { display:block; margin-top:8px; font:700 12px/1 'Inter',sans-serif; letter-spacing:.16em; text-transform:uppercase; color:var(--muted); }
  #fc-of-{{ section.id }} .pct--3x2 small { font-size:15px; letter-spacing:.12em; color:#fff; margin-top:10px; }
  #fc-of-{{ section.id }} .grid { display:grid; grid-template-columns:repeat(4,minmax(0,1fr)); gap:16px; }
  #fc-of-{{ section.id }} .grid--3 { grid-template-columns:repeat(3,minmax(0,1fr)); }
  #fc-of-{{ section.id }} .terms { margin:16px 0 0; padding:14px 16px; background:rgba(255,255,255,.06); border:1px solid var(--line); border-radius:12px; color:var(--muted); }
  #fc-of-{{ section.id }} .terms a { color:var(--green); }

  /* Premios + formulario (bloque destacado, va primero) */
  @property --fcof-a { syntax:'<angle>'; inherits:false; initial-value:0deg; }
  @keyframes fcof-spin { to { --fcof-a:360deg; } }
  @keyframes fcof-gpulse { 0%,100% { box-shadow:0 10px 28px rgba(25,195,125,.45), 0 0 0 0 rgba(46,229,154,.55); } 50% { box-shadow:0 14px 38px rgba(25,195,125,.65), 0 0 0 10px rgba(46,229,154,0); } }
  @keyframes fcof-bob { 0%,100% { transform:translateY(0) rotate(-6deg); } 50% { transform:translateY(-6px) rotate(6deg); } }
  #fc-of-{{ section.id }} .hero-gift { display:inline-flex; align-items:center; gap:9px; margin-top:20px; padding:12px 20px; border-radius:999px; background:rgba(25,195,125,.16); border:1px solid rgba(25,195,125,.6); color:#c8ffe6; font:800 14.5px/1 'Inter',sans-serif; text-decoration:none; animation:fcof-up .7s .25s cubic-bezier(.16,.84,.44,1) both; transition:background .18s, transform .18s; }
  #fc-of-{{ section.id }} .hero-gift:hover { background:rgba(25,195,125,.28); transform:translateY(-2px); }
  #fc-of-{{ section.id }} .hero-gift svg { width:19px; height:19px; flex:none; }
  #fc-of-{{ section.id }} .win { padding-top:40px; scroll-margin-top:80px; }
  #fc-of-{{ section.id }} .win-box { position:relative; border-radius:30px; padding:clamp(24px,4.4vw,52px) clamp(16px,4vw,48px); border:2px solid transparent;
    background:
      radial-gradient(700px 320px at 50% -8%, rgba(25,195,125,.30), transparent 70%) padding-box,
      linear-gradient(160deg,#2a1656 0%,#14205a 55%,#0b1840 100%) padding-box,
      conic-gradient(from var(--fcof-a), #19C37D, #b79cff, #2ee59a, #5a2fa0, #19C37D) border-box;
    box-shadow:0 30px 90px rgba(25,195,125,.20), 0 20px 60px rgba(0,0,0,.35); animation:fcof-spin 6s linear infinite; }
  #fc-of-{{ section.id }} .win-head { text-align:center; max-width:760px; margin:0 auto 28px; }
  #fc-of-{{ section.id }} .win-ico { display:inline-flex; width:62px; height:62px; align-items:center; justify-content:center; border-radius:18px; background:linear-gradient(135deg,#2ee59a,#19C37D); color:#04281a; box-shadow:0 12px 30px rgba(25,195,125,.45); margin-bottom:14px; animation:fcof-bob 2.6s ease-in-out infinite; }
  #fc-of-{{ section.id }} .win-ico svg { width:32px; height:32px; }
  #fc-of-{{ section.id }} .win-head .tag { display:table; margin:0 auto; }
  #fc-of-{{ section.id }} .win-head h2 { font-family:'Inter',sans-serif; font-weight:900; font-size:clamp(34px,6vw,64px); line-height:1.02; letter-spacing:-.03em; margin:14px 0 12px; }
  #fc-of-{{ section.id }} .win-head h2 em { font-style:normal; color:var(--green); }
  #fc-of-{{ section.id }} .win-head p { margin:0; color:rgba(255,255,255,.9); font-size:clamp(15px,2.3vw,19px); line-height:1.6; }
  #fc-of-{{ section.id }} .prizes { display:grid; grid-template-columns:repeat(2,minmax(0,1fr)); gap:clamp(14px,2.4vw,24px); max-width:960px; margin:0 auto; text-align:left; }
  #fc-of-{{ section.id }} .prize { position:relative; background:rgba(255,255,255,.08); border:1px solid rgba(25,195,125,.5); border-radius:22px; padding:14px 14px 20px; display:flex; flex-direction:column; box-shadow:0 18px 44px rgba(0,0,0,.3); transition:transform .2s, border-color .2s, background .2s; }
  #fc-of-{{ section.id }} .prize:hover { transform:translateY(-5px); border-color:var(--green); background:rgba(255,255,255,.11); }
  #fc-of-{{ section.id }} .prize img, #fc-of-{{ section.id }} .prize .ph { width:100%; height:auto; aspect-ratio:4/3; border-radius:14px; object-fit:cover; display:block; margin-bottom:16px; background:#0d1e46; }
  #fc-of-{{ section.id }} .prize .ph { display:flex; align-items:center; justify-content:center; text-align:center; color:rgba(255,255,255,.55); font-size:13px; border:1px dashed rgba(255,255,255,.25); }
  #fc-of-{{ section.id }} .prize-rib { position:absolute; top:24px; left:24px; z-index:2; background:linear-gradient(135deg,#2ee59a,#19C37D); color:#04281a; font:900 13px/1 'Inter',sans-serif; letter-spacing:.12em; text-transform:uppercase; padding:9px 14px; border-radius:99px; white-space:nowrap; box-shadow:0 8px 20px rgba(0,0,0,.35); }
  #fc-of-{{ section.id }} .prize-t { font:800 12px/1 'Inter',sans-serif; letter-spacing:.16em; text-transform:uppercase; color:var(--green); margin:0 6px 8px; }
  #fc-of-{{ section.id }} .prize-h { font:800 clamp(21px,2.6vw,27px)/1.2 'Inter',sans-serif; margin:0 6px 8px; }
  #fc-of-{{ section.id }} .prize-p { font-size:15px; line-height:1.5; color:rgba(255,255,255,.85); margin:0 6px; }
  #fc-of-{{ section.id }} .reg { text-align:center; margin-top:30px; }
  #fc-of-{{ section.id }} .reg-btn { display:inline-flex; align-items:center; justify-content:center; gap:10px; border:0; cursor:pointer; background:linear-gradient(135deg,#2ee59a,#19C37D); color:#04281a; font:900 clamp(17px,2.2vw,20px)/1 'Inter',sans-serif; padding:21px 46px; border-radius:16px; min-height:58px; animation:fcof-gpulse 2.4s ease-in-out infinite; transition:transform .15s, filter .15s; }
  #fc-of-{{ section.id }} .reg-btn:hover { transform:translateY(-2px); filter:brightness(1.06); animation:none; }
  #fc-of-{{ section.id }} .reg-btn[aria-expanded="true"] { display:none; }
  #fc-of-{{ section.id }} .fcard { background:rgba(255,255,255,.06); border:1px solid rgba(255,255,255,.14); border-radius:20px; padding:26px 22px; margin:22px auto 0; max-width:600px; text-align:center; }
  #fc-of-{{ section.id }} .fcard[hidden] { display:none; }
  #fc-of-{{ section.id }} .fcard h3 { font:800 22px/1.2 'Inter',sans-serif; margin:0 0 6px; }
  #fc-of-{{ section.id }} .fcard .fsub { font-size:14px; color:rgba(255,255,255,.75); margin:0 0 18px; }
  #fc-of-{{ section.id }} .fld { text-align:left; margin-bottom:12px; }
  #fc-of-{{ section.id }} .fld-row { display:grid; grid-template-columns:1fr 1fr; gap:12px; }
  @media (max-width:480px){ #fc-of-{{ section.id }} .fld-row { grid-template-columns:1fr; } }
  #fc-of-{{ section.id }} .fld label { display:block; font-size:12px; font-weight:600; letter-spacing:.03em; color:rgba(255,255,255,.7); margin-bottom:6px; }
  #fc-of-{{ section.id }} .inp { width:100%; background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.22); border-radius:12px; padding:14px 16px; color:#fff; font-size:16px; outline:none; transition:border-color .18s, background .18s; font-family:inherit; }
  #fc-of-{{ section.id }} .inp::placeholder { color:rgba(255,255,255,.5); }
  #fc-of-{{ section.id }} .inp:focus { border-color:var(--green); background:rgba(255,255,255,.12); }
  #fc-of-{{ section.id }} .hp { position:absolute; left:-9999px; opacity:0; height:0; width:0; }
  #fc-of-{{ section.id }} .nl-hidden { display:none !important; }
  #fc-of-{{ section.id }} .ig { width:100%; display:flex; align-items:center; justify-content:center; gap:10px; background:rgba(183,156,255,.10); color:#fff; border:1.5px solid rgba(183,156,255,.55); border-radius:14px; padding:15px 18px; font:700 15px/1 'Inter',sans-serif; cursor:pointer; margin:4px 0 14px; transition:transform .15s, background .18s, border-color .18s; }
  #fc-of-{{ section.id }} .ig:hover { transform:translateY(-2px); background:rgba(183,156,255,.18); border-color:var(--accent); }
  #fc-of-{{ section.id }} .ig svg { width:20px; height:20px; fill:currentColor; flex:none; }
  #fc-of-{{ section.id }} .ig.is-done { background:rgba(25,195,125,.16); border:1px solid var(--green); color:#c8ffe6; cursor:default; transform:none; }
  #fc-of-{{ section.id }} .ig-hint { font-size:12px; color:rgba(255,255,255,.55); margin:-6px 0 14px; line-height:1.5; }
  #fc-of-{{ section.id }} .send { width:100%; background:linear-gradient(135deg,var(--purple-l),var(--purple)); color:#fff; border:none; border-radius:12px; padding:16px; font:700 16px/1 'Inter',sans-serif; cursor:pointer; box-shadow:0 8px 22px rgba(59,31,107,.45); transition:transform .15s, filter .15s; }
  #fc-of-{{ section.id }} .send:hover { transform:translateY(-2px); filter:brightness(1.08); }
  #fc-of-{{ section.id }} .send[disabled] { opacity:.6; cursor:not-allowed; transform:none; }
  #fc-of-{{ section.id }} .msg { font-size:14px; margin:14px 0 0; font-weight:600; min-height:1px; }
  #fc-of-{{ section.id }} .msg--err { color:#ff9a9a; }
  #fc-of-{{ section.id }} .ok { display:none; }
  #fc-of-{{ section.id }} .ok h3 { color:var(--green); }
  #fc-of-{{ section.id }} .ok a { display:inline-flex; align-items:center; gap:8px; margin-top:14px; text-decoration:none; color:#fff; border:1px solid rgba(255,255,255,.25); border-radius:999px; padding:11px 20px; font-size:14px; font-weight:600; }
  #fc-of-{{ section.id }} .mech { font-size:13px; line-height:1.6; color:rgba(255,255,255,.65); margin:18px auto 0; max-width:560px; text-align:center; }
  #fc-of-{{ section.id }} details.bases { max-width:560px; margin:16px auto 0; text-align:left; font-size:13px; color:rgba(255,255,255,.7); }
  #fc-of-{{ section.id }} details.bases summary { cursor:pointer; color:rgba(255,255,255,.85); font-weight:600; }
  #fc-of-{{ section.id }} details.bases p { line-height:1.6; }

  #fc-of-{{ section.id }} .cta { display:flex; flex-wrap:wrap; align-items:center; justify-content:space-between; gap:12px 20px; padding:30px 0 calc(52px + env(safe-area-inset-bottom, 0px)); }
  #fc-of-{{ section.id }} .cta p { margin:0; color:var(--muted); font-size:15px; }
  #fc-of-{{ section.id }} .wa { display:inline-flex; align-items:center; font:800 14px/1 sans-serif; text-decoration:none; padding:13px 20px; border-radius:999px; border:1px solid rgba(255,255,255,.3); color:#fff; transition:background .18s; }
  #fc-of-{{ section.id }} .wa:hover { background:rgba(255,255,255,.12); }

  @media (max-width:1000px){ #fc-of-{{ section.id }} .grid { grid-template-columns:repeat(3,minmax(0,1fr)); } }
  @media (max-width:520px){ #fc-of-{{ section.id }} .clock .u::after { display:none; } }
  @media (max-width:760px){
    #fc-of-{{ section.id }} .w { padding:0 16px; }
    #fc-of-{{ section.id }} .hero { padding:30px 0 24px; }
    #fc-of-{{ section.id }} .sec { padding:36px 0 2px; }
          #fc-of-{{ section.id }} .promo { grid-template-columns:minmax(0,1fr) auto; padding:18px; gap:12px 14px; border-radius:18px; }
    #fc-of-{{ section.id }} .promo > div:first-child { grid-column:1 / -1; }
    #fc-of-{{ section.id }} .promo h2 { font-size:22px; margin:10px 0 6px; }
    #fc-of-{{ section.id }} .promo p { font-size:14px; }
    #fc-of-{{ section.id }} .pct { grid-column:1 / -1; display:flex; align-items:baseline; gap:10px; font-size:48px; text-align:left; }
    #fc-of-{{ section.id }} .pct small { margin:0; }
    #fc-of-{{ section.id }} .sec-h { margin-bottom:14px; }
    #fc-of-{{ section.id }} .prices { gap:8px 18px; }
    #fc-of-{{ section.id }} .pr b { font-size:34px; }
    #fc-of-{{ section.id }} .pr.bcv b { font-size:22px; }
    #fc-of-{{ section.id }} .grid, #fc-of-{{ section.id }} .grid--3 { grid-template-columns:repeat(2,minmax(0,1fr)); gap:12px; }
    #fc-of-{{ section.id }} .prizes { grid-template-columns:1fr; }
    #fc-of-{{ section.id }} .win { padding-top:28px; }
    #fc-of-{{ section.id }} .win-box { border-radius:24px; }
    #fc-of-{{ section.id }} .win-ico { width:54px; height:54px; }
    #fc-of-{{ section.id }} .prize-rib { top:22px; left:22px; }
    #fc-of-{{ section.id }} .hero-gift { width:100%; justify-content:center; min-height:48px; }
    #fc-of-{{ section.id }} .reg-btn { width:100%; }
    #fc-of-{{ section.id }} .cta { flex-direction:column; align-items:stretch; text-align:center; }
    #fc-of-{{ section.id }} .wa { justify-content:center; min-height:48px; }
    #fc-of-{{ section.id }} .ig, #fc-of-{{ section.id }} .send { min-height:52px; }
    #fc-of-{{ section.id }} .fcard { padding:22px 16px; }
  }
  /* Movil: secciones de 3 productos como carrusel deslizable (la siguiente ficha asoma) */
  @media (max-width:760px){
    #fc-of-{{ section.id }} .grid--3 { display:flex; flex-wrap:nowrap; flex-direction:row; column-gap:12px; row-gap:0; gap:12px; overflow-x:auto; scroll-snap-type:x mandatory; -webkit-overflow-scrolling:touch; margin:0 -16px; padding:2px 16px 8px; scroll-padding-left:16px; scrollbar-width:none; }
    #fc-of-{{ section.id }} .grid--3::-webkit-scrollbar { display:none; }
    #fc-of-{{ section.id }} .grid--3 > * { flex:0 0 68%; scroll-snap-align:start; }
  }
  @media (prefers-reduced-motion:reduce){
    #fc-of-{{ section.id }} *, #fc-of-{{ section.id }}::before, #fc-of-{{ section.id }} .win-box { animation:none !important; }
    #fc-of-{{ section.id }} .ship-track { flex-wrap:wrap; width:auto; justify-content:center; }
  }
</style>

<div id="fc-of-{{ section.id }}" data-start="{{ start_iso }}" data-end="{{ end_iso }}">

  <section class="hero">
    <div class="w">
      <span class="eyebrow">{{ section.settings.eyebrow | default: 'Semana de inauguración' }}</span>
      <h1>{{ section.settings.title | default: 'Ofertas de apertura' }}</h1>
      <p class="sub">{{ section.settings.subtitle | default: 'Marcas originales importadas de EE.UU. a precio de inauguración. El descuento se aplica solo en tu carrito, sin cupones.' }}</p>
      <a class="hero-gift" href="#premios"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="9" width="18" height="4" rx="1"/><path d="M5 13v7a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-7"/><path d="M12 9v12"/><path d="M12 9C11 6 9.2 5.2 7.8 5.9 6.6 6.5 7.2 8.4 9 9"/><path d="M12 9c1-3 2.8-3.8 4.2-3.1C17.4 6.5 16.8 8.4 15 9"/></svg>{{ section.settings.hero_gift_label | default: 'Participa por combos de regalo' }}</a>
      <div class="clock-wrap" data-clock hidden>
        <span class="clock-l" data-clock-label>Termina en</span>
        <div class="clock" role="timer" aria-live="off">
          <div class="u"><b data-d>00</b><small>Días</small></div>
          <div class="u"><b data-h>00</b><small>Horas</small></div>
          <div class="u"><b data-m>00</b><small>Min</small></div>
          <div class="u"><b data-s>00</b><small>Seg</small></div>
        </div>
      </div>
    </div>
  </section>

  {%- capture ship_item -%}
    <span class="ship-it">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M1 3h13v13H1z"/><path d="M14 8h4l4 4v4h-8z"/><circle cx="5.5" cy="18.5" r="2"/><circle cx="18.5" cy="18.5" r="2"/></svg>
      Envío gratis en Valera
      <small>{{ ship_days }} día{% if ship_days != 1 %}s{% endif %}</small>
      <span>Sin mínimo de compra</span>
      <i>●</i>
    </span>
  {%- endcapture -%}
  <div class="ship" role="region" aria-label="Envío gratis en Valera por {{ ship_days }} días">
    <div class="ship-track">
      <div class="ship-grp">{{ ship_item }}{{ ship_item }}{{ ship_item }}</div>
      <div class="ship-grp" aria-hidden="true">{{ ship_item }}{{ ship_item }}{{ ship_item }}</div>
    </div>
  </div>

  <section class="sec win" id="premios">
    <div class="w">
     <div class="win-box">
      <div class="win-head">
        <span class="win-ico" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="9" width="18" height="4" rx="1"/><path d="M5 13v7a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-7"/><path d="M12 9v12"/><path d="M12 9C11 6 9.2 5.2 7.8 5.9 6.6 6.5 7.2 8.4 9 9"/><path d="M12 9c1-3 2.8-3.8 4.2-3.1C17.4 6.5 16.8 8.4 15 9"/></svg></span>
        <span class="tag tag--p">{{ section.settings.prize_eyebrow | default: 'Sorteo de inauguración' }}</span>
        <h2>{{ section.settings.prize_heading | default: 'Gana estos <em>combos</em> de regalo' }}</h2>
