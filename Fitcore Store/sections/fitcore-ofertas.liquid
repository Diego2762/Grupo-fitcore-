            <p class="prize-p">{{ p_text }}</p>
          </div>
        {%- endfor -%}
      </div>

      <div class="reg">
        <button type="button" class="reg-btn" id="fc-reg-btn-{{ section.id }}" aria-expanded="false" aria-controls="fc-form-card-{{ section.id }}">{{ section.settings.register_label | default: 'Regístrate y participa' }}</button>
      </div>

      <div class="fcard" id="fc-form-card-{{ section.id }}" hidden>
        <div class="fview">
          <h3>{{ section.settings.form_title | default: 'Participa por los premios' }}</h3>
          <p class="fsub">{{ section.settings.form_subtitle | default: 'Déjanos tus datos y sigue a @fitcore.ve. El ganador se anuncia el día después de la inauguración.' }}</p>

          <form id="fc-lead-form-{{ section.id }}" novalidate>
            <div class="fld-row">
              <div class="fld">
                <label for="fc-first-{{ section.id }}">Nombre</label>
