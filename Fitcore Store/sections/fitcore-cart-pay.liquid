{%- comment -%}
  Fitcore Store · Carrito B2C (Plan B)
  - Barra de progreso a envío gratis (compras sobre el umbral, aplica a entrega local).
  - El precio del carrito (variant.price) ES el precio en bolívares BCV: es lo que se factura.
  - En divisa el cliente aplica el cupón MEJORPRECIO en el checkout: divisa = BCV / 1.15 (= precio PV, gancho .99).
  - Selector "¿Cómo quieres recibir tu pedido?" (nacional / local / retiro).
    Los campos cambian según la opción. Se guardan como atributos del carrito.
{%- endcomment -%}

{%- liquid
  assign discount = section.settings.divisa_discount_pct | default: 13
  assign threshold = section.settings.free_ship_threshold | default: 30
  assign threshold_cents = threshold | times: 100
  assign base = cart.original_total_price
  assign remaining = threshold_cents | minus: base
  assign divisa_total = base | times: 100 | divided_by: 115
  assign progress = base | times: 100 | divided_by: threshold_cents
  if progress > 100
    assign progress = 100
  endif
  assign current_method = cart.attributes['Método de pago']
  assign current_delivery = cart.attributes['Método de entrega']
  assign current_agency = cart.attributes['Agencia de envío']
  assign current_cedula = cart.attributes['Cédula']
  assign current_phone = cart.attributes['Teléfono / WhatsApp']
  assign current_company = cart.attributes['Empresa de envío']
  assign current_ref = cart.attributes['Referencia de entrega']
  assign current_apt = cart.attributes['Casa/Apto N°']
  assign current_urb = cart.attributes['Urbanización / Sector']
  assign current_location = cart.attributes['Ubicación (mapa)']
  assign is_bs = false
  if current_method == 'Bolívares BCV (Pago Móvil / Transferencia)'
    assign is_bs = true
  endif
  assign is_nac = false
  if current_delivery == 'Envío nacional (fuera de Trujillo)'
    assign is_nac = true
  endif
  assign is_local = false
  if current_delivery == 'Entrega local (Valera y Trujillo)'
    assign is_local = true
  endif
-%}

<style>
  #fc-pay-{{ section.id }} {
    --fc-navy:#0B1840; --fc-purple:#3B1F6B; --fc-accent:#19C37D; --fc-line:#e7eaf2; --fc-muted:#56607a;
    max-width:1300px; margin:0 auto; padding: 4px 22px 8px;
    font-family: var(--font-body-family, sans-serif);
  }
  #fc-pay-{{ section.id }} .fc-pay-ship { position:relative; overflow:hidden; background:#fff; border:1.5px solid var(--fc-line); border-radius:16px; padding:16px 20px; margin-bottom:16px; transition:border-color .3s, background .3s; }
  #fc-pay-{{ section.id }} .fc-pay-ship b { color:var(--fc-navy); font-weight:700; }
  #fc-pay-{{ section.id }} .fc-pay-ship .fc-pay-ship-msg { font-size:14px; color:var(--fc-navy); margin:0 0 10px; display:flex; align-items:center; gap:9px; flex-wrap:wrap; }
  #fc-pay-{{ section.id }} .fc-ship-amt { color:#b26a00; }
  #fc-pay-{{ section.id }} .fc-pay-track { height:9px; border-radius:99px; background:#eef0f6; overflow:hidden; }
  #fc-pay-{{ section.id }} .fc-pay-fill { display:block; height:100%; min-width:6px; border-radius:99px; background:linear-gradient(90deg,#f5a623,#ffbe4d); transition:width .5s ease, background .3s; position:relative; }

  /* Estado: envío gratis conseguido */
  #fc-pay-{{ section.id }} .fc-pay-ship.is-free { border-color:#8fe3b8; background:linear-gradient(180deg,#f0fbf5,#e7f9f0); animation:fcFreePop .6s cubic-bezier(.18,.89,.32,1.28) both; }
  #fc-pay-{{ section.id }} .fc-pay-ship.is-free .fc-pay-ship-msg { color:#0a7d3f; }
  #fc-pay-{{ section.id }} .fc-pay-ship.is-free .fc-pay-fill { background:linear-gradient(90deg,#12a866,#19C37D); }
  #fc-pay-{{ section.id }} .fc-pay-ship.is-free .fc-pay-fill::after { content:""; position:absolute; inset:0; background:linear-gradient(120deg,transparent 25%,rgba(255,255,255,.6) 50%,transparent 75%); transform:translateX(-100%); animation:fcShine 1.8s ease-in-out .35s infinite; }
  #fc-pay-{{ section.id }} .fc-free-badge { display:inline-flex; align-items:center; gap:6px; background:var(--fc-accent); color:#062b1a; font-weight:800; font-size:12.5px; letter-spacing:.2px; padding:5px 11px; border-radius:99px; white-space:nowrap; box-shadow:0 2px 8px rgba(25,195,125,.35); animation:fcBadgePop .6s .12s cubic-bezier(.18,.89,.32,1.5) both; }
  #fc-pay-{{ section.id }} .fc-free-badge svg { width:15px; height:15px; }
  #fc-pay-{{ section.id }} .fc-free-badge::before { content:""; position:absolute; }
  #fc-pay-{{ section.id }} .fc-pay-ship.is-free::before { content:""; position:absolute; top:0; left:0; right:0; height:3px; background:linear-gradient(90deg,#12a866,#19C37D,#7ef0b8); animation:fcSweep 1.8s ease-in-out infinite; }
  @keyframes fcFreePop { 0%{ transform:scale(.985); } 55%{ transform:scale(1.012); } 100%{ transform:scale(1); } }
  @keyframes fcBadgePop { 0%{ transform:scale(0); opacity:0; } 70%{ transform:scale(1.15); opacity:1; } 100%{ transform:scale(1); } }
  @keyframes fcShine { to{ transform:translateX(100%); } }
  @keyframes fcSweep { 0%{ opacity:.4; } 50%{ opacity:1; } 100%{ opacity:.4; } }
  @media (prefers-reduced-motion:reduce){ #fc-pay-{{ section.id }} .fc-pay-ship.is-free, #fc-pay-{{ section.id }} .fc-free-badge, #fc-pay-{{ section.id }} .fc-pay-ship.is-free .fc-pay-fill::after, #fc-pay-{{ section.id }} .fc-pay-ship.is-free::before { animation:none; } }
  #fc-pay-{{ section.id }} .fc-pay-box { background:#fff; border:1px solid var(--fc-line); border-radius:16px; padding:20px; }
  #fc-pay-{{ section.id }} .fc-pay-title { color:var(--fc-navy); font:700 16px/1.3 var(--font-body-family,sans-serif); margin:0 0 4px; }
  #fc-pay-{{ section.id }} .fc-pay-sub { color:var(--fc-muted); font-size:13px; margin:0 0 14px; }
  #fc-pay-{{ section.id }} .fc-pay-opts { display:grid; gap:10px; }
  #fc-pay-{{ section.id }} .fc-pay-opt { display:flex; align-items:center; gap:12px; border:1.5px solid var(--fc-line); border-radius:12px; padding:13px 15px; cursor:pointer; transition:border-color .15s, background .15s; }
  #fc-pay-{{ section.id }} .fc-pay-opt:hover { border-color:#c9cee0; }
  #fc-pay-{{ section.id }} .fc-pay-opt input { accent-color:var(--fc-purple); width:18px; height:18px; flex:0 0 auto; }
  #fc-pay-{{ section.id }} .fc-pay-opt.is-on { border-color:var(--fc-accent); background:#f2fbf6; }
  #fc-pay-{{ section.id }} .fc-pay-opt .fc-pay-lbl { color:var(--fc-navy); font-weight:700; font-size:14.5px; line-height:1.2; }
  #fc-pay-{{ section.id }} .fc-pay-opt .fc-pay-hint { color:var(--fc-muted); font-size:12.5px; margin-top:2px; }
  #fc-pay-{{ section.id }} .fc-pay-badge { margin-left:auto; background:var(--fc-accent); color:#071631; font-weight:700; font-size:12px; padding:5px 9px; border-radius:8px; white-space:nowrap; }
  #fc-pay-{{ section.id }} .fc-pay-badge--up { background:#fff3e0; color:#9a5b00; border:1px solid #ffd8a1; }
  #fc-pay-{{ section.id }} .fc-pay-badge--info { background:#eef1fb; color:#3b3f6b; border:1px solid #d8ddf5; }
  #fc-pay-{{ section.id }} .fc-pay-totals { margin-top:14px; padding-top:14px; border-top:1px dashed var(--fc-line); display:grid; gap:9px; }
  #fc-pay-{{ section.id }} .fc-pay-trow { display:flex; align-items:baseline; justify-content:space-between; gap:12px; padding:11px 14px; border:1.5px solid var(--fc-line); border-radius:12px; transition:border-color .15s, background .15s; }
  #fc-pay-{{ section.id }} .fc-pay-trow.is-sel { border-color:var(--fc-accent); background:#f2fbf6; }
  #fc-pay-{{ section.id }} .fc-pay-trow-lbl { color:var(--fc-muted); font-size:13.5px; line-height:1.25; }
  #fc-pay-{{ section.id }} .fc-pay-trow-lbl small { display:block; font-size:11.5px; opacity:.85; }
  #fc-pay-{{ section.id }} .fc-pay-trow b { color:var(--fc-navy); font-size:19px; font-weight:700; white-space:nowrap; }
  #fc-pay-{{ section.id }} .fc-pay-trow.is-sel .fc-pay-trow-lbl { color:var(--fc-navy); }
  #fc-pay-{{ section.id }} .fc-pay-trow.is-sel b { color:#0a7d3f; }
  #fc-pay-{{ section.id }} .fc-pay-trow-pill { margin-left:auto; margin-right:10px; background:var(--fc-accent); color:#062b1a; font-weight:800; font-size:11px; padding:3px 8px; border-radius:99px; white-space:nowrap; }
  #fc-pay-{{ section.id }} .fc-pay-note { color:var(--fc-muted); font-size:12px; margin:10px 0 0; }
  #fc-pay-{{ section.id }} .fc-pay-note[hidden] { display:none; }
  #fc-pay-{{ section.id }} .fc-pay-note b { color:var(--fc-navy); }
  #fc-pay-{{ section.id }} .fc-pay-title--sep { border-top:1px solid var(--fc-line); margin-top:24px; padding-top:22px; }
  #fc-pay-{{ section.id }} .fc-ship-grid { display:grid; grid-template-columns:1fr 1fr; gap:13px; margin-top:16px; }
  #fc-pay-{{ section.id }} .fc-ship-field { display:flex; flex-direction:column; }
  #fc-pay-{{ section.id }} .fc-ship-field.fc-span2 { grid-column:1 / -1; }
  #fc-pay-{{ section.id }} .fc-ship-field label { color:var(--fc-navy); font-weight:700; font-size:13px; margin-bottom:6px; }
  #fc-pay-{{ section.id }} .fc-ship-field input,
  #fc-pay-{{ section.id }} .fc-ship-field select { width:100%; border:1.5px solid var(--fc-line); border-radius:10px; padding:11px 13px; font-size:14px; color:var(--fc-navy); background:#fff; }
  #fc-pay-{{ section.id }} .fc-ship-field input:focus,
  #fc-pay-{{ section.id }} .fc-ship-field select:focus { outline:none; border-color:var(--fc-purple); }
  #fc-pay-{{ section.id }} .fc-nat-wrap { display:contents; }
  #fc-pay-{{ section.id }} .fc-nat-wrap.is-off { display:none; }
  #fc-pay-{{ section.id }} .fc-ship-saved { color:#0a7d3f; font-size:12px; font-weight:700; margin:12px 0 0; opacity:0; transition:opacity .2s; }
  #fc-pay-{{ section.id }} .fc-ship-saved.is-on { opacity:1; }
  #fc-pay-{{ section.id }} .fc-local-wrap { margin-top:16px; }
  #fc-pay-{{ section.id }} .fc-local-wrap.is-off { display:none; }
  #fc-pay-{{ section.id }} .fc-map-head { display:flex; align-items:center; justify-content:space-between; gap:12px; flex-wrap:wrap; margin-bottom:10px; }
  #fc-pay-{{ section.id }} .fc-map-title { color:var(--fc-navy); font-weight:700; font-size:14px; }
  #fc-pay-{{ section.id }} .fc-map-title .fc-req { color:#d4380d; }
  #fc-pay-{{ section.id }} .fc-map-geo { display:inline-flex; align-items:center; gap:7px; background:var(--fc-navy); color:#fff; border:0; border-radius:10px; padding:9px 14px; font-size:13px; font-weight:700; cursor:pointer; transition:background .15s; }
  #fc-pay-{{ section.id }} .fc-map-geo:hover { background:var(--fc-purple); }
  #fc-pay-{{ section.id }} .fc-map-geo svg { width:16px; height:16px; }
  #fc-pay-{{ section.id }} .fc-map-box { position:relative; }
  #fc-pay-{{ section.id }} .fc-map { width:100%; height:240px; border-radius:14px; border:1.5px solid var(--fc-line); overflow:hidden; background:#eef1f6; z-index:0; }
  #fc-pay-{{ section.id }} .fc-map .leaflet-control-attribution { font-size:9px; }
  #fc-pay-{{ section.id }} .fc-map-pin { position:absolute; left:50%; top:50%; transform:translate(-50%,-100%); z-index:500; pointer-events:none; color:#d4380d; width:40px; height:40px; filter:drop-shadow(0 3px 4px rgba(0,0,0,.35)); transition:transform .12s ease; }
  #fc-pay-{{ section.id }} .fc-map-pin svg { width:100%; height:100%; display:block; }
  #fc-pay-{{ section.id }} .fc-map-box.is-moving .fc-map-pin { transform:translate(-50%,-115%); }
  #fc-pay-{{ section.id }} .fc-map-hint { color:var(--fc-muted); font-size:12.5px; margin:8px 0 10px; }
  #fc-pay-{{ section.id }} .fc-map-hint.is-warn { color:#d4380d; font-weight:700; }
  #fc-pay-{{ section.id }} .fc-map-hint.is-ok { color:#0a7d3f; font-weight:700; }
  #fc-pay-{{ section.id }} .fc-map-confirm { width:100%; border:0; border-radius:11px; padding:14px; font-size:15px; font-weight:800; cursor:pointer; background:var(--fc-navy); color:#fff; transition:background .15s,transform .08s; margin-bottom:14px; }
  #fc-pay-{{ section.id }} .fc-map-confirm:hover { background:var(--fc-purple); }
  #fc-pay-{{ section.id }} .fc-map-confirm:active { transform:scale(.99); }
  #fc-pay-{{ section.id }} .fc-map-confirm.is-done { background:var(--fc-accent); color:#062b1a; }
  #fc-pay-{{ section.id }} .fc-local-grid { margin-top:0; }
  @media (max-width:780px){ #fc-pay-{{ section.id }} { padding:4px 16px 8px; } }
</style>

<div id="fc-pay-{{ section.id }}"
  data-base-money="{{ base | money }}"
  data-divisa-money="{{ divisa_total | money }}"
  data-discount="{{ discount }}"
  data-threshold-cents="{{ threshold_cents }}">

  <div class="fc-pay-ship{% if remaining <= 0 %} is-free{% endif %}">
    {%- if remaining > 0 -%}
      <p class="fc-pay-ship-msg"><span>Te faltan <b class="fc-ship-amt">{{ remaining | money }}</b> para <b>entrega local gratis en Valera y Trujillo</b> (compras desde {{ threshold_cents | money }}).</span></p>
    {%- else -%}
      <p class="fc-pay-ship-msg free"><span class="fc-free-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>¡Envío gratis!</span> <span><b>Tienes entrega local gratis en Valera y Trujillo.</b> También puedes retirar gratis en la tienda del CC Plaza.</span></p>
    {%- endif -%}
    <div class="fc-pay-track"><div class="fc-pay-fill" style="width:{{ progress }}%"></div></div>
  </div>

  <div class="fc-pay-box">
    <p class="fc-pay-title">¿Con qué vas a pagar?</p>
    <p class="fc-pay-sub">Elige tu forma de pago para ver el total. Aquí abajo puedes comparar ambos precios de una vez.</p>

    <div class="fc-pay-opts" data-pay-opts>
      <label class="fc-pay-opt{% unless is_bs %} is-on{% endunless %}" data-method="divisa">
        <input type="radio" name="fc-pay-{{ section.id }}" value="divisa"{% unless is_bs %} checked{% endunless %}>
        <span>
          <span class="fc-pay-lbl">Divisa: Zelle, efectivo o tarjeta</span>
          <span class="fc-pay-hint">El mejor precio. El descuento se aplica <b>solo al pagar</b>.</span>
        </span>
        <span class="fc-pay-badge">Mejor precio</span>
      </label>

      <label class="fc-pay-opt{% if is_bs %} is-on{% endif %}" data-method="bs">
        <input type="radio" name="fc-pay-{{ section.id }}" value="bs"{% if is_bs %} checked{% endif %}>
        <span>
          <span class="fc-pay-lbl">Bolívares BCV: Pago Móvil o Transferencia</span>
          <span class="fc-pay-hint">A la tasa BCV del día al confirmar.</span>
        </span>
      </label>
    </div>

    <div class="fc-pay-totals">
      <div class="fc-pay-trow{% unless is_bs %} is-sel{% endunless %}" data-trow="divisa">
        <span class="fc-pay-trow-lbl">Total en divisa <small>descuento ya incluido</small></span>
        <span class="fc-pay-trow-pill">Mejor precio</span>
        <b>{{ divisa_total | money }}</b>
      </div>
      <div class="fc-pay-trow{% if is_bs %} is-sel{% endif %}" data-trow="bs">
        <span class="fc-pay-trow-lbl">Total en bolívares <small>BCV, tasa del día</small></span>
        <b>{{ base | money }}</b>
      </div>
    </div>

    <p class="fc-pay-note">El total en bolívares BCV es el que se factura, a la <b>tasa BCV del día</b>. Si pagas en divisa, el <b>descuento se aplica automáticamente</b> al pasar a pagar. Tu forma de pago queda anotada en el pedido para el personal de la tienda.</p>

    <p class="fc-pay-title fc-pay-title--sep">¿Cómo quieres recibir tu pedido?</p>
    <p class="fc-pay-sub">Elige una opción y déjanos tus datos. La dirección y el pago los confirmas en el siguiente paso.</p>

    <div class="fc-pay-opts fc-recv-opts">
      <label class="fc-pay-opt{% if is_nac %} is-on{% endif %}" data-recv="nacional">
        <input type="radio" name="fc-recv-{{ section.id }}" value="nacional"{% if is_nac %} checked{% endif %}>
        <span>
          <span class="fc-pay-lbl">Envío nacional (fuera de Trujillo)</span>
          <span class="fc-pay-hint">Zoom, MRW o Tealca. Llega en 1 a 2 días. Flete por cobrar en destino.</span>
        </span>
        <span class="fc-pay-badge fc-pay-badge--info">1-2 días</span>
      </label>

      <label class="fc-pay-opt{% if current_delivery == 'Entrega local (Valera y Trujillo)' %} is-on{% endif %}" data-recv="local">
        <input type="radio" name="fc-recv-{{ section.id }}" value="local"{% if current_delivery == 'Entrega local (Valera y Trujillo)' %} checked{% endif %}>
        <span>
          <span class="fc-pay-lbl">Entrega local (Valera y Trujillo)</span>
          <span class="fc-pay-hint">Te lo llevamos a tu dirección. Gratis en compras desde {{ threshold_cents | money }}.</span>
        </span>
        <span class="fc-pay-badge fc-pay-badge--up">Desde $3</span>
      </label>

      <label class="fc-pay-opt{% if current_delivery == 'Retiro en tienda (CC Plaza, Valera)' %} is-on{% endif %}" data-recv="retiro">
        <input type="radio" name="fc-recv-{{ section.id }}" value="retiro"{% if current_delivery == 'Retiro en tienda (CC Plaza, Valera)' %} checked{% endif %}>
        <span>
          <span class="fc-pay-lbl">Retiro en tienda (CC Plaza, Valera)</span>
          <span class="fc-pay-hint">Recoge tu pedido cuando quieras. Sin costo.</span>
        </span>
        <span class="fc-pay-badge">Gratis</span>
      </label>
    </div>

    <div class="fc-ship-grid">
      <div class="fc-ship-field">
        <label for="fc-cedula-{{ section.id }}">Cédula</label>
        <input type="text" id="fc-cedula-{{ section.id }}" data-attr="Cédula" placeholder="Ej. V-12345678" value="{{ current_cedula | escape }}">
      </div>
      <div class="fc-ship-field">
        <label for="fc-phone-{{ section.id }}">Teléfono / WhatsApp</label>
        <input type="tel" id="fc-phone-{{ section.id }}" data-attr="Teléfono / WhatsApp" placeholder="Ej. 0412 1234567" value="{{ current_phone | escape }}">
      </div>

      <div class="fc-nat-wrap{% unless is_nac %} is-off{% endunless %}" data-nat-wrap>
        <div class="fc-ship-field">
          <label for="fc-company-{{ section.id }}">Empresa de envío</label>
          <select id="fc-company-{{ section.id }}" data-attr="Empresa de envío">
            <option value=""{% if current_company == blank %} selected{% endif %}>Selecciona una</option>
            <option value="Tealca"{% if current_company == 'Tealca' %} selected{% endif %}>Tealca</option>
            <option value="Zoom"{% if current_company == 'Zoom' %} selected{% endif %}>Zoom</option>
            <option value="MRW"{% if current_company == 'MRW' %} selected{% endif %}>MRW</option>
          </select>
        </div>
        <div class="fc-ship-field fc-span2">
          <label for="fc-agency-{{ section.id }}">Ciudad y agencia de destino</label>
          <input type="text" id="fc-agency-{{ section.id }}" data-attr="Agencia de envío" placeholder="Ej. Zoom Barquisimeto centro" value="{{ current_agency | escape }}">
        </div>
      </div>
    </div>

    <div class="fc-local-wrap{% unless is_local %} is-off{% endunless %}" data-local-wrap>
      <div class="fc-map-head">
        <span class="fc-map-title">¿Dónde te llevamos el pedido? <b class="fc-req">*</b></span>
        <button type="button" class="fc-map-geo" data-map-geo>
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M12 2v3M12 19v3M2 12h3M19 12h3"/></svg>
          Usar mi ubicación
        </button>
      </div>
      <div class="fc-map-box">
        <div id="fc-map-{{ section.id }}" class="fc-map" data-map data-lat="{{ current_location | split: ',' | first | strip }}" data-lng="{{ current_location | split: ',' | last | strip }}"></div>
        <div class="fc-map-pin" data-map-pin aria-hidden="true">
          <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C8.13 2 5 5.13 5 9c0 5.25 7 13 7 13s7-7.75 7-13c0-3.87-3.13-7-7-7z"/><circle cx="12" cy="9" r="2.5" fill="#fff"/></svg>
        </div>
      </div>
      <p class="fc-map-hint" data-map-hint>Mueve el mapa hasta que el pin quede sobre tu casa y toca “Confirmar dirección”.</p>
      <button type="button" class="fc-map-confirm" data-map-confirm>Confirmar dirección</button>
      <div class="fc-ship-grid fc-local-grid">
        <div class="fc-ship-field">
          <label for="fc-apt-{{ section.id }}">Casa o Apartamento N°</label>
          <input type="text" id="fc-apt-{{ section.id }}" data-attr="Casa/Apto N°" placeholder="Ej. Apto 4-B / Casa 12" value="{{ current_apt | escape }}">
        </div>
        <div class="fc-ship-field">
          <label for="fc-urb-{{ section.id }}">Urbanización / Sector</label>
          <input type="text" id="fc-urb-{{ section.id }}" data-attr="Urbanización / Sector" placeholder="Ej. Urb. La Beatriz" value="{{ current_urb | escape }}">
        </div>
        <div class="fc-ship-field fc-span2">
          <label for="fc-ref-{{ section.id }}">Punto de referencia</label>
          <input type="text" id="fc-ref-{{ section.id }}" data-attr="Referencia de entrega" placeholder="Ej. Casa de portón negro, al lado de la panadería" value="{{ current_ref | escape }}">
        </div>
      </div>
    </div>

    <p class="fc-ship-saved" data-ship-saved>Datos guardados ✓</p>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('fc-pay-{{ section.id }}');
    if (!root) return;
    var payOpts = root.querySelectorAll('[data-pay-opts] .fc-pay-opt');
    var recvOpts = root.querySelectorAll('.fc-recv-opts .fc-pay-opt');
    var natWrap = root.querySelector('[data-nat-wrap]');
    var trows = root.querySelectorAll('[data-trow]');
    var methodLabel = {
      divisa: 'Divisa (Zelle, efectivo o tarjeta)',
      bs: 'Bolívares BCV (Pago Móvil / Transferencia)'
    };
    var recvLabel = {
      nacional: 'Envío nacional (fuera de Trujillo)',
      local: 'Entrega local (Valera y Trujillo)',
      retiro: 'Retiro en tienda (CC Plaza, Valera)'
    };

    function post(body) {
      return fetch('/cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
    }

    function paint(m) {
      payOpts.forEach(function (o) { o.classList.toggle('is-on', o.getAttribute('data-method') === m); });
      trows.forEach(function (t) { t.classList.toggle('is-sel', t.getAttribute('data-trow') === m); });
    }

    payOpts.forEach(function (opt) {
      opt.addEventListener('click', function () {
        var m = opt.getAttribute('data-method');
        var input = opt.querySelector('input');
        if (input) input.checked = true;
        paint(m);
        post({ attributes: { 'Método de pago': methodLabel[m] } });
      });
    });

    // Auto-aplicar el descuento de divisa al pasar al checkout, segun la forma
    // de pago elegida arriba. Divisa => se aplica MEJORPRECIO; Bolivares => se
    // limpia cualquier descuento para facturar el precio BCV completo. El
    // carrito en pantalla NO cambia: el descuento solo se fija en el instante
    // de pagar (nativo /cart/update.js, parametro discount).
    var goingToCheckout = false;
    function selectedMethod() {
      var checked = root.querySelector('[data-pay-opts] input[type="radio"]:checked');
      return checked ? checked.value : 'divisa';
    }
    function selectedDelivery() {
      var checked = root.querySelector('.fc-recv-opts input[type="radio"]:checked');
      return checked ? checked.value : '';
    }
    document.addEventListener('click', function (e) {
      var trigger = e.target && e.target.closest
        ? e.target.closest('button[name="checkout"], #checkout, .cart__checkout-button')
        : null;
      if (!trigger || goingToCheckout) return;
      // Entrega local exige ubicacion en el mapa antes de pagar.
      if (selectedDelivery() === 'local' && !hasLocation) {
        e.preventDefault();
        e.stopPropagation();
        requireLocation();
        return;
      }
      goingToCheckout = true;
      e.preventDefault();
      e.stopPropagation();
      var code = selectedMethod() === 'bs' ? '' : 'MEJORPRECIO';
      var root_path = (window.Shopify && Shopify.routes && Shopify.routes.root) ? Shopify.routes.root : '/';
      function go() { window.location.href = root_path + 'checkout'; }
      post({ discount: code }).then(go).catch(go);
    }, true);

    // Mantener SIEMPRE el carrito en pantalla en precio BCV completo (sin
    // descuento visible), aunque haya quedado MEJORPRECIO de un intento de pago
    // anterior (checkout abandonado). Se limpia al cargar y, si el total ya se
    // habia pintado con descuento, se recarga una sola vez (guarda en
    // sessionStorage evita bucles). El metodo de pago elegido se conserva como
    // atributo, y el descuento se vuelve a fijar al pulsar Pagar.
    (function keepCartClean() {
      try {
        fetch('/cart.js').then(function (r) { return r.json(); }).then(function (c) {
          var hasDisc = c && c.cart_level_discount_applications && c.cart_level_discount_applications.length;
          if (hasDisc) {
            if (sessionStorage.getItem('fcDiscCleared')) return;
            sessionStorage.setItem('fcDiscCleared', '1');
            post({ discount: '' }).then(function () { location.reload(); })
              .catch(function () { sessionStorage.removeItem('fcDiscCleared'); });
          } else {
            sessionStorage.removeItem('fcDiscCleared');
          }
        }).catch(function () {});
      } catch (e) {}
    })();

    var savedMsg = root.querySelector('[data-ship-saved]');
    var savedTimer;
    function flashSaved() {
      if (!savedMsg) return;
      savedMsg.classList.add('is-on');
      clearTimeout(savedTimer);
      savedTimer = setTimeout(function () { savedMsg.classList.remove('is-on'); }, 2200);
    }

    var localWrap = root.querySelector('[data-local-wrap]');
    recvOpts.forEach(function (opt) {
      opt.addEventListener('click', function () {
        var r = opt.getAttribute('data-recv');
        var input = opt.querySelector('input');
        if (input) input.checked = true;
        recvOpts.forEach(function (o) { o.classList.toggle('is-on', o === opt); });
        if (natWrap) natWrap.classList.toggle('is-off', r !== 'nacional');
        if (localWrap) localWrap.classList.toggle('is-off', r !== 'local');
        post({ attributes: { 'Método de entrega': recvLabel[r] } });
        flashSaved();
        if (r === 'local') initMap();
      });
    });

    // ---- Mapa de entrega local (Leaflet + OpenStreetMap) ----
    // Patron de pin fijo al centro (como apps de delivery): el cliente mueve el
    // mapa y el pin central marca el punto. Al tocar "Confirmar direccion" se
    // guardan las coordenadas + link a Google Maps como atributos del pedido.
    // La libreria se carga solo cuando el cliente elige entrega local.
    var VALERA = [9.297655, -70.617916]; // C.C. Plaza, centro de referencia
    var mapEl = root.querySelector('[data-map]');
    var mapBox = root.querySelector('.fc-map-box');
    var mapHint = root.querySelector('[data-map-hint]');
    var geoBtn = root.querySelector('[data-map-geo]');
    var confirmBtn = root.querySelector('[data-map-confirm]');
    var hasLocation = false;
    var map = null, mapReady = false, leafletLoading = false;

    var startLat = parseFloat(mapEl && mapEl.getAttribute('data-lat'));
    var startLng = parseFloat(mapEl && mapEl.getAttribute('data-lng'));
    var hadSaved = (!isNaN(startLat) && !isNaN(startLng));
    if (hadSaved) hasLocation = true; // ya venia confirmada de una sesion previa

    function setConfirmed(on) {
      hasLocation = on;
      if (confirmBtn) {
        confirmBtn.classList.toggle('is-done', on);
        confirmBtn.textContent = on ? 'Dirección confirmada ✓' : 'Confirmar dirección';
      }
      if (mapHint) {
        if (on) {
          mapHint.textContent = 'Dirección confirmada ✓ Si te equivocaste, mueve el mapa y confirma de nuevo.';
          mapHint.classList.add('is-ok'); mapHint.classList.remove('is-warn');
        } else {
          mapHint.textContent = 'Mueve el mapa hasta que el pin quede sobre tu casa y toca “Confirmar dirección”.';
          mapHint.classList.remove('is-ok');
        }
      }
    }

    function confirmLocation() {
      if (!mapReady || !map) { initMap(); return; }
      var c = map.getCenter();
      var pretty = c.lat.toFixed(6) + ', ' + c.lng.toFixed(6);
      var gmaps = 'https://www.google.com/maps?q=' + c.lat.toFixed(6) + ',' + c.lng.toFixed(6);
      setConfirmed(true);
      post({ attributes: { 'Ubicación (mapa)': pretty, 'Ver en mapa': gmaps } }).then(function () { flashSaved(); });
    }

    function requireLocation() {
      var recv = root.querySelector('.fc-recv-opts .fc-pay-opt[data-recv="local"]');
      if (recv) { recv.classList.add('is-on'); }
      if (localWrap) localWrap.classList.remove('is-off');
      initMap();
      if (mapHint) {
        mapHint.textContent = 'Confirma tu dirección en el mapa para continuar con la entrega local.';
        mapHint.classList.add('is-warn'); mapHint.classList.remove('is-ok');
      }
      if (confirmBtn && confirmBtn.scrollIntoView) confirmBtn.scrollIntoView({ behavior: 'smooth', block: 'center' });
    }

    function buildMap() {
      if (mapReady || !mapEl || typeof L === 'undefined') return;
      var center = hadSaved ? [startLat, startLng] : VALERA;
      map = L.map(mapEl, { scrollWheelZoom: false }).setView(center, hadSaved ? 16 : 14);
      L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
        maxZoom: 19,
        attribution: '&copy; OpenStreetMap'
      }).addTo(map);
      // El pin vive fijo al centro (HTML). Cuando el cliente arrastra o hace
      // zoom, se "levanta" y la direccion queda sin confirmar hasta que toque
      // el boton. Solo dragstart/zoomstart (interaccion real), no movimientos
      // programaticos como invalidateSize.
      map.on('dragstart zoomstart', function () {
        if (mapBox) mapBox.classList.add('is-moving');
        if (hasLocation) setConfirmed(false);
      });
      map.on('moveend zoomend', function () {
        if (mapBox) mapBox.classList.remove('is-moving');
      });
      mapReady = true;
      setTimeout(function () { if (map) map.invalidateSize(); }, 200);
      setConfirmed(hadSaved); // estado inicial del boton/hint
    }

    function initMap() {
      if (mapReady) { setTimeout(function () { if (map) map.invalidateSize(); }, 100); return; }
      if (typeof L !== 'undefined') { buildMap(); return; }
      if (leafletLoading) return;
      leafletLoading = true;
      var css = document.createElement('link');
      css.rel = 'stylesheet';
      css.href = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.css';
      document.head.appendChild(css);
      var js = document.createElement('script');
      js.src = 'https://unpkg.com/leaflet@1.9.4/dist/leaflet.js';
      js.onload = function () { buildMap(); };
      document.head.appendChild(js);
    }

    if (confirmBtn) confirmBtn.addEventListener('click', confirmLocation);

    if (geoBtn) {
      geoBtn.addEventListener('click', function () {
        if (!navigator.geolocation) return;
        geoBtn.disabled = true;
        var prev = geoBtn.innerHTML;
        geoBtn.textContent = 'Buscando...';
        navigator.geolocation.getCurrentPosition(function (pos) {
          var lat = pos.coords.latitude, lng = pos.coords.longitude;
          initMap();
          var tries = 0;
          var tryCenter = setInterval(function () {
            tries++;
            if (mapReady && map) {
              clearInterval(tryCenter);
              map.setView([lat, lng], 17);
              setConfirmed(false); // centro el mapa; el cliente confirma
            } else if (tries > 40) {
              clearInterval(tryCenter);
            }
          }, 150);
          geoBtn.disabled = false; geoBtn.innerHTML = prev;
        }, function () {
          geoBtn.disabled = false; geoBtn.innerHTML = prev;
          if (mapHint) { mapHint.textContent = 'No pudimos obtener tu ubicación. Mueve el mapa a mano y confirma.'; mapHint.classList.add('is-warn'); }
        }, { enableHighAccuracy: true, timeout: 10000 });
      });
    }

    // Si el carrito carga ya con entrega local elegida, prepara el mapa.
    if (localWrap && !localWrap.classList.contains('is-off')) initMap();

    var fields = root.querySelectorAll('[data-attr]');
    fields.forEach(function (el) {
      var evt = (el.tagName === 'SELECT') ? 'change' : 'blur';
      el.addEventListener(evt, function () {
        var body = { attributes: {} };
        body.attributes[el.getAttribute('data-attr')] = el.value;
        post(body).then(function () { flashSaved(); });
      });
    });

    // Recalcular el banner de envío gratis y los totales en vivo cuando el
    // cliente agrega, cambia cantidad o quita un producto en la página del
    // carrito (sin recargar). El tema publica el evento 'cart-update'.
    var ship = root.querySelector('.fc-pay-ship');
    var thc = parseInt(root.getAttribute('data-threshold-cents'), 10) || 3000;
    var discount = parseInt(root.getAttribute('data-discount'), 10) || 0;
    var trowDivisa = root.querySelector('[data-trow="divisa"] b');
    var trowBs = root.querySelector('[data-trow="bs"] b');

    function money(cents) {
      return '$' + (cents / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function repaint(base) {
      if (typeof base !== 'number' || isNaN(base)) return;
      // Totales: base = BCV (lo que se factura); divisa = base / 1.15 (= precio PV)
      if (trowDivisa) trowDivisa.textContent = money(Math.round(base * 100 / 115));
      if (trowBs) trowBs.textContent = money(base);
      // Banner de envío gratis
      if (!ship) return;
      var remaining = thc - base;
      var progress = Math.min(100, Math.round(base * 100 / thc));
      var track = '<div class="fc-pay-track"><div class="fc-pay-fill" style="width:' + progress + '%"></div></div>';
      if (remaining > 0) {
        ship.classList.remove('is-free');
        ship.innerHTML = '<p class="fc-pay-ship-msg"><span>Te faltan <b class="fc-ship-amt">' + money(remaining) + '</b> para <b>entrega local gratis en Valera y Trujillo</b> (compras desde ' + money(thc) + ').</span></p>' + track;
      } else {
        ship.classList.add('is-free');
        ship.innerHTML = '<p class="fc-pay-ship-msg free"><span class="fc-free-badge"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>¡Envío gratis!</span> <span><b>Tienes entrega local gratis en Valera y Trujillo.</b> También puedes retirar gratis en la tienda del CC Plaza.</span></p>' + track;
      }
    }

    function baseFromCart(cart) {
      if (!cart) return null;
      if (typeof cart.original_total_price === 'number') return cart.original_total_price;
      if (typeof cart.total_price === 'number') return cart.total_price;
      return null;
    }

    document.addEventListener('DOMContentLoaded', function () {
      if (typeof subscribe !== 'function' || typeof PUB_SUB_EVENTS === 'undefined') return;
      subscribe(PUB_SUB_EVENTS.cartUpdate, function (event) {
        var base = event && event.cartData ? baseFromCart(event.cartData) : null;
        if (base != null) {
          repaint(base);
        } else {
          fetch('/cart.js').then(function (r) { return r.json(); }).then(function (c) { repaint(baseFromCart(c)); }).catch(function () {});
        }
      });
    });
  })();
</script>

{% schema %}
{
  "name": "Fitcore Pago carrito",
  "tag": "section",
  "class": "fitcore-cart-pay",
  "settings": [
    { "type": "range", "id": "divisa_discount_pct", "min": 0, "max": 50, "step": 1, "unit": "%", "label": "Descuento pagando en divisa (cupón MEJORPRECIO)", "default": 13, "info": "Debe coincidir con el porcentaje del cupón MEJORPRECIO en Shopify. El BCV es el precio base facturado." },
    { "type": "number", "id": "free_ship_threshold", "label": "Monto para entrega local gratis (USD)", "default": 30 }
  ],
  "presets": [
    { "name": "Fitcore Pago carrito" }
  ]
}
{% endschema %}
