{%- comment -%}
  FitCore Store · Carrito B2C
  - Barra de envío gratis (compras sobre el umbral).
  - Selector de método de pago: divisas (Zelle/USDT/efectivo) = -25% aplicado al carrito vía código.
    Bs (Pago Móvil/Transferencia) y Tarjeta internacional (Shop Pay) = sin descuento.
  - Campo de agencia de envío (MRW/Tealca), guardado como atributo del carrito.
{%- endcomment -%}

{%- liquid
  assign code = section.settings.discount_code | default: 'DIVISAS25'
  assign pct = section.settings.discount_pct | default: 25
  assign threshold = section.settings.free_ship_threshold | default: 30
  assign threshold_cents = threshold | times: 100
  assign base = cart.original_total_price
  assign remaining = threshold_cents | minus: base
  assign keep = 100 | minus: pct
  assign divisa_total = base | times: keep | divided_by: 100
  assign progress = base | times: 100 | divided_by: threshold_cents
  if progress > 100
    assign progress = 100
  endif
  assign current_method = cart.attributes['Método de pago']
  assign current_agency = cart.attributes['Agencia de envío']
-%}

<style>
  #fc-pay-{{ section.id }} {
    --fc-navy:#0B1840; --fc-purple:#3B1F6B; --fc-accent:#19C37D; --fc-line:#e7eaf2; --fc-muted:#56607a;
    max-width:1300px; margin:0 auto; padding: 4px 22px 8px;
    font-family: var(--font-body-family, sans-serif);
  }
  #fc-pay-{{ section.id }} .fc-pay-ship { background:#fff; border:1px solid var(--fc-line); border-radius:16px; padding:16px 20px; margin-bottom:16px; }
  #fc-pay-{{ section.id }} .fc-pay-ship b { color:var(--fc-navy); font-weight:700; }
  #fc-pay-{{ section.id }} .fc-pay-ship .fc-pay-ship-msg { font-size:14px; color:var(--fc-navy); margin:0 0 10px; }
  #fc-pay-{{ section.id }} .fc-pay-ship .fc-pay-ship-msg.free { color:#0a7d3f; }
  #fc-pay-{{ section.id }} .fc-pay-track { height:8px; border-radius:99px; background:#eef0f6; overflow:hidden; }
  #fc-pay-{{ section.id }} .fc-pay-fill { height:100%; border-radius:99px; background:var(--fc-accent); transition:width .4s ease; }
  #fc-pay-{{ section.id }} .fc-pay-box { background:#fff; border:1px solid var(--fc-line); border-radius:16px; padding:20px; }
  #fc-pay-{{ section.id }} .fc-pay-title { color:var(--fc-navy); font:700 16px/1.3 var(--font-body-family,sans-serif); margin:0 0 4px; }
  #fc-pay-{{ section.id }} .fc-pay-sub { color:var(--fc-muted); font-size:13px; margin:0 0 14px; }
  #fc-pay-{{ section.id }} .fc-pay-opts { display:grid; gap:10px; }
  #fc-pay-{{ section.id }} .fc-pay-opt { display:flex; align-items:center; gap:12px; border:1.5px solid var(--fc-line); border-radius:12px; padding:13px 15px; cursor:pointer; transition:border-color .15s, background .15s; }
  #fc-pay-{{ section.id }} .fc-pay-opt:hover { border-color:#c9cee0; }
  #fc-pay-{{ section.id }} .fc-pay-opt input { accent-color:var(--fc-purple); width:18px; height:18px; flex:0 0 auto; }
  #fc-pay-{{ section.id }} .fc-pay-opt.is-on { border-color:var(--fc-accent); background:#f2fbf6; }
  #fc-pay-{{ section.id }} .fc-pay-opt .fc-pay-lbl { color:var(--fc-navy); font-weight:700; font-size:14.5px; line-height:1.2; }
  #fc-pay-{{ section.id }} .fc-pay-opt .fc-pay-hint { color:var(--fc-muted); font-size:12.5px; margin-top:2px; }
  #fc-pay-{{ section.id }} .fc-pay-badge { margin-left:auto; background:var(--fc-accent); color:#071631; font-weight:700; font-size:12px; padding:5px 9px; border-radius:8px; white-space:nowrap; }
  #fc-pay-{{ section.id }} .fc-pay-total { margin-top:14px; padding-top:14px; border-top:1px dashed var(--fc-line); display:flex; align-items:baseline; justify-content:space-between; }
  #fc-pay-{{ section.id }} .fc-pay-total span { color:var(--fc-muted); font-size:13.5px; }
  #fc-pay-{{ section.id }} .fc-pay-total b { color:var(--fc-navy); font-size:20px; font-weight:700; }
  #fc-pay-{{ section.id }} .fc-pay-total .fc-pay-off { color:#0a7d3f; font-weight:700; font-size:13px; }
  #fc-pay-{{ section.id }} .fc-pay-agency { margin-top:16px; }
  #fc-pay-{{ section.id }} .fc-pay-agency label { display:block; color:var(--fc-navy); font-weight:700; font-size:13.5px; margin-bottom:6px; }
  #fc-pay-{{ section.id }} .fc-pay-agency input { width:100%; border:1.5px solid var(--fc-line); border-radius:10px; padding:11px 13px; font-size:14px; color:var(--fc-navy); }
  #fc-pay-{{ section.id }} .fc-pay-agency input:focus { outline:none; border-color:var(--fc-purple); }
  #fc-pay-{{ section.id }} .fc-pay-note { color:var(--fc-muted); font-size:12px; margin:10px 0 0; }
  #fc-pay-{{ section.id }} .fc-pay-busy { opacity:.55; pointer-events:none; }
  @media (max-width:780px){ #fc-pay-{{ section.id }} { padding:4px 16px 8px; } }
</style>

<div id="fc-pay-{{ section.id }}"
  data-code="{{ code }}"
  data-threshold="{{ threshold_cents }}"
  data-keep="{{ keep }}">

  <div class="fc-pay-ship">
    {%- if remaining > 0 -%}
      <p class="fc-pay-ship-msg">Te faltan <b>{{ remaining | money }}</b> para <b>envío gratis en Valera y sus alrededores</b> (compras desde {{ threshold_cents | money }}).</p>
    {%- else -%}
      <p class="fc-pay-ship-msg free"><b>¡Tienes envío gratis en Valera y sus alrededores!</b> También puedes retirar en la tienda del CC Plaza.</p>
    {%- endif -%}
    <div class="fc-pay-track"><div class="fc-pay-fill" style="width:{{ progress }}%"></div></div>
  </div>

  <div class="fc-pay-box">
    <p class="fc-pay-title">¿Cómo vas a pagar?</p>
    <p class="fc-pay-sub">Elige tu método y el total se ajusta al instante. Coordinamos el pago al confirmar tu pedido.</p>

    <div class="fc-pay-opts">
      <label class="fc-pay-opt{% if current_method == 'Divisas (Zelle / USDT / efectivo)' %} is-on{% endif %}" data-method="divisa">
        <input type="radio" name="fc-pay-{{ section.id }}" value="divisa"{% if current_method == 'Divisas (Zelle / USDT / efectivo)' %} checked{% endif %}>
        <span>
          <span class="fc-pay-lbl">Divisas: Zelle, USDT o efectivo</span>
          <span class="fc-pay-hint">El mejor precio. Pago en dólares.</span>
        </span>
        <span class="fc-pay-badge">−{{ pct }}%</span>
      </label>

      <label class="fc-pay-opt{% if current_method == 'Bolívares (Pago Móvil / Transferencia)' %} is-on{% endif %}" data-method="bs">
        <input type="radio" name="fc-pay-{{ section.id }}" value="bs"{% if current_method == 'Bolívares (Pago Móvil / Transferencia)' %} checked{% endif %}>
        <span>
          <span class="fc-pay-lbl">Bolívares: Pago Móvil o Transferencia</span>
          <span class="fc-pay-hint">A la tasa del día al confirmar.</span>
        </span>
      </label>

      <label class="fc-pay-opt{% if current_method == 'Tarjeta internacional (Shop Pay)' %} is-on{% endif %}" data-method="card">
        <input type="radio" name="fc-pay-{{ section.id }}" value="card"{% if current_method == 'Tarjeta internacional (Shop Pay)' %} checked{% endif %}>
        <span>
          <span class="fc-pay-lbl">Tarjeta internacional</span>
          <span class="fc-pay-hint">Pago seguro con Shop Pay.</span>
        </span>
      </label>
    </div>

    <div class="fc-pay-total">
      <span>Total pagando en divisas</span>
      <b>{{ divisa_total | money }} <span class="fc-pay-off">−{{ pct }}%</span></b>
    </div>

    <div class="fc-pay-agency">
      <label for="fc-agency-{{ section.id }}">Agencia de envío (MRW / Tealca, opcional)</label>
      <input type="text" id="fc-agency-{{ section.id }}" placeholder="Ej. MRW Valera centro" value="{{ current_agency | escape }}">
    </div>

    <p class="fc-pay-note">El descuento por divisas se aplica automáticamente al total de tu carrito. Verás el precio final antes de pagar.</p>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('fc-pay-{{ section.id }}');
    if (!root) return;
    var code = root.getAttribute('data-code');
    var opts = root.querySelectorAll('.fc-pay-opt');
    var agency = document.getElementById('fc-agency-{{ section.id }}');
    var methodLabel = {
      divisa: 'Divisas (Zelle / USDT / efectivo)',
      bs: 'Bolívares (Pago Móvil / Transferencia)',
      card: 'Tarjeta internacional (Shop Pay)'
    };

    function post(body) {
      return fetch('/cart/update.js', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(body)
      });
    }

    opts.forEach(function (opt) {
      opt.addEventListener('click', function () {
        var m = opt.getAttribute('data-method');
        var input = opt.querySelector('input');
        if (input) input.checked = true;
        opts.forEach(function (o) { o.classList.toggle('is-on', o === opt); });
        root.classList.add('fc-pay-busy');
        var body = { attributes: { 'Método de pago': methodLabel[m] } };
        body.discount = (m === 'divisa') ? code : '';
        post(body).then(function () { window.location.reload(); })
          .catch(function () { root.classList.remove('fc-pay-busy'); });
      });
    });

    if (agency) {
      agency.addEventListener('change', function () {
        post({ attributes: { 'Agencia de envío': agency.value } });
      });
    }
  })();
</script>

{% schema %}
{
  "name": "FitCore Pago carrito",
  "tag": "section",
  "class": "fitcore-cart-pay",
  "settings": [
    { "type": "text", "id": "discount_code", "label": "Código de descuento por divisas", "default": "DIVISAS25", "info": "Debe existir en Descuentos y estar activo." },
    { "type": "range", "id": "discount_pct", "min": 5, "max": 50, "step": 1, "unit": "%", "label": "Porcentaje de descuento en divisas", "default": 25 },
    { "type": "number", "id": "free_ship_threshold", "label": "Monto para envío gratis (USD)", "default": 30 }
  ],
  "presets": [
    { "name": "FitCore Pago carrito" }
  ]
}
{% endschema %}
