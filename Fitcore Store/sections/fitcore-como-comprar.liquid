{%- comment -%}
  Fitcore Store · Página "Cómo comprar" (B2C) · versión value-stack + dinamismo
{%- endcomment -%}

{%- liquid
  assign wa = section.settings.whatsapp | default: '584246218863'
  assign wa_msg = section.settings.whatsapp_msg | default: 'Hola Fitcore Store, quiero hacer un pedido'
  assign wa_msg_enc = wa_msg | url_encode
  assign catalog_url = section.settings.catalog_url | default: '/collections/all'
-%}

<style>
  #fc-cc-{{ section.id }} { --fc-navy:#0B1840; --fc-purple:#3B1F6B; --fc-accent:#19C37D; --fc-darker:#071631; --fc-line:#e7eaf2; --fc-muted:#56607a; }
  #fc-cc-{{ section.id }} .fc-wrap { max-width:1140px; margin:0 auto; padding:0 22px; }

  /* HERO */
  #fc-cc-{{ section.id }} .fc-cc-hero { position:relative; overflow:hidden; color:#fff; padding:clamp(56px,7vw,86px) 0; background:radial-gradient(720px 420px at 12% -20%, rgba(59,31,107,.85) 0%, transparent 62%), linear-gradient(120deg, var(--fc-navy) 0%, var(--fc-purple) 100%); }
  #fc-cc-{{ section.id }} .fc-cc-hero:before { content:""; position:absolute; inset:0; background:radial-gradient(circle at 84% 22%, rgba(25,195,125,.28), transparent 46%); pointer-events:none; }
  #fc-cc-{{ section.id }} .fc-cc-hero .fc-wrap { position:relative; z-index:2; }
  #fc-cc-{{ section.id }} .fc-cc-eyebrow { display:inline-flex; align-items:center; gap:8px; background:rgba(25,195,125,.14); border:1px solid rgba(25,195,125,.4); color:#7ff0bd; font:700 12px/1 var(--font-body-family,sans-serif); letter-spacing:.06em; text-transform:uppercase; padding:9px 15px; border-radius:999px; margin:0 0 20px; }
  #fc-cc-{{ section.id }} .fc-cc-eyebrow svg { width:14px; height:14px; }
  #fc-cc-{{ section.id }} .fc-cc-hero h1 { font-family:var(--font-heading-family,sans-serif); font-weight:800; font-size:clamp(30px,4.6vw,52px); line-height:1.04; letter-spacing:-.02em; margin:0; max-width:16ch; }
  #fc-cc-{{ section.id }} .fc-cc-hero h1 span { color:var(--fc-accent); }
  #fc-cc-{{ section.id }} .fc-cc-hero p { font:400 clamp(16px,1.6vw,19px)/1.55 var(--font-body-family,sans-serif); color:rgba(255,255,255,.8); margin:16px 0 0; max-width:56ch; }
  #fc-cc-{{ section.id }} .fc-cc-cta { display:flex; flex-wrap:wrap; gap:12px; margin:30px 0 0; }
  #fc-cc-{{ section.id }} .fc-btn { display:inline-flex; align-items:center; gap:9px; font:700 15.5px/1 var(--font-body-family,sans-serif); text-decoration:none; padding:15px 24px; border-radius:11px; transition:transform .18s ease, box-shadow .18s ease, background .18s ease; }
  #fc-cc-{{ section.id }} .fc-btn--primary { background:#fff; color:var(--fc-navy); box-shadow:0 14px 30px rgba(0,0,0,.22); }
  #fc-cc-{{ section.id }} .fc-btn--primary:hover { transform:translateY(-2px); box-shadow:0 20px 40px rgba(0,0,0,.3); }
  #fc-cc-{{ section.id }} .fc-btn--wa { background:transparent; color:#fff; border:1.5px solid rgba(255,255,255,.3); }
  #fc-cc-{{ section.id }} .fc-btn--wa:hover { transform:translateY(-2px); border-color:rgba(255,255,255,.6); background:rgba(255,255,255,.06); }
  #fc-cc-{{ section.id }} .fc-cc-trust { display:flex; flex-wrap:wrap; gap:8px 20px; margin:28px 0 0; padding:0; list-style:none; }
  #fc-cc-{{ section.id }} .fc-cc-trust li { display:flex; align-items:center; gap:8px; font:600 13.5px/1.3 var(--font-body-family,sans-serif); color:rgba(255,255,255,.82); }
  #fc-cc-{{ section.id }} .fc-cc-trust svg { width:16px; height:16px; color:var(--fc-accent); flex:none; }

  /* SECCIONES */
  #fc-cc-{{ section.id }} .fc-sec { background:#fff; padding:clamp(48px,6vw,72px) 0; }
  #fc-cc-{{ section.id }} .fc-sec--alt { background:#F6F7FA; }
  #fc-cc-{{ section.id }} .fc-sec--navy { background:linear-gradient(150deg,var(--fc-navy),var(--fc-darker)); color:#fff; }
  #fc-cc-{{ section.id }} .fc-sec-head { text-align:center; max-width:640px; margin:0 auto clamp(30px,4vw,44px); }
  #fc-cc-{{ section.id }} .fc-sec-head h2 { font-family:var(--font-heading-family,sans-serif); color:var(--fc-navy); font-weight:800; font-size:clamp(24px,3.2vw,38px); letter-spacing:-.02em; margin:0; }
  #fc-cc-{{ section.id }} .fc-sec--navy .fc-sec-head h2 { color:#fff; }
  #fc-cc-{{ section.id }} .fc-sec-head p { font:400 clamp(15px,1.5vw,17px)/1.55 var(--font-body-family,sans-serif); color:var(--fc-muted); margin:12px 0 0; }
  #fc-cc-{{ section.id }} .fc-sec--navy .fc-sec-head p { color:rgba(255,255,255,.72); }

  /* VALUE STACK */
  #fc-cc-{{ section.id }} .fc-val { display:grid; grid-template-columns:repeat(3,1fr); gap:18px; }
  #fc-cc-{{ section.id }} .fc-val-card { position:relative; background:#fff; border:1px solid var(--fc-line); border-radius:18px; padding:26px 24px; transition:transform .2s ease, box-shadow .2s ease, border-color .2s ease; }
  #fc-cc-{{ section.id }} .fc-val-card:hover { transform:translateY(-4px); box-shadow:0 22px 46px rgba(11,24,64,.1); border-color:#d5dcf0; }
  #fc-cc-{{ section.id }} .fc-val-ic { width:48px; height:48px; border-radius:13px; display:grid; place-items:center; background:linear-gradient(150deg,var(--fc-navy),var(--fc-purple)); color:#fff; margin:0 0 16px; }
  #fc-cc-{{ section.id }} .fc-val-ic svg { width:24px; height:24px; }
  #fc-cc-{{ section.id }} .fc-val-card h3 { color:var(--fc-navy); font:800 17.5px/1.25 var(--font-body-family,sans-serif); margin:0 0 7px; }
  #fc-cc-{{ section.id }} .fc-val-card p { color:var(--fc-muted); font:400 14px/1.55 var(--font-body-family,sans-serif); margin:0; }

  /* PASOS */
  #fc-cc-{{ section.id }} .fc-steps { display:grid; grid-template-columns:repeat(4,1fr); gap:18px; }
  #fc-cc-{{ section.id }} .fc-step { position:relative; text-align:center; padding:30px 18px; border:1px solid var(--fc-line); border-radius:16px; background:#fff; transition:transform .2s ease, box-shadow .2s ease; }
  #fc-cc-{{ section.id }} .fc-step:hover { transform:translateY(-4px); box-shadow:0 20px 42px rgba(11,24,64,.1); }
  #fc-cc-{{ section.id }} .fc-num { width:50px; height:50px; border-radius:50%; margin:0 auto 16px; display:grid; place-items:center; background:linear-gradient(150deg,var(--fc-navy),var(--fc-purple)); color:#fff; font:800 21px/1 var(--font-heading-family,sans-serif); box-shadow:0 10px 22px rgba(59,31,107,.28); }
  #fc-cc-{{ section.id }} .fc-step b { display:block; color:var(--fc-navy); font:700 17px/1.25 var(--font-body-family,sans-serif); margin-bottom:8px; }
  #fc-cc-{{ section.id }} .fc-step p { color:var(--fc-muted); font:400 13.5px/1.55 var(--font-body-family,sans-serif); margin:0; }

  /* PAGOS Y ENTREGAS */
  #fc-cc-{{ section.id }} .fc-two { display:grid; grid-template-columns:1fr 1fr; gap:18px; }
  #fc-cc-{{ section.id }} .fc-box { border:1px solid var(--fc-line); border-radius:18px; padding:30px; background:#fff; }
  #fc-cc-{{ section.id }} .fc-box-tag { display:inline-flex; align-items:center; gap:8px; font:700 12px/1 var(--font-body-family,sans-serif); letter-spacing:.08em; text-transform:uppercase; color:var(--fc-purple); background:rgba(59,31,107,.08); padding:6px 12px; border-radius:999px; margin:0 0 16px; }
  #fc-cc-{{ section.id }} .fc-box h3 { color:var(--fc-navy); font:800 20px/1.3 var(--font-body-family,sans-serif); margin:0 0 14px; }
  #fc-cc-{{ section.id }} .fc-box ul { list-style:none; margin:0; padding:0; }
  #fc-cc-{{ section.id }} .fc-box li { display:flex; align-items:flex-start; gap:11px; padding:11px 0; border-bottom:1px solid var(--fc-line); color:#3a4253; font:400 14.5px/1.5 var(--font-body-family,sans-serif); }
  #fc-cc-{{ section.id }} .fc-box li:last-child { border-bottom:0; }
  #fc-cc-{{ section.id }} .fc-box li svg { width:20px; height:20px; color:var(--fc-accent); flex:none; margin-top:1px; }
  #fc-cc-{{ section.id }} .fc-box li b { color:var(--fc-navy); }

  /* GARANTIA */
  #fc-cc-{{ section.id }} .fc-guar { display:flex; align-items:center; gap:clamp(20px,3vw,40px); flex-wrap:wrap; justify-content:center; text-align:left; }
  #fc-cc-{{ section.id }} .fc-guar-badge { width:96px; height:96px; border-radius:50%; flex:none; display:grid; place-items:center; background:rgba(25,195,125,.14); border:2px solid rgba(25,195,125,.5); color:var(--fc-accent); }
  #fc-cc-{{ section.id }} .fc-guar-badge svg { width:46px; height:46px; }
  #fc-cc-{{ section.id }} .fc-guar-txt { max-width:560px; }
  #fc-cc-{{ section.id }} .fc-guar-txt h2 { font-family:var(--font-heading-family,sans-serif); font-weight:800; font-size:clamp(22px,2.8vw,32px); margin:0 0 10px; }
  #fc-cc-{{ section.id }} .fc-guar-txt p { font:400 15.5px/1.6 var(--font-body-family,sans-serif); color:rgba(255,255,255,.78); margin:0; }

  /* FAQ */
  #fc-cc-{{ section.id }} .fc-faq { max-width:820px; margin:0 auto; display:flex; flex-direction:column; gap:12px; }
  #fc-cc-{{ section.id }} .fc-faq details { border:1px solid var(--fc-line); border-radius:13px; background:#fff; overflow:hidden; transition:box-shadow .2s ease; }
  #fc-cc-{{ section.id }} .fc-faq details[open] { box-shadow:0 14px 34px rgba(11,24,64,.08); }
  #fc-cc-{{ section.id }} .fc-faq summary { cursor:pointer; list-style:none; padding:18px 22px; font:700 16px/1.35 var(--font-body-family,sans-serif); color:var(--fc-navy); display:flex; align-items:center; justify-content:space-between; gap:14px; }
  #fc-cc-{{ section.id }} .fc-faq summary::-webkit-details-marker { display:none; }
  #fc-cc-{{ section.id }} .fc-faq summary:after { content:"+"; font-size:22px; font-weight:400; color:var(--fc-purple); transition:transform .2s ease; flex:none; }
  #fc-cc-{{ section.id }} .fc-faq details[open] summary:after { transform:rotate(45deg); }
  #fc-cc-{{ section.id }} .fc-faq p { margin:0; padding:0 22px 20px; color:#4a5366; font:400 14.5px/1.6 var(--font-body-family,sans-serif); }

  /* CTA FINAL */
  #fc-cc-{{ section.id }} .fc-cta-final { text-align:center; }
  #fc-cc-{{ section.id }} .fc-cta-final h2 { font-family:var(--font-heading-family,sans-serif); color:#fff; font-weight:800; font-size:clamp(24px,3.2vw,38px); margin:0 0 12px; }
  #fc-cc-{{ section.id }} .fc-cta-final p { color:rgba(255,255,255,.75); font:400 16px/1.55 var(--font-body-family,sans-serif); margin:0 auto 26px; max-width:52ch; }
  #fc-cc-{{ section.id }} .fc-cta-final .fc-cc-cta { justify-content:center; }

  /* REVEAL */
  #fc-cc-{{ section.id }} .fc-rv { opacity:0; transform:translateY(24px); transition:opacity .6s ease var(--fc-d,0ms), transform .6s cubic-bezier(.2,.7,.2,1) var(--fc-d,0ms); }
  #fc-cc-{{ section.id }} .fc-rv.is-in { opacity:1; transform:none; }

  /* ENVIO EXPRESS (banda destacada) */
  #fc-cc-{{ section.id }} .fc-express { background: linear-gradient(120deg, var(--fc-navy) 0%, var(--fc-purple) 100%); color:#fff; padding: clamp(48px,6vw,68px) 0; position:relative; overflow:hidden; }
  #fc-cc-{{ section.id }} .fc-express::before { content:""; position:absolute; inset:0; background: radial-gradient(circle at 82% 26%, rgba(25,195,125,.30), transparent 44%); pointer-events:none; }
  #fc-cc-{{ section.id }} .fc-express-inner { display:grid; grid-template-columns: 1.35fr .9fr; gap: 44px; align-items:center; position:relative; z-index:1; }
  #fc-cc-{{ section.id }} .fc-express-tag { display:inline-flex; align-items:center; gap:8px; background: var(--fc-accent); color: var(--fc-darker); font:800 12px/1 var(--font-body-family, sans-serif); letter-spacing:.14em; text-transform:uppercase; padding:9px 15px; border-radius:99px; margin-bottom:18px; }
  #fc-cc-{{ section.id }} .fc-express h2 { font-family:var(--font-heading-family,sans-serif); font-size: clamp(28px,3.7vw,46px); font-weight:800; margin:0 0 12px; line-height:1.06; letter-spacing:-.02em; }
  #fc-cc-{{ section.id }} .fc-express h2 .hl { color: var(--fc-accent); }
  #fc-cc-{{ section.id }} .fc-express-lead { color: rgba(255,255,255,.84); font:400 17px/1.55 var(--font-body-family, sans-serif); margin:0 0 8px; max-width: 50ch; }
  #fc-cc-{{ section.id }} .fc-express-lead b { color:#fff; font-weight:800; }
  #fc-cc-{{ section.id }} .fc-express-cities-label { display:block; font:700 12px/1 var(--font-body-family, sans-serif); letter-spacing:.1em; text-transform:uppercase; color: rgba(255,255,255,.55); margin: 22px 0 12px; }
  #fc-cc-{{ section.id }} .fc-express-cities { display:flex; flex-wrap:wrap; gap:12px; }
  #fc-cc-{{ section.id }} .fc-city { background: rgba(255,255,255,.07); border:1px solid rgba(255,255,255,.16); border-radius:13px; padding:13px 18px; min-width:118px; }
  #fc-cc-{{ section.id }} .fc-city-name { display:block; font:700 17px/1 var(--font-body-family, sans-serif); }
  #fc-cc-{{ section.id }} .fc-city-badge { display:block; font:800 11px/1 var(--font-body-family, sans-serif); letter-spacing:.1em; text-transform:uppercase; margin-top:6px; color: rgba(255,255,255,.55); }
  #fc-cc-{{ section.id }} .fc-city.is-live { background: rgba(25,195,125,.16); border-color: var(--fc-accent); }
  #fc-cc-{{ section.id }} .fc-city.is-live .fc-city-badge { color: var(--fc-accent); }
  #fc-cc-{{ section.id }} .fc-express-note { color: rgba(255,255,255,.62); font:400 13.5px/1.5 var(--font-body-family, sans-serif); margin:16px 0 0; max-width: 52ch; }
  #fc-cc-{{ section.id }} .fc-express-visual { display:flex; }
  #fc-cc-{{ section.id }} .fc-express-highlights { width:100%; display:grid; gap:14px; }
  #fc-cc-{{ section.id }} .fc-hl { display:flex; align-items:center; gap:16px; background: rgba(255,255,255,.07); border:1px solid rgba(255,255,255,.16); border-radius:16px; padding:18px 20px; }
  #fc-cc-{{ section.id }} .fc-hl.is-accent { background: rgba(25,195,125,.14); border-color: rgba(25,195,125,.45); animation: fc-pulse 2.8s ease-in-out infinite; }
  #fc-cc-{{ section.id }} .fc-hl-ic { flex:0 0 auto; width:54px; height:54px; border-radius:13px; display:grid; place-items:center; background: rgba(255,255,255,.10); }
  #fc-cc-{{ section.id }} .fc-hl.is-accent .fc-hl-ic { background: rgba(25,195,125,.22); }
  #fc-cc-{{ section.id }} .fc-hl-ic svg { width:27px; height:27px; color:#fff; }
  #fc-cc-{{ section.id }} .fc-hl.is-accent .fc-hl-ic svg { color: var(--fc-accent); }
  #fc-cc-{{ section.id }} .fc-hl b { display:block; font:800 18px/1.1 var(--font-body-family, sans-serif); }
  #fc-cc-{{ section.id }} .fc-hl span { display:block; font:400 13.5px/1.35 var(--font-body-family, sans-serif); color: rgba(255,255,255,.72); margin-top:3px; }
  @keyframes fc-pulse { 0%,100%{ box-shadow: 0 0 0 0 rgba(25,195,125,.28); } 50%{ box-shadow: 0 0 0 16px rgba(25,195,125,0); } }

  /* PAGOS */
  #fc-cc-{{ section.id }} .fc-pay { background: linear-gradient(120deg,#F6F7FA 0%,#eef1f8 100%); color: var(--fc-navy); padding: clamp(48px,6vw,68px) 0; position:relative; overflow:hidden; border-top:1px solid var(--fc-line); }
  #fc-cc-{{ section.id }} .fc-pay::before { content:""; position:absolute; inset:0; background: radial-gradient(circle at 84% 20%, rgba(59,31,107,.10), transparent 46%); pointer-events:none; }
  #fc-cc-{{ section.id }} .fc-pay-inner { display:grid; grid-template-columns:1.35fr .9fr; gap:44px; align-items:center; position:relative; z-index:1; }
  #fc-cc-{{ section.id }} .fc-pay-tag { display:inline-flex; align-items:center; gap:8px; background: rgba(59,31,107,.10); color: var(--fc-purple); font:800 12px/1 var(--font-body-family, sans-serif); letter-spacing:.14em; text-transform:uppercase; padding:9px 15px; border-radius:99px; margin-bottom:18px; }
  #fc-cc-{{ section.id }} .fc-pay h2 { font-family:var(--font-heading-family,sans-serif); font-size: clamp(28px,3.7vw,46px); font-weight:800; margin:0 0 12px; line-height:1.06; letter-spacing:-.02em; color: var(--fc-navy); }
  #fc-cc-{{ section.id }} .fc-pay h2 .hl { color: var(--fc-purple); }
  #fc-cc-{{ section.id }} .fc-pay-lead { color: var(--fc-muted); font:400 17px/1.55 var(--font-body-family, sans-serif); margin:0 0 22px; max-width:52ch; }
  #fc-cc-{{ section.id }} .fc-pay-methods { list-style:none; margin:0; padding:0; display:grid; gap:12px; }
  #fc-cc-{{ section.id }} .fc-pay-methods li { display:flex; align-items:center; gap:12px; font:400 15.5px/1.4 var(--font-body-family, sans-serif); color: var(--fc-navy); }
  #fc-cc-{{ section.id }} .fc-pay-methods li b { font-weight:800; }
  #fc-cc-{{ section.id }} .fc-pay-methods li .fc-pay-ck { flex:0 0 auto; width:26px; height:26px; border-radius:8px; display:grid; place-items:center; background: rgba(25,195,125,.16); color: var(--fc-accent); }
  #fc-cc-{{ section.id }} .fc-pay-methods li .fc-pay-ck svg { width:15px; height:15px; }
  #fc-cc-{{ section.id }} .fc-pay-card { background:#fff; border:1px solid var(--fc-line); border-radius:20px; padding:28px; box-shadow:0 18px 40px rgba(11,24,64,.08); }
  #fc-cc-{{ section.id }} .fc-pay-card-lbl { display:block; font:700 12px/1 var(--font-body-family, sans-serif); letter-spacing:.1em; text-transform:uppercase; color: var(--fc-muted); margin:0 0 16px; }
  #fc-cc-{{ section.id }} .fc-pay-logos { display:grid; grid-template-columns:repeat(3,1fr); gap:10px; }
  #fc-cc-{{ section.id }} .fc-pay-logo { display:grid; place-items:center; height:54px; background:#fff; border:1px solid var(--fc-line); border-radius:12px; padding:10px 12px; }
  #fc-cc-{{ section.id }} .fc-pay-logo img { max-height:26px; max-width:100%; width:auto; height:auto; display:block; }
  #fc-cc-{{ section.id }} .fc-pay-card-note { display:flex; align-items:center; gap:9px; margin:18px 0 0; font:400 13.5px/1.5 var(--font-body-family, sans-serif); color: var(--fc-muted); }
  #fc-cc-{{ section.id }} .fc-pay-card-note svg { flex:0 0 auto; width:17px; height:17px; color: var(--fc-accent); }

  @media (max-width:900px){ #fc-cc-{{ section.id }} .fc-val { grid-template-columns:1fr 1fr; } #fc-cc-{{ section.id }} .fc-steps { grid-template-columns:1fr 1fr; } #fc-cc-{{ section.id }} .fc-express-inner { grid-template-columns:1fr; gap:30px; } #fc-cc-{{ section.id }} .fc-pay-inner { grid-template-columns:1fr; gap:30px; } }
  @media (max-width:640px){ #fc-cc-{{ section.id }} .fc-val, #fc-cc-{{ section.id }} .fc-steps, #fc-cc-{{ section.id }} .fc-two { grid-template-columns:1fr; } #fc-cc-{{ section.id }} .fc-btn { flex:1 1 100%; justify-content:center; } #fc-cc-{{ section.id }} .fc-guar { text-align:center; } }
  @media (prefers-reduced-motion: reduce){ #fc-cc-{{ section.id }} .fc-rv { opacity:1 !important; transform:none !important; transition:none !important; } }
</style>

<div id="fc-cc-{{ section.id }}">

  {%- comment -%} ===== HERO ===== {%- endcomment -%}
  <section class="fc-cc-hero">
    <div class="fc-wrap">
      <h1>{{ section.settings.title | default: 'Compra tus suplementos en minutos, recíbelos <span>sin complicaciones</span>' }}</h1>
      <p>{{ section.settings.subtitle | default: 'Productos 100% originales importados de EE.UU., pagas como prefieras y te llega rápido. Así de simple funciona Fitcore Store.' }}</p>
      <div class="fc-cc-cta">
        <a class="fc-btn fc-btn--primary" href="{{ catalog_url }}">Ver catálogo</a>
        <a class="fc-btn fc-btn--wa" href="https://wa.me/{{ wa }}?text={{ wa_msg_enc }}" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 018.413 3.488 11.82 11.82 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.477-.911z"/></svg>
          ¿Dudas? Escríbenos
        </a>
      </div>
      <ul class="fc-cc-trust">
        <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6L9 17l-5-5"/></svg>Producto original y sellado</li>
