{
  "sections": {
    "fitcore_banner": {
      "type": "fitcore-collection-banner",
      "settings": {
        "show_count": true,
        "color_navy": "#0B1840",
        "color_purple": "#3B1F6B",
        "color_accent": "#19C37D"
