{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "text",
          "settings": {
            "text": "{{ product.vendor }}",
            "text_style": "uppercase"
          }
        },
        "title": {
          "type": "title",
          "settings": {}
        },
        "price": {
          "type": "price",
          "settings": {}
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": true
          }
        },
        "description": {
          "type": "description",
          "settings": {}
        },
        "share": {
          "type": "share",
          "settings": {
            "share_label": "Compartir"
          }
        }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description",
        "share"
      ],
      "settings": {
        "enable_sticky_info": true,
        "gallery_layout": "thumbnail",
        "media_size": "large",
        "media_fit": "contain",
        "mobile_thumbnails": "show",
        "media_position": "left",
        "image_zoom": "lightbox",
        "constrain_to_viewport": true,
        "padding_top": 36,
        "padding_bottom": 12
      }
    },
    "fitcore_fit": {
      "type": "fitcore-product-fit",
      "settings": {}
    },
    "related": {
      "type": "related-products",
      "settings": {
        "heading": "También te puede servir",
        "products_to_show": 4,
        "columns_desktop": 4,
        "columns_mobile": "2",
        "padding_top": 28,
        "padding_bottom": 44
      }
    }
  },
  "order": [
    "main",
    "fitcore_fit",
    "related"
  ]
}
