{%- comment -%}
  FitCore Store · Página "Cómo comprar" (B2C)
  Pasos + métodos de pago + opciones de envío + CTA WhatsApp.
  Pegar en: Edit code > Sections > Add new > "fitcore-como-comprar"
{%- endcomment -%}

{%- liquid
  assign wa = section.settings.whatsapp | default: '584246218863'
  assign wa_msg = section.settings.whatsapp_msg | default: 'Hola Fitcore Store, quiero hacer un pedido'
  assign wa_msg_enc = wa_msg | url_encode
-%}

<style>
  #fc-cc-{{ section.id }} { --fc-navy:#0B1840; --fc-purple:#3B1F6B; --fc-accent:#19C37D; --fc-line:#e7eaf2; --fc-muted:#56607a; }
  #fc-cc-{{ section.id }} .fc-wrap { max-width:1100px; margin:0 auto; padding:0 22px; }
  #fc-cc-{{ section.id }} .fc-cc-hero { background: radial-gradient(800px 420px at 12% -20%, var(--fc-purple) 0%, transparent 58%), linear-gradient(160deg, var(--fc-navy) 0%, #071631 100%); color:#fff; padding:56px 0 50px; }
  #fc-cc-{{ section.id }} .fc-cc-hero h1 { font-family:var(--font-heading-family,sans-serif); font-weight:800; font-size:clamp(30px,4.4vw,48px); margin:0; }
  #fc-cc-{{ section.id }} .fc-cc-hero p { font:400 17px/1.55 var(--font-body-family,sans-serif); color:rgba(255,255,255,.78); margin:12px 0 0; max-width:60ch; }
  #fc-cc-{{ section.id }} .fc-sec { background:#fff; padding:54px 0; }
  #fc-cc-{{ section.id }} .fc-sec--alt { background:#F6F7FA; }
  #fc-cc-{{ section.id }} h2 { font-family:var(--font-heading-family,sans-serif); color:var(--fc-navy); font-weight:800; font-size:clamp(24px,3vw,36px); margin:0 0 28px; text-align:center; }
  #fc-cc-{{ section.id }} .fc-steps { display:grid; grid-template-columns:repeat(4,1fr); gap:18px; }
  #fc-cc-{{ section.id }} .fc-step { text-align:center; padding:26px 16px; border:1px solid var(--fc-line); border-radius:16px; background:#fff; }
  #fc-cc-{{ section.id }} .fc-num { width:46px; height:46px; border-radius:50%; margin:0 auto 14px; display:grid; place-items:center; background:linear-gradient(150deg,var(--fc-navy),var(--fc-purple)); color:#fff; font:800 20px/1 var(--font-heading-family,sans-serif); }
  #fc-cc-{{ section.id }} .fc-step b { display:block; color:var(--fc-navy); font:700 17px/1.25 var(--font-body-family,sans-serif); margin-bottom:7px; }
  #fc-cc-{{ section.id }} .fc-step p { color:var(--fc-muted); font:400 13.5px/1.55 var(--font-body-family,sans-serif); margin:0; }
  #fc-cc-{{ section.id }} .fc-two { display:grid; grid-template-columns:1fr 1fr; gap:18px; }
  #fc-cc-{{ section.id }} .fc-box { border:1px solid var(--fc-line); border-radius:16px; padding:26px; background:#fff; }
  #fc-cc-{{ section.id }} .fc-box h3 { color:var(--fc-navy); font:800 19px/1.3 var(--font-body-family,sans-serif); margin:0 0 14px; }
  #fc-cc-{{ section.id }} .fc-box ul { list-style:none; margin:0; padding:0; }
  #fc-cc-{{ section.id }} .fc-box li { padding:9px 0; border-bottom:1px solid var(--fc-line); color:#3a4253; font:400 14.5px/1.5 var(--font-body-family,sans-serif); }
  #fc-cc-{{ section.id }} .fc-box li:last-child { border-bottom:0; }
  #fc-cc-{{ section.id }} .fc-box li b { color:var(--fc-navy); }
  #fc-cc-{{ section.id }} .fc-cta { text-align:center; }
  #fc-cc-{{ section.id }} .fc-btn { display:inline-flex; align-items:center; gap:9px; background:#25D366; color:#04231a; font:700 16px/1 var(--font-body-family,sans-serif); text-decoration:none; padding:16px 26px; border-radius:10px; }
  @media (max-width:820px){ #fc-cc-{{ section.id }} .fc-steps{ grid-template-columns:repeat(2,1fr); } #fc-cc-{{ section.id }} .fc-two{ grid-template-columns:1fr; } }
  @media (max-width:480px){ #fc-cc-{{ section.id }} .fc-steps{ grid-template-columns:1fr; } }
</style>

<div id="fc-cc-{{ section.id }}">
  <section class="fc-cc-hero">
    <div class="fc-wrap">
      <h1>{{ section.settings.title | default: '¿Cómo comprar en Fitcore Store?' }}</h1>
      <p>{{ section.settings.subtitle | default: 'Comprar tus suplementos originales es rápido y seguro. Te explicamos paso a paso.' }}</p>
    </div>
  </section>

  <section class="fc-sec">
    <div class="fc-wrap">
      <h2>4 pasos simples</h2>
      <div class="fc-steps">
        <div class="fc-step"><div class="fc-num">1</div><b>Elige tus productos</b><p>Explora el catálogo por categoría y agrega al carrito lo que quieras.</p></div>
        <div class="fc-step"><div class="fc-num">2</div><b>Confirma tu pedido</b><p>Completa tus datos y la ciudad de entrega al finalizar la compra.</p></div>
        <div class="fc-step"><div class="fc-num">3</div><b>Coordina el pago</b><p>Te contactamos para pagar por el método que prefieras.</p></div>
        <div class="fc-step"><div class="fc-num">4</div><b>Recibe tu pedido</b><p>Entrega el mismo día en tu ciudad o envío nacional a domicilio.</p></div>
      </div>
    </div>
  </section>

  <section class="fc-sec fc-sec--alt">
    <div class="fc-wrap">
      <h2>Pagos y entregas</h2>
      <div class="fc-two">
        <div class="fc-box">
          <h3>Métodos de pago</h3>
          <ul>
            <li><b>Zelle</b> y transferencias en divisas</li>
            <li><b>USDT</b> (criptomoneda)</li>
            <li><b>Pago Móvil</b> y transferencia en bolívares</li>
            <li><b>Efectivo</b> en el kiosco</li>
          </ul>
        </div>
        <div class="fc-box">
          <h3>Opciones de entrega</h3>
          <ul>
            <li><b>Express mismo día</b> en ciudades con tienda física</li>
            <li><b>Envío nacional</b> a todo el país vía MRW o Tealca</li>
            <li><b>Retiro en kiosco</b> en el CC Plaza, Valera</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <section class="fc-sec">
    <div class="fc-wrap fc-cta">
      <h2>¿Listo para tu pedido?</h2>
      <a class="fc-btn" href="https://wa.me/{{ wa }}?text={{ wa_msg_enc }}" target="_blank" rel="noopener">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M.057 24l1.687-6.163a11.867 11.867 0 01-1.587-5.946C.16 5.335 5.495 0 12.05 0a11.82 11.82 0 018.413 3.488 11.82 11.82 0 013.48 8.414c-.003 6.557-5.338 11.892-11.893 11.892a11.9 11.9 0 01-5.688-1.448L.057 24zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.884a9.86 9.86 0 001.51 5.26l-.999 3.648 3.477-.911z"/></svg>
        Pedir por WhatsApp
      </a>
    </div>
  </section>
</div>

{% schema %}
{
  "name": "FitCore Cómo comprar",
  "tag": "section",
  "class": "fitcore-como-comprar",
  "settings": [
    { "type": "text", "id": "title", "label": "Título", "default": "¿Cómo comprar en Fitcore Store?" },
    { "type": "textarea", "id": "subtitle", "label": "Subtítulo", "default": "Comprar tus suplementos originales es rápido y seguro. Te explicamos paso a paso." },
    { "type": "text", "id": "whatsapp", "label": "WhatsApp (solo dígitos)", "default": "584246218863" },
    { "type": "text", "id": "whatsapp_msg", "label": "Mensaje precargado", "default": "Hola Fitcore Store, quiero hacer un pedido" }
  ],
  "presets": [ { "name": "FitCore Cómo comprar" } ]
}
{% endschema %}
